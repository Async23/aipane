{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-activity",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-activity",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-activity",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-notify",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-activity",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-notify",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-activity",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-notify",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(?!AskUserQuestion$).*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-notify",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "^(elicitation_dialog|elicitation_url_dialog|agent_needs_input)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-notify",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-activity",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-activity",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
