            "command": "$HOME/.local/bin/aipane-claude-activity",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-activity",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-claude-activity",
            "timeout": 5
          }
        ]
      }
