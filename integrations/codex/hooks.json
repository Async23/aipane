{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-activity report idle",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-activity report busy",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^request_user_input(_async)?$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-codex-notify",
            "async": true,
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-activity report busy",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/aipane-activity report idle",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
