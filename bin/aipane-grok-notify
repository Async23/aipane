#!/opt/homebrew/bin/python3
"""Grok Build notification Adapter."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path


LIB_DIR = Path(__file__).resolve().parents[1] / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from agent_notifications import (  # noqa: E402
    AgentNotifications,
    MacOSNotificationAdapter,
)


DEFERRED_FLAG = "--deferred"


def read_payload(environment: dict[str, str]) -> dict[str, object]:
    deferred = len(sys.argv) > 1 and sys.argv[1] == DEFERRED_FLAG
    raw = ""
    if deferred and len(sys.argv) > 2:
        raw = sys.argv[2]
    elif len(sys.argv) > 1 and sys.argv[1]:
        raw = sys.argv[1]
    elif not sys.stdin.isatty():
        raw = sys.stdin.read().strip()

    fallbacks = {
        "event": environment.get("GROK_EVENT")
        or environment.get("GROK_HOOK_EVENT")
        or "",
        "message": environment.get("GROK_MESSAGE") or "",
        "session_id": environment.get("GROK_SESSION_ID") or "",
        "cwd": environment.get("GROK_WORKSPACE_ROOT")
        or environment.get("CLAUDE_PROJECT_DIR")
        or "",
    }
    if not raw:
        payload = {key: value for key, value in fallbacks.items() if value}
        payload["source"] = "env"
        return payload
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        payload = {"raw": raw, **{key: value for key, value in fallbacks.items() if value}}
        payload["source"] = "raw"
        return payload
    if not isinstance(value, dict):
        payload = {key: value for key, value in fallbacks.items() if value}
        payload["source"] = "env"
        return payload
    payload = value
    for key, fallback in fallbacks.items():
        if fallback and not payload.get(key):
            payload[key] = fallback
    if not payload.get("source"):
        payload["source"] = "stdin"
    return payload


def start_deferred_worker(payload: dict[str, object]) -> bool:
    try:
        subprocess.Popen(
            [
                sys.executable,
                str(Path(__file__).resolve()),
                DEFERRED_FLAG,
                json.dumps(payload, ensure_ascii=False),
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
        return True
    except OSError:
        return False


def main() -> int:
    environment = os.environ.copy()
    payload = read_payload(environment)
    deferred = len(sys.argv) > 1 and sys.argv[1] == DEFERRED_FLAG
    preview = environment.get("GROK_NOTIFY_DRY_RUN", "").lower() in {
        "1",
        "true",
        "yes",
    }
    notifications = AgentNotifications(
        adapter=MacOSNotificationAdapter(environment=environment),
        environment=environment,
    )
    phase = "ready" if preview else ("deferred" if deferred else "initial")
    result = notifications.handle(
        "grok",
        payload,
        preview=preview,
        phase=phase,
    )
    if result.outcome == "deferred":
        if not start_deferred_worker(payload):
            notifications.handle("grok", payload, phase="ready")
        return 0
    if preview and result.notification is not None:
        print(
            json.dumps(
                {
                    "title": result.notification.title,
                    "subtitle": result.notification.subtitle,
                    "body": result.notification.body,
                    "event": result.notification.event,
                    "sound": result.notification.sound,
                },
                ensure_ascii=False,
            )
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
