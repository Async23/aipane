#!/usr/bin/env python3
"""Translate Codex legacy notify events without breaking the real notifier."""

from __future__ import annotations

import json
import os
import shlex
import subprocess
import sys
from pathlib import Path


LIB_DIR = Path(__file__).resolve().parents[1] / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

try:
    from agent_activity import codex_goal_state, codex_thread_identity
except ImportError:
    codex_goal_state = None
    codex_thread_identity = None


def report_activity(home: Path, state: str, payload: str) -> None:
    command = home / ".local" / "bin" / "aipane-activity"
    if not os.access(command, os.X_OK):
        return
    try:
        subprocess.run(
            [str(command), "report", state],
            input=payload,
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=3,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def bind_session(home: Path, session_id: str) -> None:
    command = home / ".local" / "bin" / "aipane-bind"
    if not session_id or not os.access(command, os.X_OK):
        return
    try:
        subprocess.Popen(
            [str(command), "--tool", "x", "--sid", session_id],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


def translate(payload_text: str, home: Path, codex_home: Path) -> None:
    if codex_thread_identity is None or codex_goal_state is None:
        return
    try:
        payload = json.loads(payload_text)
    except (TypeError, ValueError):
        return
    if not isinstance(payload, dict) or payload.get("type") != "agent-turn-complete":
        return
    session_id = payload.get("thread-id") or payload.get("thread_id")
    turn_id = payload.get("turn-id") or payload.get("turn_id")
    if not isinstance(session_id, str) or not session_id:
        return

    identity = codex_thread_identity(codex_home, session_id)
    if identity.scope == "unknown":
        return
    if identity.scope == "main" and isinstance(turn_id, str) and turn_id:
        goal = codex_goal_state(codex_home, identity.root_session_id)
        report_activity(
            home,
            "busy" if goal in {"active", "unknown"} else "idle",
            payload_text,
        )
    bind_session(home, identity.root_session_id)


def delegate(real_notify: Path) -> int:
    arguments = sys.argv[1:]
    if os.access(real_notify, os.X_OK):
        os.execv(str(real_notify), [str(real_notify), *arguments])
    if real_notify.is_file():
        python = shlex.split(os.environ.get("AIPANE_PYTHON", sys.executable))
        if python:
            os.execvp(
                python[0],
                [*python, str(real_notify), *arguments],
            )
    return 0


def main() -> int:
    home = Path(os.environ.get("HOME", str(Path.home()))).expanduser()
    codex_home = Path(
        os.environ.get("CODEX_HOME", str(home / ".codex"))
    ).expanduser()
    payload_text = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        translate(payload_text, home, codex_home)
    except Exception:
        # Activity is safety metadata; it must never suppress user notifications.
        pass
    real_notify = Path(
        os.environ.get(
            "AIPANE_CODEX_REAL_NOTIFY",
            str(Path(__file__).resolve().with_name("aipane-codex-desktop-notify")),
        )
    ).expanduser()
    return delegate(real_notify)


if __name__ == "__main__":
    raise SystemExit(main())
