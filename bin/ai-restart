#!/usr/bin/env python3
"""Restart restorable AI Tools in place and resume their saved sessions.

The command refreshes the tmux-resurrect snapshot, asks ai-restore for its
machine-readable plan, replaces only those AI panes with an idle shell, and
then lets ai-restore resume the same sessions in the same panes.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
import time
from pathlib import Path


LIB_DIR = Path(__file__).resolve().parents[1] / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from agent_activity import AgentActivity, PaneActivity


FIELD_SEPARATOR = "\x1f"
ACTIVITY_OPTION = "@tmux-window-wrap-activity"
ACTIVITY_REPORTER_OPTION = "@tmux-window-wrap-activity-reporter"
ACTIVITY_UPDATED_AT_OPTION = "@tmux-window-wrap-activity-updated-at"
ACTIVITY_RECORD_OPTION = "@tmux-window-wrap-activity-record"
SHELL_COMMANDS = {"zsh", "-zsh", "bash", "-bash", "sh", "-sh", "fish", "-fish"}


class RestartError(RuntimeError):
    pass


def command_from_env(name: str, default: list[str]) -> list[str]:
    raw = os.environ.get(name)
    return shlex.split(raw) if raw else default


class Tmux:
    def __init__(self) -> None:
        self.command = command_from_env("AIPANE_TMUX", ["tmux"])

    def run(
        self,
        *arguments: str,
        check: bool = True,
        capture_output: bool = True,
    ) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            [*self.command, *arguments],
            check=check,
            capture_output=capture_output,
            text=True,
        )

    def value(self, *arguments: str) -> str:
        return self.run(*arguments).stdout.strip()


def configured_command(name: str, fallback: Path) -> list[str]:
    return command_from_env(name, [str(fallback)])


def state_environment(tmux: Tmux) -> dict[str, str]:
    environment = os.environ.copy()
    environment["AIPANE_TMUX"] = shlex.join(tmux.command)
    return environment


def resurrect_dump_path(tmux: Tmux) -> Path:
    completed = tmux.run(
        "show-option",
        "-gqv",
        "@resurrect-dir",
        check=False,
    )
    configured = completed.stdout.strip()
    if configured:
        directory = Path(os.path.expandvars(os.path.expanduser(configured)))
    else:
        data_home = Path(
            os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")
        )
        directory = data_home / "tmux" / "resurrect"
    return directory / "last"


def save_snapshot(tmux: Tmux, script_dir: Path) -> Path:
    override = os.environ.get("AIPANE_RESURRECT_SAVE_SCRIPT")
    if override:
        save_command = shlex.split(override)
    else:
        completed = tmux.run(
            "show-option",
            "-gqv",
            "@resurrect-save-script-path",
            check=False,
        )
        configured = completed.stdout.strip()
        if configured:
            save_command = [os.path.expandvars(os.path.expanduser(configured))]
        else:
            save_command = [
                str(Path.home() / ".tmux" / "plugins" / "tmux-resurrect" / "scripts" / "save.sh")
            ]

    if not save_command or not Path(save_command[0]).is_file():
        raise RestartError(
            "tmux-resurrect save script was not found; install/load tmux-resurrect first"
        )

    environment = state_environment(tmux)
    subprocess.run(save_command, check=True, env=environment)

    # The configured post-save hook normally does this. Running it again is
    # harmless and makes ai-restart self-contained when the hook is absent.
    snapshot_command = configured_command(
        "AIPANE_SNAPSHOT_COMMAND",
        script_dir / "aipane-snapshot",
    )
    if snapshot_command and Path(snapshot_command[0]).is_file():
        subprocess.run(
            snapshot_command,
            check=True,
            env=environment,
            stdout=subprocess.DEVNULL,
        )

    dump = resurrect_dump_path(tmux)
    if not dump.exists():
        raise RestartError(f"tmux-resurrect did not produce a snapshot at {dump}")
    return dump


def recovery_plan(
    restore_command: list[str],
    dump: Path,
    environment: dict[str, str],
) -> tuple[list[dict[str, object]], list[dict[str, object]]]:
    completed = subprocess.run(
        [*restore_command, "--plan-json", "--dump", str(dump)],
        check=True,
        capture_output=True,
        text=True,
        env=environment,
    )
    plan: list[dict[str, object]] = []
    invalid: list[dict[str, object]] = []
    for number, line in enumerate(completed.stdout.splitlines(), start=1):
        if not line.strip():
            continue
        try:
            item = json.loads(line)
        except json.JSONDecodeError as error:
            raise RestartError(
                f"ai-restore returned invalid plan JSON on line {number}: {error}"
            ) from error
        if not isinstance(item, dict):
            raise RestartError(f"ai-restore plan line {number} is not an object")
        if item.get("restorable") is True:
            plan.append(item)
        elif item.get("kind") == "invalid":
            invalid.append(item)
    return plan, invalid


def pane_state(
    tmux: Tmux,
    target: str,
    resolver: AgentActivity | None = None,
) -> dict[str, object] | None:
    pane_format = FIELD_SEPARATOR.join(
        (
            "#{pane_id}",
            "#{pane_current_command}",
            "#{session_name}:#{window_id}.#{pane_id}",
            "#{pane_tty}",
            "#{socket_path}",
            "#{pid}",
            f"#{{{ACTIVITY_OPTION}}}",
            f"#{{{ACTIVITY_REPORTER_OPTION}}}",
            f"#{{{ACTIVITY_UPDATED_AT_OPTION}}}",
            f"#{{{ACTIVITY_RECORD_OPTION}}}",
        )
    )
    completed = tmux.run(
        "display-message",
        "-p",
        "-t",
        target,
        pane_format,
        check=False,
    )
    if completed.returncode != 0:
        return None
    fields = completed.stdout.rstrip("\n").split(FIELD_SEPARATOR, 9)
    if len(fields) != 10:
        return None
    (
        pane_id,
        current_command,
        canonical_target,
        pane_tty,
        socket_path,
        server_pid,
        activity_source,
        activity_reporter,
        activity_updated_at,
        activity_record,
    ) = fields
    resolver = resolver or AgentActivity()
    view = resolver.resolve(
        PaneActivity(
            pane_id=pane_id,
            current_command=current_command,
            target=canonical_target,
            pane_tty=pane_tty,
            socket_path=socket_path,
            server_pid=server_pid,
            marker=activity_source,
            reporter=activity_reporter,
            marker_updated_at=activity_updated_at,
            record=activity_record,
        )
    )
    return {
        "pane_id": pane_id,
        "current_command": current_command,
        "busy": view.state == "busy",
        "reported": view.reported,
        "activity_state": view.state,
        "activity_reason": view.reason,
        "activity_evidence": view.evidence_turn_id,
    }


def live_plan(tmux: Tmux, plan: list[dict[str, object]]) -> list[dict[str, object]]:
    result: list[dict[str, object]] = []
    seen: set[str] = set()
    resolver = AgentActivity()
    for item in plan:
        target = str(item.get("target", ""))
        if not target or target in seen:
            continue
        state = pane_state(tmux, target, resolver)
        if state is None:
            continue
        seen.add(target)
        result.append({**item, **state})
    return result


def print_plan(plan: list[dict[str, object]]) -> None:
    print("AI panes to restart:")
    for item in plan:
        if item.get("activity_state") == "busy":
            status = "BUSY"
        elif item.get("activity_state") == "idle":
            status = "idle"
        else:
            status = "unknown"
        print(
            f"  {str(item['target']):<20} "
            f"{str(item['tool']):<9} "
            f"{status:<7}  "
            f"{item['cwd']}"
        )


def print_invalid_plan(plan: list[dict[str, object]]) -> None:
    print("Non-restorable AI panes left untouched:")
    for item in plan:
        print(
            f"  {str(item['target']):<20} "
            f"{str(item['tool']):<9} "
            f"no saved conversation  "
            f"{item['cwd']}"
        )


def confirm_restart(count: int) -> bool:
    if not sys.stdin.isatty():
        raise RestartError("confirmation needs a terminal; rerun with --yes")
    answer = input(f"\nRestart and resume {count} AI pane(s)? [y/N] ").strip().lower()
    return answer in {"y", "yes"}


def confirm_unknown(count: int, targets: list[str]) -> bool:
    if not sys.stdin.isatty():
        raise RestartError(
            "unknown Agent Activity needs interactive confirmation or --force"
        )
    print(
        "\nAgent Activity could not be verified for these pane(s): "
        + ", ".join(targets)
    )
    answer = input(
        f"Only continue if all tasks are idle. Restart all {count} AI pane(s)? [y/N] "
    ).strip().lower()
    return answer in {"y", "yes"}


def wait_for_shells(tmux: Tmux, targets: list[str], timeout: float = 5.0) -> set[str]:
    deadline = time.monotonic() + timeout
    pending = set(targets)
    while pending and time.monotonic() < deadline:
        for target in tuple(pending):
            state = pane_state(tmux, target)
            if state and str(state["current_command"]).lower() in SHELL_COMMANDS:
                pending.remove(target)
        if pending:
            time.sleep(0.05)
    return pending


def captured_failure_reason(tmux: Tmux, target: str) -> str:
    completed = tmux.run(
        "capture-pane",
        "-p",
        "-t",
        target,
        "-S",
        "-40",
        check=False,
    )
    if completed.returncode != 0:
        return "pane disappeared"
    candidates = [line.strip() for line in completed.stdout.splitlines() if line.strip()]
    for line in reversed(candidates):
        lowered = line.lower()
        if any(
            marker in lowered
            for marker in ("error", "failed", "not found", "unable", "invalid")
        ):
            return line
    return "pane returned to its shell"


def wait_for_resumed_panes(
    tmux: Tmux,
    plan: list[dict[str, object]],
    *,
    timeout: float,
    stability: float,
) -> tuple[list[str], list[str]]:
    deadline = time.monotonic() + timeout
    pending = {str(item["target"]): item for item in plan}
    running_since: dict[str, float] = {}
    resumed: list[str] = []
    failures: list[str] = []

    while pending and time.monotonic() < deadline:
        now = time.monotonic()
        for target, item in tuple(pending.items()):
            state = pane_state(tmux, target)
            if state is None:
                failures.append(
                    f"failed to resume {target} ({item['tool']}): pane disappeared"
                )
                pending.pop(target)
                continue
            command = str(state["current_command"]).lower()
            if command in SHELL_COMMANDS:
                if target in running_since:
                    failures.append(
                        f"failed to resume {target} ({item['tool']}): "
                        f"{captured_failure_reason(tmux, target)}"
                    )
                    pending.pop(target)
                continue
            started = running_since.setdefault(target, now)
            if now - started >= stability:
                resumed.append(target)
                pending.pop(target)
        if pending:
            time.sleep(0.05)

    for target, item in pending.items():
        state = pane_state(tmux, target)
        if state and str(state["current_command"]).lower() in SHELL_COMMANDS:
            reason = captured_failure_reason(tmux, target)
        else:
            reason = "Agent process did not remain stable before timeout"
        failures.append(f"failed to resume {target} ({item['tool']}): {reason}")
    return resumed, failures


def restart_panes(
    tmux: Tmux,
    plan: list[dict[str, object]],
    restore_command: list[str],
    dump: Path,
    environment: dict[str, str],
) -> tuple[list[str], list[str]]:
    default_shell = tmux.value("show-option", "-gv", "default-shell")
    if not default_shell:
        default_shell = os.environ.get("SHELL", "/bin/zsh")

    targets: list[str] = []
    items_by_target: dict[str, dict[str, object]] = {}
    failures: list[str] = []
    for item in plan:
        target = str(item["target"])
        cwd = str(item["cwd"])
        completed = tmux.run(
            "respawn-pane",
            "-k",
            "-t",
            target,
            "-c",
            cwd,
            default_shell,
            check=False,
        )
        if completed.returncode != 0:
            failures.append(f"failed to respawn {target}: {completed.stderr.strip()}")
            continue
        targets.append(target)
        items_by_target[target] = item

    pending = wait_for_shells(tmux, targets)
    ready = [target for target in targets if target not in pending]
    if ready:
        subprocess.run(
            [*restore_command, "--dump", str(dump)],
            check=True,
            env=environment,
        )
    if pending:
        for target in sorted(pending):
            failures.append(f"failed to respawn {target}: shell did not become ready")

    verify_timeout = float(os.environ.get("AIPANE_RESTART_VERIFY_TIMEOUT", "8"))
    verify_stability = float(os.environ.get("AIPANE_RESTART_VERIFY_STABILITY", "1"))
    if verify_timeout <= 0 or verify_stability <= 0:
        raise RestartError("restart verification timing must be greater than zero")
    resumed, resume_failures = wait_for_resumed_panes(
        tmux,
        [items_by_target[target] for target in ready],
        timeout=verify_timeout,
        stability=verify_stability,
    )
    return resumed, [*failures, *resume_failures]


def main() -> int:
    parser = argparse.ArgumentParser(prog="ai-restart")
    parser.add_argument(
        "--dry-run",
        "-n",
        action="store_true",
        help="refresh the recovery snapshot and show the restart plan",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="restart even when Agent Activity is busy or unreported",
    )
    parser.add_argument(
        "--yes",
        "-y",
        action="store_true",
        help="skip the interactive confirmation",
    )
    arguments = parser.parse_args()

    tmux = Tmux()
    if tmux.run("list-sessions", check=False).returncode != 0:
        raise RestartError("no tmux server is available")

    script_dir = Path(__file__).resolve().parent
    restore_command = configured_command(
        "AIPANE_AI_RESTORE_COMMAND",
        script_dir / "ai-restore",
    )
    if not restore_command or not Path(restore_command[0]).is_file():
        raise RestartError("ai-restore was not found next to ai-restart")

    dump = save_snapshot(tmux, script_dir)
    environment = state_environment(tmux)
    restorable, invalid = recovery_plan(restore_command, dump, environment)
    plan = live_plan(tmux, restorable)
    invalid = live_plan(tmux, invalid)
    if invalid:
        print_invalid_plan(invalid)
        print()
    if not plan:
        print("ai-restart: no live, restorable AI panes found")
        return 0

    print_plan(plan)
    busy = [str(item["target"]) for item in plan if item["busy"]]
    unknown = [
        str(item["target"])
        for item in plan
        if item.get("activity_state") == "unknown"
    ]
    if arguments.dry_run:
        print("\nDry run: snapshot refreshed; no panes were restarted.")
        return 0
    if busy and not arguments.force:
        raise RestartError(
            "unsafe AI pane state: "
            + ", ".join(f"{target} (BUSY)" for target in busy)
            + "; wait for busy work to finish or use --force"
        )
    unknown_confirmed = False
    if unknown and not arguments.force:
        if arguments.yes:
            raise RestartError(
                "unknown Agent Activity cannot be accepted by --yes alone; "
                "use an interactive terminal or --force"
            )
        unknown_confirmed = confirm_unknown(len(plan), unknown)
        if not unknown_confirmed:
            print("ai-restart: cancelled")
            return 0
    if not arguments.yes and not unknown_confirmed and not confirm_restart(len(plan)):
        print("ai-restart: cancelled")
        return 0

    # A different pane could submit a prompt while this popup waits for
    # confirmation. Re-check every marker immediately before the destructive step.
    refreshed_plan = live_plan(tmux, plan)
    if len(refreshed_plan) != len(plan):
        raise RestartError("the live pane set changed after confirmation; retry")
    newly_busy = [str(item["target"]) for item in refreshed_plan if item["busy"]]
    newly_unknown = [
        str(item["target"])
        for item in refreshed_plan
        if item.get("activity_state") == "unknown"
    ]
    if newly_busy and not arguments.force:
        raise RestartError(
            "unsafe AI pane state after confirmation: "
            + ", ".join(f"{target} (BUSY)" for target in newly_busy)
            + "; retry when safe or use --force"
        )
    if (
        newly_unknown
        and not arguments.force
        and (
            not unknown_confirmed
            or not set(newly_unknown).issubset(set(unknown))
        )
    ):
        raise RestartError(
            "new unknown Agent Activity appeared after confirmation; retry"
        )

    resumed, failures = restart_panes(
        tmux,
        refreshed_plan,
        restore_command,
        dump,
        environment,
    )
    if failures:
        print(
            f"ai-restart: verified {len(resumed)} resumed; "
            f"{len(failures)} failed"
        )
        raise RestartError("; ".join(failures))
    print(f"ai-restart: verified {len(resumed)} AI pane(s) resumed")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RestartError, subprocess.CalledProcessError, OSError) as error:
        print(f"ai-restart: {error}", file=sys.stderr)
        raise SystemExit(1)
