#!/usr/bin/env python3
"""Confirm and seal an exact in-place restart plan for restorable AI Tools."""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


LIB_DIR = Path(__file__).resolve().parents[1] / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from agent_activity import AgentActivity, PaneActivity
from recovery_plan import GUARD_FIELDS, RecoveryPlanError, seal_plan


FIELD_SEPARATOR = "\x1f"
ACTIVITY_OPTION = "@tmux-window-wrap-activity"
ACTIVITY_REPORTER_OPTION = "@tmux-window-wrap-activity-reporter"
ACTIVITY_UPDATED_AT_OPTION = "@tmux-window-wrap-activity-updated-at"
ACTIVITY_RECORD_OPTION = "@tmux-window-wrap-activity-record"


class RestartError(RuntimeError):
    pass


def command_from_env(name: str, default: list[str]) -> list[str]:
    raw = os.environ.get(name)
    return shlex.split(raw) if raw else default


class Tmux:
    def __init__(self) -> None:
        self.command = command_from_env("AIPANE_TMUX", ["tmux"])

    def run(
        self,
        *arguments: str,
        check: bool = True,
        capture_output: bool = True,
    ) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            [*self.command, *arguments],
            check=check,
            capture_output=capture_output,
            text=True,
        )


def configured_command(name: str, fallback: Path) -> list[str]:
    return command_from_env(name, [str(fallback)])


def state_environment(tmux: Tmux) -> dict[str, str]:
    environment = os.environ.copy()
    environment["AIPANE_TMUX"] = shlex.join(tmux.command)
    return environment


def resurrect_dump_path(tmux: Tmux) -> Path:
    completed = tmux.run(
        "show-option",
        "-gqv",
        "@resurrect-dir",
        check=False,
    )
    configured = completed.stdout.strip()
    if configured:
        directory = Path(os.path.expandvars(os.path.expanduser(configured)))
    else:
        data_home = Path(
            os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")
        )
        directory = data_home / "tmux" / "resurrect"
    return directory / "last"


def save_snapshot(tmux: Tmux, script_dir: Path) -> Path:
    override = os.environ.get("AIPANE_RESURRECT_SAVE_SCRIPT")
    if override:
        save_command = shlex.split(override)
    else:
        completed = tmux.run(
            "show-option",
            "-gqv",
            "@resurrect-save-script-path",
            check=False,
        )
        configured = completed.stdout.strip()
        if configured:
            save_command = [os.path.expandvars(os.path.expanduser(configured))]
        else:
            save_command = [
                str(Path.home() / ".tmux" / "plugins" / "tmux-resurrect" / "scripts" / "save.sh")
            ]

    if not save_command or not Path(save_command[0]).is_file():
        raise RestartError(
            "tmux-resurrect save script was not found; install/load tmux-resurrect first"
        )

    environment = state_environment(tmux)
    subprocess.run(save_command, check=True, env=environment)

    # The configured post-save hook normally does this. Running it again is
    # harmless and makes ai-restart self-contained when the hook is absent.
    snapshot_command = configured_command(
        "AIPANE_SNAPSHOT_COMMAND",
        script_dir / "aipane-snapshot",
    )
    if snapshot_command and Path(snapshot_command[0]).is_file():
        subprocess.run(
            snapshot_command,
            check=True,
            env=environment,
            stdout=subprocess.DEVNULL,
        )

    dump = resurrect_dump_path(tmux)
    if not dump.exists():
        raise RestartError(f"tmux-resurrect did not produce a snapshot at {dump}")
    try:
        return dump.resolve(strict=True)
    except OSError as error:
        raise RestartError(f"could not pin the saved snapshot {dump}: {error}") from error


def recovery_plan(
    restore_command: list[str],
    dump: Path,
    environment: dict[str, str],
) -> tuple[list[dict[str, object]], list[dict[str, object]]]:
    completed = subprocess.run(
        [*restore_command, "--plan-json", "--dump", str(dump)],
        check=True,
        capture_output=True,
        text=True,
        env=environment,
    )
    plan: list[dict[str, object]] = []
    invalid: list[dict[str, object]] = []
    for number, line in enumerate(completed.stdout.splitlines(), start=1):
        if not line.strip():
            continue
        try:
            item = json.loads(line)
        except json.JSONDecodeError as error:
            raise RestartError(
                f"ai-restore returned invalid plan JSON on line {number}: {error}"
            ) from error
        if not isinstance(item, dict):
            raise RestartError(f"ai-restore plan line {number} is not an object")
        if item.get("restorable") is True:
            plan.append(item)
        elif item.get("kind") == "invalid":
            invalid.append(item)
    return plan, invalid


def pane_state(
    tmux: Tmux,
    target: str,
    resolver: AgentActivity | None = None,
) -> dict[str, object] | None:
    pane_format = FIELD_SEPARATOR.join(
        (
            "#{pane_id}",
            "#{pane_current_command}",
            "#{session_name}:#{window_id}.#{pane_id}",
            "#{pane_tty}",
            "#{socket_path}",
            "#{pid}",
            "#{pane_pid}",
            f"#{{{ACTIVITY_OPTION}}}",
            f"#{{{ACTIVITY_REPORTER_OPTION}}}",
            f"#{{{ACTIVITY_UPDATED_AT_OPTION}}}",
            f"#{{{ACTIVITY_RECORD_OPTION}}}",
        )
    )
    completed = tmux.run(
        "display-message",
        "-p",
        "-t",
        target,
        pane_format,
        check=False,
    )
    if completed.returncode != 0:
        return None
    fields = completed.stdout.rstrip("\n").split(FIELD_SEPARATOR, 10)
    if len(fields) != 11:
        return None
    (
        pane_id,
        current_command,
        canonical_target,
        pane_tty,
        socket_path,
        server_pid,
        pane_pid,
        activity_marker,
        activity_reporter,
        activity_updated_at,
        activity_record,
    ) = fields
    resolver = resolver or AgentActivity()
    view = resolver.resolve(
        PaneActivity(
            pane_id=pane_id,
            current_command=current_command,
            target=canonical_target,
            pane_tty=pane_tty,
            socket_path=socket_path,
            server_pid=server_pid,
            marker=activity_marker,
            reporter=activity_reporter,
            marker_updated_at=activity_updated_at,
            record=activity_record,
        )
    )
    return {
        "pane_id": pane_id,
        "current_command": current_command,
        "busy": view.state == "busy",
        "reported": view.reported,
        "activity_state": view.state,
        "activity_reason": view.reason,
        "activity_evidence": view.evidence_turn_id,
        "guard": {
            "pane_id": pane_id,
            "socket_path": socket_path,
            "server_pid": server_pid,
            "pane_pid": pane_pid,
            "current_command": current_command,
            "activity_marker": activity_marker,
            "activity_reporter": activity_reporter,
            "activity_updated_at": activity_updated_at,
            "activity_record": activity_record,
        },
    }


def live_plan(tmux: Tmux, plan: list[dict[str, object]]) -> list[dict[str, object]]:
    result: list[dict[str, object]] = []
    seen: set[str] = set()
    resolver = AgentActivity()
    for item in plan:
        target = str(item.get("target", ""))
        if not target or target in seen:
            continue
        state = pane_state(tmux, target, resolver)
        if state is None:
            continue
        live_guard = state.get("guard")
        expected_guard = item.get("guard")
        if isinstance(expected_guard, dict):
            normalized = {
                field_name: str(expected_guard.get(field_name, ""))
                for field_name in GUARD_FIELDS
            }
            if live_guard != normalized:
                raise RestartError(
                    f"pane guard changed for {target} after confirmation; retry"
                )
        else:
            legacy_expected = (
                str(item.get("pane_id", "")),
                str(item.get("socket_path", "")),
                str(item.get("server_pid", "")),
            )
            if all(legacy_expected) and isinstance(live_guard, dict):
                legacy_live = (
                    live_guard["pane_id"],
                    live_guard["socket_path"],
                    live_guard["server_pid"],
                )
                if legacy_expected != legacy_live:
                    raise RestartError(
                        f"stored pane identity no longer matches {target}; retry"
                    )
        seen.add(target)
        result.append({**item, **state})
    return result


def print_plan(plan: list[dict[str, object]]) -> None:
    print("AI panes to restart:")
    for item in plan:
        if item.get("activity_state") == "busy":
            status = "BUSY"
        elif item.get("activity_state") == "idle":
            status = "idle"
        else:
            status = "unknown"
        print(
            f"  {str(item['target']):<20} "
            f"{str(item['tool']):<9} "
            f"{status:<7}  "
            f"{item['cwd']}"
        )


def print_invalid_plan(plan: list[dict[str, object]]) -> None:
    print("Non-restorable AI panes left untouched:")
    for item in plan:
        print(
            f"  {str(item['target']):<20} "
            f"{str(item['tool']):<9} "
            f"no saved conversation  "
            f"{item['cwd']}"
        )


def confirm_restart(count: int) -> bool:
    if not sys.stdin.isatty():
        raise RestartError("confirmation needs a terminal; rerun with --yes")
    answer = input(f"\nRestart and resume {count} AI pane(s)? [y/N] ").strip().lower()
    return answer in {"y", "yes"}


def confirm_unknown(count: int, targets: list[str]) -> bool:
    if not sys.stdin.isatty():
        raise RestartError(
            "unknown Agent Activity needs interactive confirmation or --force"
        )
    print(
        "\nAgent Activity could not be verified for these pane(s): "
        + ", ".join(targets)
    )
    answer = input(
        f"Only continue if all tasks are idle. Restart all {count} AI pane(s)? [y/N] "
    ).strip().lower()
    return answer in {"y", "yes"}


def exact_plan_items(plan: list[dict[str, object]]) -> list[dict[str, object]]:
    fields = ("target", "tool", "kind", "restorable", "cwd", "command", "sid")
    exact: list[dict[str, object]] = []
    for item in plan:
        guard = item.get("guard")
        if not isinstance(guard, dict):
            raise RestartError(f"missing pane guard for {item.get('target', 'unknown')}")
        exact.append(
            {
                **{field_name: item.get(field_name, "") for field_name in fields},
                "guard": {
                    field_name: str(guard.get(field_name, ""))
                    for field_name in GUARD_FIELDS
                },
            }
        )
    return exact


def recovery_executor_command(script_dir: Path) -> list[str]:
    configured = os.environ.get("AIPANE_RESTART_EXECUTOR_COMMAND")
    if configured is None:
        configured = os.environ.get("AIPANE_RESTORE_EXECUTOR")
    command = (
        shlex.split(configured)
        if configured
        else [str(script_dir / "aipane-restore-executor")]
    )
    if not command or not (Path(command[0]).is_file() or shutil.which(command[0])):
        raise RestartError("aipane-restore-executor was not found next to ai-restart")
    return command


def execute_sealed_plan(
    plan: list[dict[str, object]],
    dump: Path,
    environment: dict[str, str],
    script_dir: Path,
) -> None:
    state_dir = Path(
        environment.get("AIPANE_STATE_DIR")
        or Path(environment.get("XDG_DATA_HOME", Path.home() / ".local/share"))
        / "aipane"
    )
    state_dir.mkdir(parents=True, exist_ok=True)
    descriptor, raw_path = tempfile.mkstemp(
        prefix="restart-plan.",
        suffix=".json",
        dir=state_dir,
    )
    os.close(descriptor)
    plan_path = Path(raw_path)
    try:
        exact = exact_plan_items(plan)
        seal_plan(plan_path, dump, exact)
        completed = subprocess.run(
            [
                *recovery_executor_command(script_dir),
                "--sealed-plan",
                str(plan_path),
                "--report-json",
            ],
            check=False,
            capture_output=True,
            text=True,
            env=environment,
        )
        lines = [line for line in completed.stdout.splitlines() if line.strip()]
        if not lines:
            reason = completed.stderr.strip() or "recovery executor returned no report"
            raise RestartError(reason)
        try:
            report = json.loads(lines[-1])
        except json.JSONDecodeError as error:
            raise RestartError(f"recovery executor returned an invalid report: {error}") from error
        if not isinstance(report, dict):
            raise RestartError("recovery executor report is not an object")
        try:
            verified = int(report["verified"])
            pending = int(report["pending"])
        except (KeyError, TypeError, ValueError) as error:
            raise RestartError("recovery executor report is incomplete") from error
        if verified < 0 or pending < 0 or verified + pending != len(exact):
            raise RestartError("recovery executor report does not cover the confirmed target set")
        disabled = report.get("disabled_windows", [])
        if isinstance(disabled, list) and disabled:
            print("ai-restart: disabled SYNC for " + ", ".join(sorted(map(str, disabled))))
        if completed.returncode != 0 or pending:
            print(f"ai-restart: verified {verified} resumed; {pending} pending")
            errors = report.get("errors", [])
            reasons = [str(error) for error in errors] if isinstance(errors, list) else []
            if not reasons:
                reasons.append(completed.stderr.strip() or "recovery remains pending")
            raise RestartError("; ".join(reasons))
        print(f"ai-restart: verified {verified} AI pane(s) resumed")
    finally:
        try:
            plan_path.unlink()
        except OSError:
            pass


def main() -> int:
    parser = argparse.ArgumentParser(prog="ai-restart")
    parser.add_argument(
        "--dry-run",
        "-n",
        action="store_true",
        help="refresh the recovery snapshot and show the restart plan",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="restart even when Agent Activity is busy or unreported",
    )
    parser.add_argument(
        "--yes",
        "-y",
        action="store_true",
        help="skip the interactive confirmation",
    )
    arguments = parser.parse_args()

    tmux = Tmux()
    if tmux.run("list-sessions", check=False).returncode != 0:
        raise RestartError("no tmux server is available")

    script_dir = Path(__file__).resolve().parent
    restore_command = configured_command(
        "AIPANE_AI_RESTORE_COMMAND",
        script_dir / "ai-restore",
    )
    if not restore_command or not Path(restore_command[0]).is_file():
        raise RestartError("ai-restore was not found next to ai-restart")

    dump = save_snapshot(tmux, script_dir)
    environment = state_environment(tmux)
    restorable, invalid = recovery_plan(restore_command, dump, environment)
    plan = live_plan(tmux, restorable)
    invalid = live_plan(tmux, invalid)
    if invalid:
        print_invalid_plan(invalid)
        print()
    if not plan:
        print("ai-restart: no live, restorable AI panes found")
        return 0

    print_plan(plan)
    busy = [str(item["target"]) for item in plan if item["busy"]]
    unknown = [
        str(item["target"])
        for item in plan
        if item.get("activity_state") == "unknown"
    ]
    if arguments.dry_run:
        print("\nDry run: snapshot refreshed; no panes were restarted.")
        return 0
    if busy and not arguments.force:
        raise RestartError(
            "unsafe AI pane state: "
            + ", ".join(f"{target} (BUSY)" for target in busy)
            + "; wait for busy work to finish or use --force"
        )
    unknown_confirmed = False
    if unknown and not arguments.force:
        if arguments.yes:
            raise RestartError(
                "unknown Agent Activity cannot be accepted by --yes alone; "
                "use an interactive terminal or --force"
            )
        unknown_confirmed = confirm_unknown(len(plan), unknown)
        if not unknown_confirmed:
            print("ai-restart: cancelled")
            return 0
    if not arguments.yes and not unknown_confirmed and not confirm_restart(len(plan)):
        print("ai-restart: cancelled")
        return 0

    # A different pane could submit a prompt while this popup waits for
    # confirmation. Re-check every marker immediately before the destructive step.
    refreshed_plan = live_plan(tmux, plan)
    if [item["target"] for item in refreshed_plan] != [
        item["target"] for item in plan
    ]:
        raise RestartError("the live pane set changed after confirmation; retry")
    newly_busy = [str(item["target"]) for item in refreshed_plan if item["busy"]]
    newly_unknown = [
        str(item["target"])
        for item in refreshed_plan
        if item.get("activity_state") == "unknown"
    ]
    if newly_busy and not arguments.force:
        raise RestartError(
            "unsafe AI pane state after confirmation: "
            + ", ".join(f"{target} (BUSY)" for target in newly_busy)
            + "; retry when safe or use --force"
        )
    if (
        newly_unknown
        and not arguments.force
        and (
            not unknown_confirmed
            or not set(newly_unknown).issubset(set(unknown))
        )
    ):
        raise RestartError(
            "new unknown Agent Activity appeared after confirmation; retry"
        )

    execute_sealed_plan(refreshed_plan, dump, environment, script_dir)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (
        RecoveryPlanError,
        RestartError,
        subprocess.CalledProcessError,
        OSError,
    ) as error:
        print(f"ai-restart: {error}", file=sys.stderr)
        raise SystemExit(1)
