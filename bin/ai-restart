#!/usr/bin/env python3
"""Restart restorable AI Tools in place and resume their saved sessions.

The command refreshes the tmux-resurrect snapshot, asks ai-restore for its
machine-readable plan, replaces only those AI panes with an idle shell, and
then lets ai-restore resume the same sessions in the same panes.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
import time
from pathlib import Path


FIELD_SEPARATOR = "\x1f"
ACTIVITY_OPTION = "@tmux-window-wrap-activity"
ACTIVITY_REPORTER_OPTION = "@tmux-window-wrap-activity-reporter"
SHELL_COMMANDS = {"zsh", "-zsh", "bash", "-bash", "sh", "-sh", "fish", "-fish"}


class RestartError(RuntimeError):
    pass


def command_from_env(name: str, default: list[str]) -> list[str]:
    raw = os.environ.get(name)
    return shlex.split(raw) if raw else default


class Tmux:
    def __init__(self) -> None:
        self.command = command_from_env("AIPANE_TMUX", ["tmux"])

    def run(
        self,
        *arguments: str,
        check: bool = True,
        capture_output: bool = True,
    ) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            [*self.command, *arguments],
            check=check,
            capture_output=capture_output,
            text=True,
        )

    def value(self, *arguments: str) -> str:
        return self.run(*arguments).stdout.strip()


def configured_command(name: str, fallback: Path) -> list[str]:
    return command_from_env(name, [str(fallback)])


def state_environment(tmux: Tmux) -> dict[str, str]:
    environment = os.environ.copy()
    environment["AIPANE_TMUX"] = shlex.join(tmux.command)
    return environment


def resurrect_dump_path(tmux: Tmux) -> Path:
    completed = tmux.run(
        "show-option",
        "-gqv",
        "@resurrect-dir",
        check=False,
    )
    configured = completed.stdout.strip()
    if configured:
        directory = Path(os.path.expandvars(os.path.expanduser(configured)))
    else:
        data_home = Path(
            os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")
        )
        directory = data_home / "tmux" / "resurrect"
    return directory / "last"


def save_snapshot(tmux: Tmux, script_dir: Path) -> Path:
    override = os.environ.get("AIPANE_RESURRECT_SAVE_SCRIPT")
    if override:
        save_command = shlex.split(override)
    else:
        completed = tmux.run(
            "show-option",
            "-gqv",
            "@resurrect-save-script-path",
            check=False,
        )
        configured = completed.stdout.strip()
        if configured:
            save_command = [os.path.expandvars(os.path.expanduser(configured))]
        else:
            save_command = [
                str(Path.home() / ".tmux" / "plugins" / "tmux-resurrect" / "scripts" / "save.sh")
            ]

    if not save_command or not Path(save_command[0]).is_file():
        raise RestartError(
            "tmux-resurrect save script was not found; install/load tmux-resurrect first"
        )

    environment = state_environment(tmux)
    subprocess.run(save_command, check=True, env=environment)

    # The configured post-save hook normally does this. Running it again is
    # harmless and makes ai-restart self-contained when the hook is absent.
    snapshot_command = configured_command(
        "AIPANE_SNAPSHOT_COMMAND",
        script_dir / "aipane-snapshot",
    )
    if snapshot_command and Path(snapshot_command[0]).is_file():
        subprocess.run(
            snapshot_command,
            check=True,
            env=environment,
            stdout=subprocess.DEVNULL,
        )

    dump = resurrect_dump_path(tmux)
    if not dump.exists():
        raise RestartError(f"tmux-resurrect did not produce a snapshot at {dump}")
    return dump


def recovery_plan(
    restore_command: list[str],
    dump: Path,
    environment: dict[str, str],
) -> list[dict[str, object]]:
    completed = subprocess.run(
        [*restore_command, "--plan-json", "--dump", str(dump)],
        check=True,
        capture_output=True,
        text=True,
        env=environment,
    )
    plan: list[dict[str, object]] = []
    for number, line in enumerate(completed.stdout.splitlines(), start=1):
        if not line.strip():
            continue
        try:
            item = json.loads(line)
        except json.JSONDecodeError as error:
            raise RestartError(
                f"ai-restore returned invalid plan JSON on line {number}: {error}"
            ) from error
        if not isinstance(item, dict):
            raise RestartError(f"ai-restore plan line {number} is not an object")
        if item.get("restorable") is True:
            plan.append(item)
    return plan


def pane_state(tmux: Tmux, target: str) -> dict[str, object] | None:
    pane_format = FIELD_SEPARATOR.join(
        (
            "#{pane_id}",
            "#{pane_current_command}",
            f"#{{{ACTIVITY_OPTION}}}",
            f"#{{{ACTIVITY_REPORTER_OPTION}}}",
        )
    )
    completed = tmux.run(
        "display-message",
        "-p",
        "-t",
        target,
        pane_format,
        check=False,
    )
    if completed.returncode != 0:
        return None
    fields = completed.stdout.rstrip("\n").split(FIELD_SEPARATOR, 3)
    if len(fields) != 4:
        return None
    pane_id, current_command, activity_source, activity_reporter = fields
    busy = bool(activity_source) and activity_source == current_command
    return {
        "pane_id": pane_id,
        "current_command": current_command,
        "busy": busy,
        "reported": busy or activity_reporter == current_command,
    }


def live_plan(tmux: Tmux, plan: list[dict[str, object]]) -> list[dict[str, object]]:
    result: list[dict[str, object]] = []
    seen: set[str] = set()
    for item in plan:
        target = str(item.get("target", ""))
        if not target or target in seen:
            continue
        state = pane_state(tmux, target)
        if state is None:
            continue
        seen.add(target)
        result.append({**item, **state})
    return result


def print_plan(plan: list[dict[str, object]]) -> None:
    print("AI panes to restart:")
    for item in plan:
        if item["busy"]:
            status = "BUSY"
        elif item["reported"]:
            status = "idle"
        else:
            status = "unknown"
        print(
            f"  {str(item['target']):<20} "
            f"{str(item['tool']):<9} "
            f"{status:<7}  "
            f"{item['cwd']}"
        )


def confirm_restart(count: int) -> bool:
    if not sys.stdin.isatty():
        raise RestartError("confirmation needs a terminal; rerun with --yes")
    answer = input(f"\nRestart and resume {count} AI pane(s)? [y/N] ").strip().lower()
    return answer in {"y", "yes"}


def confirm_unknown(count: int, targets: list[str]) -> bool:
    if not sys.stdin.isatty():
        raise RestartError(
            "unknown Agent Activity needs interactive confirmation or --force"
        )
    print(
        "\nThese pane(s) have not loaded the new activity hooks: "
        + ", ".join(targets)
    )
    answer = input(
        f"Only continue if all tasks are idle. Restart all {count} AI pane(s)? [y/N] "
    ).strip().lower()
    return answer in {"y", "yes"}


def wait_for_shells(tmux: Tmux, targets: list[str], timeout: float = 5.0) -> set[str]:
    deadline = time.monotonic() + timeout
    pending = set(targets)
    while pending and time.monotonic() < deadline:
        for target in tuple(pending):
            state = pane_state(tmux, target)
            if state and str(state["current_command"]).lower() in SHELL_COMMANDS:
                pending.remove(target)
        if pending:
            time.sleep(0.05)
    return pending


def restart_panes(
    tmux: Tmux,
    plan: list[dict[str, object]],
    restore_command: list[str],
    dump: Path,
    environment: dict[str, str],
) -> None:
    default_shell = tmux.value("show-option", "-gv", "default-shell")
    if not default_shell:
        default_shell = os.environ.get("SHELL", "/bin/zsh")

    targets: list[str] = []
    failures: list[str] = []
    for item in plan:
        target = str(item["target"])
        cwd = str(item["cwd"])
        completed = tmux.run(
            "respawn-pane",
            "-k",
            "-t",
            target,
            "-c",
            cwd,
            default_shell,
            check=False,
        )
        if completed.returncode != 0:
            failures.append(f"failed to respawn {target}: {completed.stderr.strip()}")
            continue
        targets.append(target)

    pending = wait_for_shells(tmux, targets)
    if targets:
        subprocess.run(
            [*restore_command, "--dump", str(dump)],
            check=True,
            env=environment,
        )
    if pending:
        failures.append(
            "pane shell did not become ready: " + ", ".join(sorted(pending))
        )
    if failures:
        raise RestartError("; ".join(failures))


def main() -> int:
    parser = argparse.ArgumentParser(prog="ai-restart")
    parser.add_argument(
        "--dry-run",
        "-n",
        action="store_true",
        help="refresh the recovery snapshot and show the restart plan",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="restart even when Agent Activity is busy or unreported",
    )
    parser.add_argument(
        "--yes",
        "-y",
        action="store_true",
        help="skip the interactive confirmation",
    )
    arguments = parser.parse_args()

    tmux = Tmux()
    if tmux.run("list-sessions", check=False).returncode != 0:
        raise RestartError("no tmux server is available")

    script_dir = Path(__file__).resolve().parent
    restore_command = configured_command(
        "AIPANE_AI_RESTORE_COMMAND",
        script_dir / "ai-restore",
    )
    if not restore_command or not Path(restore_command[0]).is_file():
        raise RestartError("ai-restore was not found next to ai-restart")

    dump = save_snapshot(tmux, script_dir)
    environment = state_environment(tmux)
    plan = live_plan(tmux, recovery_plan(restore_command, dump, environment))
    if not plan:
        print("ai-restart: no live, restorable AI panes found")
        return 0

    print_plan(plan)
    busy = [str(item["target"]) for item in plan if item["busy"]]
    unknown = [str(item["target"]) for item in plan if not item["reported"]]
    if arguments.dry_run:
        print("\nDry run: snapshot refreshed; no panes were restarted.")
        return 0
    if busy and not arguments.force:
        raise RestartError(
            "unsafe AI pane state: "
            + ", ".join(f"{target} (BUSY)" for target in busy)
            + "; wait for busy work to finish or use --force"
        )
    unknown_confirmed = False
    if unknown and not arguments.force:
        if arguments.yes:
            raise RestartError(
                "unknown Agent Activity cannot be accepted by --yes alone; "
                "use an interactive terminal or --force"
            )
        unknown_confirmed = confirm_unknown(len(plan), unknown)
        if not unknown_confirmed:
            print("ai-restart: cancelled")
            return 0
    if not arguments.yes and not unknown_confirmed and not confirm_restart(len(plan)):
        print("ai-restart: cancelled")
        return 0

    # A different pane could submit a prompt while this popup waits for
    # confirmation. Re-check every marker immediately before the destructive step.
    refreshed_plan = live_plan(tmux, plan)
    if len(refreshed_plan) != len(plan):
        raise RestartError("the live pane set changed after confirmation; retry")
    newly_busy = [str(item["target"]) for item in refreshed_plan if item["busy"]]
    newly_unknown = [
        str(item["target"]) for item in refreshed_plan if not item["reported"]
    ]
    if newly_busy and not arguments.force:
        raise RestartError(
            "unsafe AI pane state after confirmation: "
            + ", ".join(f"{target} (BUSY)" for target in newly_busy)
            + "; retry when safe or use --force"
        )
    if (
        newly_unknown
        and not arguments.force
        and (
            not unknown_confirmed
            or not set(newly_unknown).issubset(set(unknown))
        )
    ):
        raise RestartError(
            "new unknown Agent Activity appeared after confirmation; retry"
        )

    restart_panes(tmux, refreshed_plan, restore_command, dump, environment)
    print(f"ai-restart: restarted and resumed {len(refreshed_plan)} AI pane(s)")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RestartError, subprocess.CalledProcessError, OSError) as error:
        print(f"ai-restart: {error}", file=sys.stderr)
        raise SystemExit(1)
