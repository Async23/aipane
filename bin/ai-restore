#!/usr/bin/env zsh
# ai-restore — after tmux-resurrect restores the window/pane structure, resume the
# AI CLI session that each pane was running.
#
# How it works (see ../docs/session-restore-design.md in this repository):
#   - tmux-resurrect saves the FULL command line of every pane's foreground program.
#   - aipane's gold-case launch puts the session id straight into that command line
#     (Pi/Grok/Claude via --session-id), and any
#     `resume`-style launch already carries its id too.
#   - For tools whose active session still matches their launch argv, the resurrect
#     dump contains the id directly. Pi/Codex/Grok/dsh can replace sessions in-process, so
#     their binding captured in this same dump takes precedence over launch argv.
#   - We parse that durable identity into a declarative plan. The adjacent
#     aipane-restore-executor persists unfinished intent, launches cleanly,
#     verifies readiness, retries transient failures, and only then rebinds.
#
# Trigger: @resurrect-hook-post-restore-all 'ai-restore'  (runs after restore settles).
# Manual : ai-restore            (act) | ai-restore --dry-run (print plan only)
# Machine: ai-restore --plan-json (this dump's plan only; no pending intent merged)
#
# Safety: a pane is launched only from an idle shell. An already-running matching
# Agent is verified without replacement; any different foreground program is left
# untouched and the recovery intent stays pending for a later retry.

emulate -L zsh
setopt no_nomatch pipefail

export PATH="/opt/homebrew/bin:$HOME/.local/bin:$HOME/.grok/bin:$HOME/.kimi-code/bin:$PATH"

typeset -a TMUX_CMD
TMUX_CMD=("${(@z)${AIPANE_TMUX:-tmux}}")
run_tmux() { command "${TMUX_CMD[@]}" "$@"; }

# ---- options -------------------------------------------------------------
typeset DRYRUN=0 PLAN_JSON=0 DUMP="" DELAY="${AI_RESTORE_SETTLE_DELAY:-0.4}"
while (( $# > 0 )); do
  case "$1" in
    --dry-run|-n) DRYRUN=1 ;;
    --plan-json) DRYRUN=1; PLAN_JSON=1 ;;
    --dump) shift; DUMP="$1" ;;
    --delay) shift; DELAY="$1" ;;
    -h|--help)
      print "usage: ai-restore [--dry-run|--plan-json] [--dump FILE] [--delay SECS]"
      return 0 2>/dev/null || exit 0 ;;
    *) DUMP="$1" ;;
  esac
  shift
done

typeset STATE_DIR="${AIPANE_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aipane}"
typeset LOG="$STATE_DIR/ai-restore.log"
typeset PI_SESSION_ROOT="${PI_CODING_AGENT_SESSION_DIR:-${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/sessions}"
mkdir -p "$STATE_DIR" 2>/dev/null

typeset SCRIPT_DIR="${${(%):-%x}:A:h}"
typeset EXECUTOR="${AIPANE_RESTORE_EXECUTOR:-$SCRIPT_DIR/aipane-restore-executor}"
if [[ ! -x "$EXECUTOR" ]]; then
  print -u2 "ai-restore: recovery executor not found at $EXECUTOR"
  return 1 2>/dev/null || exit 1
fi
typeset PLAN_FILE
PLAN_FILE="$(mktemp "$STATE_DIR/ai-restore-plan.XXXXXX")" || {
  print -u2 "ai-restore: could not create recovery plan"
  return 1 2>/dev/null || exit 1
}
cleanup_plan() { command rm -f -- "$PLAN_FILE" 2>/dev/null; }
trap cleanup_plan EXIT

log() { print -r -- "$(date '+%F %T') $*" >>"$LOG" 2>/dev/null; }

# ---- resolve the dump ----------------------------------------------------
if [[ -z "$DUMP" ]]; then
  local dir
  dir="$(run_tmux show-option -gqv @resurrect-dir 2>/dev/null)"
  [[ -n "$dir" ]] || dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
  DUMP="$dir/last"
fi
if [[ ! -e "$DUMP" ]]; then
  log "no resurrect dump at $DUMP"
  print -u2 "ai-restore: no resurrect dump at $DUMP"
  return 1 2>/dev/null || exit 1
fi

# Session identities belong to this exact dump, never the global latest map.
typeset -A COORDS_SID COORDS_TOOL COORDS_DSH_HOME COORDS_SESSION_ROOT COORDS_CWD COORDS_CODEX_HOME COORDS_AGY
typeset paired_rows
paired_rows="$(command python3 "$SCRIPT_DIR/../lib/recovery_snapshot.py" "$DUMP")" || exit 1
while IFS=$'\x1f' read -r _cl _sid _tool _dsh_home _session_root _cwd _codex_home _agy; do
  if [[ -n "$_cl" ]]; then
    COORDS_SID[$_cl]="$_sid"
    COORDS_TOOL[$_cl]="$_tool"
    COORDS_DSH_HOME[$_cl]="$_dsh_home"
    COORDS_SESSION_ROOT[$_cl]="$_session_root"
    COORDS_CWD[$_cl]="$_cwd"
    COORDS_CODEX_HOME[$_cl]="$_codex_home"
    COORDS_AGY[$_cl]="$_agy"
  fi
done <<< "$paired_rows"

# lowercase-hex UUID matcher (matches both v4 and codex/grok's uuidv7)
typeset UUID_RE='[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'

# Only auto-run panes whose exact session id is recoverable ("resume"). Panes with
# no recoverable id ("fresh") are left as an idle shell by default — re-launching a
# brand-new AI there has no recovery value and costs tokens. Set AI_RESTORE_FRESH=1
# to also re-launch fresh panes.
typeset RESTORE_FRESH="${AI_RESTORE_FRESH:-0}"

# Base launch commands used to rebuild a resume line. Honor direct command overrides
# when they are present; otherwise use plain binaries from a bare hook environment.
typeset PI_BASE="${AIPANE_PI_LAUNCH_CMD:-pi}"
typeset GROK_BASE="${AIPANE_GROK_LAUNCH_CMD:-grok --always-approve}"
typeset CLAUDE_BASE="${AIPANE_CLAUDE_LAUNCH_CMD:-claude --dangerously-skip-permissions}"
typeset CODEX_BASE="${AIPANE_CODEX_LAUNCH_CMD:-codex --yolo}"
typeset KIMI_BASE="${AIPANE_KIMI_LAUNCH_CMD:-kimi --auto}"
typeset DSH_BASE="${AIPANE_DSH_LAUNCH_CMD:-dsh-tui}"
typeset AGY_BASE="${AIPANE_AGY_LAUNCH_CMD:-agy}"

# Migrate exact retired local overrides that can survive in an already-running
# Ghostty shell or a restored tmux global environment.
[[ "$CLAUDE_BASE" == "claude-guard --dangerously-skip-permissions" ]] &&
  CLAUDE_BASE="claude --dangerously-skip-permissions"
[[ "$CODEX_BASE" == "codexx" ]] &&
  CODEX_BASE="codex --yolo --disable plugins"
typeset CODEX_RESTORE_BASE="$CODEX_BASE -c check_for_update_on_startup=false"

# detect_tool <full_cmd> <cur_cmd> -> REPLY is the supported tool name or ""
detect_tool() {
  local full="$1" cur="$2" prog
  REPLY=""
  # A saved foreground shell must stay a shell. The full-command field can
  # still contain a stale/background Agent command, even with a session binding.
  case "${cur#-}" in
    sh|bash|zsh|fish|dash|ksh|csh|tcsh) return ;;
  esac
  prog="${full%% *}"; prog="${prog:t}"      # basename of argv[0]
  if [[ "$prog" == node ]]; then
    # tmux-resurrect saves the outer Node launcher, often ~/.local/bin/dsh-tui.
    # Inspect the script token, not arbitrary later prompt/argument substrings.
    local -a argv=("${(@Q)${(z)full}}")
    # Unknown Node options may consume the following word as a value (-e/-r).
    # Only the plain script position is unambiguous without parsing Node's CLI.
    local script="${argv[2]:-}"
    if [[ "$script" != -* && ( "${script:t}" == (dsh|dsh-tui|dsh-tui.js|dst) ||
          "$script" == */@deepseek-ai/dsh/* || "$script" == */@deepseek-harness-tui/dsh-tui/* ) ]]; then
      REPLY=dsh; return
    fi
  fi
  case "$prog" in
    agy) REPLY=agy ;;
    pi)                REPLY=pi ;;
    grok|grok-*)       REPLY=grok ;;
    # Compatibility: recognize commands captured in pre-removal resurrect dumps.
    claude|claude-guard) REPLY=claude ;;
    codex|codexx|codex-*) REPLY=codex ;;
    kimi|kimi-*)         REPLY=kimi ;;        # Mach-O SEA, argv0 = kimi
    dsh|dsh-tui|dst)     REPLY=dsh ;;
    node|"")
      # Node wrapper: fall back to the (truncated) current command
      case "$cur" in
        grok-*)  REPLY=grok ;;
        codex-*) REPLY=codex ;;
        pi|pi-*) REPLY=pi ;;
        dsh|dsh-tui|dst) REPLY=dsh ;;
      esac ;;
    *)
      case "$cur" in
        grok-*)     REPLY=grok ;;
        codex-*)    REPLY=codex ;;
        kimi)       REPLY=kimi ;;
        dsh|dsh-tui|dst) REPLY=dsh ;;
      esac ;;
  esac
}

# extract_uuid <string> -> REPLY (first uuid-shaped token) or ""
extract_uuid() {
  REPLY=""
  if [[ "$1" =~ "$UUID_RE" ]]; then REPLY="${MATCH:l}"; fi
}

# coord_tool_matches <detected tool name> <snapshot tool tag>
coord_tool_matches() {
  local detected="$1" recorded="$2" tag
  case "$detected" in
    agy) tag=a ;;
    pi) tag=p ;;
    grok) tag=g ;;
    claude) tag=c ;;
    codex) tag=x ;;
    kimi) tag=k ;;
    dsh) tag=d ;;
    *) return 1 ;;
  esac
  [[ "$recorded" == "$tag" || "$recorded" == "$detected" ]]
}

# codex_session_exists <uuid> — a resume id is safe only when Codex has a local
# rollout for it. This turns corrupt/stale registry data into a visible skip.
codex_session_exists() {
  command python3 "$SCRIPT_DIR/../lib/codex_sessions.py" \
    "$1" "${coord_codex_home:-${CODEX_HOME:-$HOME/.codex}}"
}

codex_session_known() {
  if [[ -n "${2:-}" && "${2:-}" != "$1" ]]; then
    command python3 "$SCRIPT_DIR/../lib/codex_sessions.py" \
      --known --conflict-sid "$2" "$1" "${coord_codex_home:-${CODEX_HOME:-$HOME/.codex}}"
  else
    command python3 "$SCRIPT_DIR/../lib/codex_sessions.py" \
      --known "$1" "${coord_codex_home:-${CODEX_HOME:-$HOME/.codex}}"
  fi
}

# Claude accepts an aipane-assigned --session-id before the first real model
# turn exists. Local slash commands such as /skills can therefore leave a live
# Claude process whose id is not resumable. A real local conversation owns a
# project transcript named <session-id>.jsonl; require that durable record.
claude_session_exists() {
  local sid="$1" root="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  local -a matches
  matches=("$root"/projects/*/"$sid".jsonl(N))
  (( ${#matches[@]} > 0 ))
}

# Grok's native active-session registry can name a newly opened, unsaved session.
# Require both its metadata and replay transcript for this cwd before stopping a
# live pane. A missing current conversation must never select its old launch id.
grok_session_exists() {
  local sid="$1" cwd="$2" root="${GROK_HOME:-$HOME/.grok}"
  local -a matches
  matches=("$root"/sessions/*/"$sid"/summary.json(N))
  (( ${#matches[@]} > 0 )) || return 1
  command -v python3 &>/dev/null || return 1
  python3 - "$sid" "$cwd" "${matches[@]}" <<'PY'
import json
import os
import sys
from pathlib import Path

sid, cwd, *paths = sys.argv[1:]
expected_cwd = os.path.normcase(os.path.realpath(cwd))
for path in paths:
    try:
        summary = json.loads(Path(path).read_text(encoding="utf-8"))
        info = summary.get("info") if isinstance(summary, dict) else None
        transcript = Path(path).with_name("updates.jsonl")
        if (
            isinstance(info, dict)
            and info.get("id") == sid
            and isinstance(info.get("cwd"), str)
            and os.path.normcase(os.path.realpath(info["cwd"])) == expected_cwd
            and transcript.is_file()
            and transcript.stat().st_size > 0
        ):
            raise SystemExit(0)
    except (OSError, UnicodeError, json.JSONDecodeError):
        continue
raise SystemExit(1)
PY
}

# pi_session_resolve <uuid> <cwd> [full_cmd] — resolve a durable Pi session whose
# header identifies both the requested id and the pane's project cwd, following
# Pi 1.5.2's exact directory precedence (CLI --session-dir > PI_CODING_AGENT_SESSION_DIR
# > project <cwd>/.pi/settings.json > global $PI_CODING_AGENT_DIR/settings.json
# > default encoded-cwd dir > fallback sessions scan) with relative paths resolved
# against the target project cwd.
pi_session_resolve() {
  local sid="$1" cwd="$2" full_cmd="${3:-}"
  local agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
  local default_sessions="$agent_dir/sessions"
  local explicit_dir="${PI_CODING_AGENT_SESSION_DIR:-}"
  command -v python3 &>/dev/null || return 1
  python3 - "$sid" "$cwd" "$default_sessions" "$explicit_dir" "$agent_dir" "$full_cmd" <<'PY'
import json
import os
import re
import shlex
import sys
from pathlib import Path

sid, cwd, default_root, explicit_dir, agent_dir, full_cmd = sys.argv[1:7]
resolved_cwd = os.path.realpath(cwd)
expected_cwd = os.path.normcase(resolved_cwd)
safe_dir = "--" + re.sub(r"[/\\:]", "-", re.sub(r"^[/\\]", "", resolved_cwd)) + "--"
default_native_dir_path = Path(default_root).expanduser() / safe_dir
default_native_dir = os.path.normcase(os.path.realpath(str(default_native_dir_path)))

def _resolve_dir_for_cwd(raw: str) -> Path | None:
    s = raw.strip()
    if not s:
        return None
    p = Path(s).expanduser()
    if not p.is_absolute():
        p = Path(resolved_cwd) / p
    try:
        return p.resolve()
    except OSError:
        return p

def _read_settings_session_dir(path: Path) -> str:
    if not path.is_file():
        return ""
    try:
        obj = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(obj, dict) and isinstance(obj.get("sessionDir"), str):
            return obj["sessionDir"].strip()
    except (OSError, UnicodeError, json.JSONDecodeError):
        pass
    return ""

cli_session_dir = ""
cli_session_file = ""
if full_cmd.strip():
    try:
        tokens = shlex.split(full_cmd)
    except ValueError:
        tokens = full_cmd.split()
    for idx, tok in enumerate(tokens):
        if tok == "--session-dir" and idx + 1 < len(tokens):
            cli_session_dir = tokens[idx + 1]
        elif tok.startswith("--session-dir="):
            cli_session_dir = tok.split("=", 1)[1]
        elif tok == "--session" and idx + 1 < len(tokens):
            cli_session_file = tokens[idx + 1]
        elif tok.startswith("--session="):
            cli_session_file = tok.split("=", 1)[1]

project_session_dir = _read_settings_session_dir(Path(resolved_cwd) / ".pi" / "settings.json")
global_session_dir = _read_settings_session_dir(Path(agent_dir).expanduser() / "settings.json")

# Priority order matching real Pi 1.5.2 SessionManager resolution:
# 0. Explicit CLI --session <file> (if verified matching sid + cwd)
# 1. CLI --session-dir, 2. PI_CODING_AGENT_SESSION_DIR, 3. project settings,
# 4. global settings, 5. default encoded-cwd dir, 6. fallback sessions/ tree.
default_root_resolved = _resolve_dir_for_cwd(default_root)
raw_ordered = [
    (cli_session_dir, False),
    (explicit_dir, False),
    (project_session_dir, False),
    (global_session_dir, False),
    (str(default_native_dir_path), False),
    (default_root, True),
]
roots: list[tuple[Path, bool]] = []
seen_roots: set[Path] = set()
for raw_root, allow_deep in raw_ordered:
    rp = _resolve_dir_for_cwd(raw_root)
    if rp is not None and rp.is_dir() and rp not in seen_roots:
        seen_roots.add(rp)
        roots.append((rp, allow_deep))

def _read_pi_header(path: Path) -> dict | None:
    try:
        with path.open(encoding="utf-8") as session:
            header = json.loads(session.readline())
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    if (
        isinstance(header, dict)
        and header.get("type") == "session"
        and not ("createdAt" in header and "timestamp" not in header)
    ):
        return header
    return None

def _check(path: Path) -> str | None:
    header = _read_pi_header(path)
    if (
        header is not None
        and header.get("id") == sid
        and isinstance(header.get("cwd"), str)
        and os.path.normcase(os.path.realpath(header["cwd"])) == expected_cwd
    ):
        return os.path.realpath(str(path))
    return None

# Preserve an explicitly verified `--session <file>` from the pane's launch argv.
if cli_session_file:
    explicit_file = _resolve_dir_for_cwd(cli_session_file)
    if explicit_file is not None and explicit_file.is_file():
        matched_explicit = _check(explicit_file)
        if matched_explicit is not None:
            print(f"path\t{matched_explicit}")
            raise SystemExit(0)

def _native_dir_is_unambiguous(matched_path: str) -> bool:
    if cli_session_dir or explicit_dir or project_session_dir or global_session_dir:
        return False
    parent = os.path.normcase(os.path.dirname(matched_path))
    if parent != default_native_dir:
        return False
    same_id_count = 0
    try:
        for entry in Path(os.path.dirname(matched_path)).iterdir():
            if not entry.name.endswith(".jsonl") or not entry.is_file():
                continue
            hdr = _read_pi_header(entry)
            if hdr is not None and hdr.get("id") == sid:
                same_id_count += 1
                if same_id_count > 1:
                    return False
    except OSError:
        return False
    return same_id_count == 1

def _search_flat_dir(directory: Path) -> str | None:
    if not directory.is_dir():
        return None
    fast: list[Path] = []
    other: list[Path] = []
    try:
        for entry in directory.iterdir():
            if not entry.name.endswith(".jsonl") or not entry.is_file():
                continue
            if f"_{sid}.jsonl" in entry.name or f"_{sid}_" in entry.name:
                fast.append(entry)
            else:
                other.append(entry)
    except OSError:
        return None
    for bucket in (fast, other):
        bucket.sort(key=lambda p: (p.stat().st_mtime if p.is_file() else 0.0, p.name), reverse=True)
        for cand in bucket:
            matched = _check(cand)
            if matched is not None:
                return matched
    return None

# Search strictly root-by-root in Pi's priority order using native flat directory
# layout (direct children first, then `<root>/<encoded-cwd>` direct children), so
# nested `backup/` copies never shadow active files.
for root, allow_deep in roots:
    matched = _search_flat_dir(root)
    if matched is not None:
        mode = "native" if _native_dir_is_unambiguous(matched) else "path"
        print(f"{mode}\t{matched}")
        raise SystemExit(0)
    encoded_sub = root / safe_dir
    if encoded_sub != root and encoded_sub.is_dir():
        matched = _search_flat_dir(encoded_sub)
        if matched is not None:
            mode = "native" if _native_dir_is_unambiguous(matched) else "path"
            print(f"{mode}\t{matched}")
            raise SystemExit(0)
    if allow_deep:
        seen: set[Path] = set()
        fast_matches: list[Path] = []
        for pat in (f"*_{sid}.jsonl", f"*_{sid}_*.jsonl"):
            try:
                for cand in root.rglob(pat):
                    if cand.is_file() and cand not in seen:
                        seen.add(cand)
                        fast_matches.append(cand)
            except OSError:
                continue
        fast_matches.sort(key=lambda p: (p.stat().st_mtime if p.is_file() else 0.0, p.name), reverse=True)
        for cand in fast_matches:
            matched = _check(cand)
            if matched is not None:
                mode = "native" if _native_dir_is_unambiguous(matched) else "path"
                print(f"{mode}\t{matched}")
                raise SystemExit(0)
        try:
            other_jsonl = [c for c in root.rglob("*.jsonl") if c not in seen and c.is_file()]
        except OSError:
            other_jsonl = []
        other_jsonl.sort(key=lambda p: (p.stat().st_mtime if p.is_file() else 0.0, p.name), reverse=True)
        for cand in other_jsonl:
            matched = _check(cand)
            if matched is not None:
                mode = "native" if _native_dir_is_unambiguous(matched) else "path"
                print(f"{mode}\t{matched}")
                raise SystemExit(0)

raise SystemExit(1)
PY
}

# pi_session_id_exists <uuid> [cwd] [full_cmd] — distinguish a truly empty, never-persisted Pi
# session (safe to recreate as an empty TUI) from a durable/corrupt session that
# belongs to another cwd or has a broken header (unsafe to recreate).
pi_session_id_exists() {
  local sid="$1" cwd="${2:-$PWD}" full_cmd="${3:-}"
  local agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
  local default_sessions="$agent_dir/sessions"
  local explicit_dir="${PI_CODING_AGENT_SESSION_DIR:-}"
  command -v python3 &>/dev/null || return 1
  python3 - "$sid" "$cwd" "$default_sessions" "$explicit_dir" "$agent_dir" "$full_cmd" <<'PY'
import json
import os
import shlex
import sys
from pathlib import Path

sid, cwd, default_root, explicit_dir, agent_dir, full_cmd = sys.argv[1:7]
resolved_cwd = os.path.realpath(cwd) if cwd else os.getcwd()

def _resolve_dir_for_cwd(raw: str) -> Path | None:
    s = raw.strip()
    if not s:
        return None
    p = Path(s).expanduser()
    if not p.is_absolute():
        p = Path(resolved_cwd) / p
    try:
        return p.resolve()
    except OSError:
        return p

def _read_settings_session_dir(path: Path) -> str:
    if not path.is_file():
        return ""
    try:
        obj = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(obj, dict) and isinstance(obj.get("sessionDir"), str):
            return obj["sessionDir"].strip()
    except (OSError, UnicodeError, json.JSONDecodeError):
        pass
    return ""

cli_session_dir = ""
if full_cmd.strip():
    try:
        tokens = shlex.split(full_cmd)
    except ValueError:
        tokens = full_cmd.split()
    for idx, tok in enumerate(tokens):
        if tok == "--session-dir" and idx + 1 < len(tokens):
            cli_session_dir = tokens[idx + 1]
        elif tok.startswith("--session-dir="):
            cli_session_dir = tok.split("=", 1)[1]

project_session_dir = _read_settings_session_dir(Path(resolved_cwd) / ".pi" / "settings.json")
global_session_dir = _read_settings_session_dir(Path(agent_dir).expanduser() / "settings.json")

roots: list[Path] = []
for raw_root in (cli_session_dir, explicit_dir, project_session_dir, global_session_dir, default_root):
    rp = _resolve_dir_for_cwd(raw_root)
    if rp is not None and rp.is_dir() and rp not in roots:
        roots.append(rp)

seen: set[Path] = set()
for root in roots:
    for pat in (f"*_{sid}.jsonl", f"*_{sid}_*.jsonl"):
        try:
            cands = list(root.rglob(pat))
        except OSError:
            continue
        for cand in cands:
            if not cand.is_file() or cand in seen:
                continue
            seen.add(cand)
            try:
                with cand.open(encoding="utf-8") as session:
                    header = json.loads(session.readline())
            except (OSError, UnicodeError, json.JSONDecodeError):
                raise SystemExit(0)
            if isinstance(header, dict) and header.get("type") == "session":
                if "createdAt" in header and "timestamp" not in header:
                    continue
                hdr_id = header.get("id")
                if isinstance(hdr_id, str) and hdr_id and hdr_id != sid:
                    continue
            raise SystemExit(0)

for root in roots:
    try:
        all_jsonl = root.rglob("*.jsonl")
    except OSError:
        continue
    for cand in all_jsonl:
        if cand in seen or not cand.is_file():
            continue
        seen.add(cand)
        try:
            with cand.open(encoding="utf-8") as session:
                header = json.loads(session.readline())
        except (OSError, UnicodeError, json.JSONDecodeError):
            continue
        if (
            isinstance(header, dict)
            and header.get("type") == "session"
            and not ("createdAt" in header and "timestamp" not in header)
            and header.get("id") == sid
        ):
            raise SystemExit(0)

raise SystemExit(1)
PY
}

# build_resume <tool> <full_cmd> <title> <coord_sid> <cwd>
# -> REPLY = command to send, or ""
# Gold-case tools begin with their session id in argv. Tools can change sessions:
# an in-process resume/fork changes the current session without changing the launch
# argv, so a durable current coordinate binding must supersede that stale id.
# Kimi session IDs come from the coordinate snapshot.
# Sets REPLY_KIND = resume|fresh|invalid for logging.
build_resume() {
  local tool="$1" full="$2" title="$3" coord_sid="$4" cwd="$5" id
  REPLY=""; REPLY_KIND=""; REPLY_SID=""
  extract_uuid "$full"; id="$REPLY"
  if [[ "$tool" == codex && -n "$coord_sid" ]] && { codex_session_exists "$coord_sid" || codex_session_known "$coord_sid" "$id"; }; then
    id="$coord_sid"
  elif [[ ( "$tool" == pi || "$tool" == grok || "$tool" == dsh ) && -n "$coord_sid" ]]; then
    # The current coordinate binding is authoritative even when that new session
    # is still empty. Check durability below without falling back to stale argv.
    id="$coord_sid"
  elif [[ -z "$id" && -n "$coord_sid" ]]; then
    id="$coord_sid"
  fi
  case "$tool" in
    agy)
      # Only this pane's selected-session snapshot is authoritative. The CLI's
      # --continue cache is shared by all panes in the same workspace.
      id="$coord_sid"
      if [[ -n "$id" ]]; then
        if REPLY="$(command python3 "$SCRIPT_DIR/../lib/agy_sessions.py" resume "$id" "$cwd" "$coord_agy" "$AGY_BASE")"; then
          local agy_route=""
          agy_route="$(command python3 -c 'import json,sys; d=json.loads(sys.argv[1] or "{}"); r=d.get("agy_route",""); print(r if r in {"plan","gcp"} else "")' "$coord_agy" 2>/dev/null || true)"
          if [[ -n "$agy_route" ]]; then
            REPLY="AIPANE_AUTO_RESUME=1 AIPANE_AGY_ROUTE=$agy_route $REPLY"
          else
            REPLY="AIPANE_AUTO_RESUME=1 $REPLY"
          fi
          REPLY_KIND=resume
        else
          REPLY="$AGY_BASE"; REPLY_KIND=invalid
        fi
      else
        REPLY="$AGY_BASE"; REPLY_KIND=invalid
      fi ;;
    dsh)
      # dsh ids are opaque, not necessarily UUIDs. Only exact --resume ids or
      # the selected TUI session snapshot are admissible; never use global MRU.
      id="$coord_sid"
      if [[ -z "$id" && ( "$coord_tool" == d || "$coord_tool" == dsh ) ]]; then
        REPLY="$DSH_BASE"; REPLY_KIND=invalid
        return 0
      fi
      if [[ -z "$id" ]]; then
        local -a argv=("${(@Q)${(z)full}}")
        local -i argi
        for (( argi=1; argi <= ${#argv}; argi++ )); do
          if [[ "${argv[$argi]}" == --resume=* ]]; then
            id="${argv[$argi]#--resume=}"; break
          elif [[ "${argv[$argi]}" == --resume && $argi -lt ${#argv} && "${argv[$((argi+1))]}" != -* ]]; then
            id="${argv[$((argi+1))]}"; break
          fi
        done
      fi
      if [[ -n "$id" ]]; then
        REPLY="$DSH_BASE --resume ${(q)id}"
        if DSH_HOME="${coord_dsh_home:-${DSH_HOME:-$HOME/.dsh}}" DSH_TUI_SESSION_ROOT="${coord_session_root:-${DSH_TUI_SESSION_ROOT:-}}" "$SCRIPT_DIR/aipane-dsh-session" "$id" "$cwd"; then REPLY_KIND=resume
        else REPLY_KIND=invalid; fi
      else REPLY="$DSH_BASE"; REPLY_KIND=fresh; fi ;;
    pi)
      if [[ -n "$id" ]]; then
        local pi_resolved="" pi_mode="" pi_path=""
        if pi_resolved="$(pi_session_resolve "$id" "$cwd" "$full")"; then
          pi_mode="${pi_resolved%%$'\t'*}"
          pi_path="${pi_resolved#*$'\t'}"
          if [[ "$pi_mode" == path && -n "$pi_path" ]]; then
            REPLY="$PI_BASE --session ${(q)pi_path}"
          else
            REPLY="$PI_BASE --session-id $id"
          fi
          REPLY_KIND=resume
        elif pi_session_id_exists "$id" "$cwd" "$full"; then
          REPLY="$PI_BASE --session-id $id"
          REPLY_KIND=invalid
        else
          REPLY="$PI_BASE --session-id $id"
          REPLY_KIND=recreated
        fi
      else REPLY="$PI_BASE"; REPLY_KIND=fresh; fi ;;
    grok)
      if [[ -n "$id" ]]; then
        REPLY="$GROK_BASE --resume $id"
        if grok_session_exists "$id" "$cwd"; then REPLY_KIND=resume
        else REPLY_KIND=invalid; fi
      else REPLY="$GROK_BASE"; REPLY_KIND=fresh; fi ;;
    claude)
      if [[ -n "$id" ]]; then
        REPLY="AIPANE_AUTO_RESUME=1 $CLAUDE_BASE --resume $id"
        if claude_session_exists "$id"; then REPLY_KIND=resume
        else REPLY_KIND=invalid; fi
      else REPLY="$CLAUDE_BASE"; REPLY_KIND=fresh; fi ;;
    codex)
      # codex id is not in argv on a bare launch, but its pane title is usually the
      # session uuid — use that as a fallback.
      if [[ -z "$id" ]]; then extract_uuid "$title"; id="$REPLY"; fi
      if [[ -n "$id" ]]; then
        REPLY="$CODEX_RESTORE_BASE resume $id"
        if codex_session_exists "$id"; then REPLY_KIND=resume
        else REPLY_KIND=invalid; fi
      else REPLY="$CODEX_RESTORE_BASE"; REPLY_KIND=fresh; fi ;;
    kimi)
      # id from the coords-snapshot (recorded by the kimi SessionStart hook). Without
      # it, kimi --continue reliably resumes the last session FOR THIS CWD (the pane's
      # cwd is already restored), so that is still a genuine resume rather than fresh.
      if [[ -n "$id" ]]; then REPLY="$KIMI_BASE --session $id"; REPLY_KIND=resume
      else REPLY="$KIMI_BASE --continue"; REPLY_KIND=resume; fi ;;
  esac
  [[ -n "$id" ]] && REPLY_SID="$id"
  if [[ "$tool" == dsh ]]; then
    [[ -n "$coord_session_root" ]] && REPLY="DSH_TUI_SESSION_ROOT=${(q)coord_session_root} $REPLY"
    [[ -n "$coord_dsh_home" ]] && REPLY="DSH_HOME=${(q)coord_dsh_home} $REPLY"
  elif [[ "$tool" == codex && -n "$coord_codex_home" ]]; then
    REPLY="CODEX_HOME=${(q)coord_codex_home} $REPLY"
  fi
}

# emit_plan_json <target> <tool> <kind> <restorable 0|1> <cwd> <command> <sid>
# JSON Lines keeps the recovery plan machine-readable without exposing the
# implementation of dump parsing to callers such as ai-restart.
emit_plan_json() {
  AIPANE_PLAN_TARGET="$1" \
  AIPANE_PLAN_TOOL="$2" \
  AIPANE_PLAN_KIND="$3" \
  AIPANE_PLAN_RESTORABLE="$4" \
  AIPANE_PLAN_CWD="$5" \
  AIPANE_PLAN_COMMAND="$6" \
  AIPANE_PLAN_SID="$7" \
  AIPANE_PLAN_DSH_HOME="${coord_dsh_home:-}" \
  AIPANE_PLAN_SESSION_ROOT="${coord_session_root:-}" \
  AIPANE_PLAN_CODEX_HOME="${coord_codex_home:-${CODEX_HOME:-$HOME/.codex}}" \
  AIPANE_PLAN_AGY="$coord_agy" \
    command python3 -c '
import json, os
print(json.dumps({
    "target": os.environ["AIPANE_PLAN_TARGET"],
    "tool": os.environ["AIPANE_PLAN_TOOL"],
    "kind": os.environ["AIPANE_PLAN_KIND"],
    "restorable": os.environ["AIPANE_PLAN_RESTORABLE"] == "1",
    "cwd": os.environ["AIPANE_PLAN_CWD"],
    "command": os.environ["AIPANE_PLAN_COMMAND"],
    "sid": os.environ["AIPANE_PLAN_SID"],
    **(json.loads(os.environ["AIPANE_PLAN_AGY"]) if os.environ["AIPANE_PLAN_TOOL"] == "agy" else {}),
    **({"codex_home": os.environ["AIPANE_PLAN_CODEX_HOME"]} if os.environ["AIPANE_PLAN_TOOL"] == "codex" else {}),
    **({"dsh_home": os.environ["AIPANE_PLAN_DSH_HOME"], "session_root": os.environ["AIPANE_PLAN_SESSION_ROOT"]}
       if os.environ["AIPANE_PLAN_TOOL"] == "dsh" else {}),
}, ensure_ascii=False, separators=(",", ":")))
'
}

# ---- walk the dump -------------------------------------------------------
typeset -i n_ai=0 n_skip=0
log "=== ai-restore start (dump=$DUMP dryrun=$DRYRUN) ==="

local line
local -a f
local session win pane_idx title cwd cur full tool cmd target coord_sid coord_tool resume_sid coord_dsh_home coord_session_root
while IFS= read -r line; do
  [[ "$line" == pane$'\t'* ]] || continue
  f=("${(@ps:\t:)line}")
  (( ${#f[@]} >= 11 )) || continue
  session="${f[2]}"; win="${f[3]}"; pane_idx="${f[6]}"; title="${f[7]}"
  cwd="${f[8]#:}"; cur="${f[10]}"
  full="${(j:\t:)f[11,-1]}"; full="${full#:}"

  detect_tool "$full" "$cur"; tool="$REPLY"
  [[ -n "$tool" ]] || continue
  (( n_ai++ ))

  target="${session}:${win}.${pane_idx}"

  coord_sid="${COORDS_SID[$target]:-}"
  coord_codex_home="${COORDS_CODEX_HOME[$target]:-}"
  coord_tool="${COORDS_TOOL[$target]:-}"
  coord_dsh_home="${COORDS_DSH_HOME[$target]:-}"
  coord_session_root="${COORDS_SESSION_ROOT[$target]:-}"
  coord_agy="${COORDS_AGY[$target]:-}"
  [[ -n "$coord_agy" ]] || coord_agy='{}'
  if [[ -n "$coord_sid" ]] && ! coord_tool_matches "$tool" "$coord_tool"; then
    log "ignore $target snapshot id: detected=$tool recorded=${coord_tool:-missing}"
    coord_sid=""
    coord_dsh_home=""; coord_session_root=""
  fi
  if [[ ( "$tool" == dsh || "$tool" == agy ) && -n "$coord_sid" && -n "${COORDS_CWD[$target]:-}" ]]; then
    cwd="${COORDS_CWD[$target]}"
  fi

  build_resume "$tool" "$full" "$title" "$coord_sid" "$cwd"; cmd="$REPLY"; resume_sid="$REPLY_SID"
  [[ -n "$cmd" ]] || { (( n_skip++ )); continue; }

  # Invalid ids are always skipped. Fresh panes are skipped unless opted in.
  # `recreated` is intentionally runnable: it reopens an empty Pi TUI without
  # claiming that a durable conversation was resumed.
  local skip_fresh=0 skip_invalid=0 restorable=1
  if [[ "$REPLY_KIND" == fresh && "$RESTORE_FRESH" != 1 ]]; then
    skip_fresh=1; restorable=0
  elif [[ "$REPLY_KIND" == invalid ]]; then
    skip_invalid=1; restorable=0
  fi

  emit_plan_json \
    "$target" "$tool" "$REPLY_KIND" "$restorable" "$cwd" "$cmd" "$resume_sid" \
    >>"$PLAN_FILE" || exit 1
  (( skip_fresh || skip_invalid )) && (( n_skip++ ))
done < "$DUMP"

typeset -a executor_args
executor_args=(--plan "$PLAN_FILE" --dump "$DUMP")
(( PLAN_JSON )) && executor_args+=(--plan-json)
(( DRYRUN && ! PLAN_JSON )) && executor_args+=(--dry-run)

AI_RESTORE_LAUNCH_DELAY="$DELAY" \
AIPANE_RESTORE_LOG="$LOG" \
  "$EXECUTOR" "${executor_args[@]}"
typeset executor_status=$?
log "=== ai-restore done: ai_panes=$n_ai skipped=$n_skip executor_status=$executor_status ==="
return "$executor_status" 2>/dev/null || exit "$executor_status"
