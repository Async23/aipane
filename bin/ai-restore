#!/usr/bin/env zsh
# ai-restore — after tmux-resurrect restores the window/pane structure, resume the
# AI CLI session that each pane was running.
#
# How it works (see ../docs/session-restore-design.md in this repository):
#   - tmux-resurrect saves the FULL command line of every pane's foreground program.
#   - aipane's gold-case launch puts the session id straight into that command line
#     (pi/grok/claude via --session-id, cursor via a pre-created chat id), and any
#     `resume`-style launch already carries its id too.
#   - For tools whose active session still matches their launch argv, the resurrect
#     dump contains the id directly. Pi/Codex can replace sessions in-process, so
#     their current coordinate binding takes precedence over stale launch argv.
#   - We parse that durable identity into a declarative plan. The adjacent
#     aipane-restore-executor persists unfinished intent, launches cleanly,
#     verifies readiness, retries transient failures, and only then rebinds.
#
# Trigger: @resurrect-hook-post-restore-all 'ai-restore'  (runs after restore settles).
# Manual : ai-restore            (act) | ai-restore --dry-run (print plan only)
# Machine: ai-restore --plan-json (JSON Lines recovery plan; no panes touched)
#
# Safety: a pane is launched only from an idle shell. An already-running matching
# Agent is verified without replacement; any different foreground program is left
# untouched and the recovery intent stays pending for a later retry.

emulate -L zsh
setopt no_nomatch pipefail

export PATH="/opt/homebrew/bin:$HOME/.local/bin:$HOME/.grok/bin:$HOME/.kimi-code/bin:$PATH"

typeset -a TMUX_CMD
TMUX_CMD=("${(@z)${AIPANE_TMUX:-tmux}}")
run_tmux() { command "${TMUX_CMD[@]}" "$@"; }

# ---- options -------------------------------------------------------------
typeset DRYRUN=0 PLAN_JSON=0 DUMP="" DELAY="${AI_RESTORE_SETTLE_DELAY:-0.4}"
while (( $# > 0 )); do
  case "$1" in
    --dry-run|-n) DRYRUN=1 ;;
    --plan-json) DRYRUN=1; PLAN_JSON=1 ;;
    --dump) shift; DUMP="$1" ;;
    --delay) shift; DELAY="$1" ;;
    -h|--help)
      print "usage: ai-restore [--dry-run|--plan-json] [--dump FILE] [--delay SECS]"
      return 0 2>/dev/null || exit 0 ;;
    *) DUMP="$1" ;;
  esac
  shift
done

typeset STATE_DIR="${AIPANE_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aipane}"
typeset LOG="$STATE_DIR/ai-restore.log"
typeset COORDS="$STATE_DIR/coords-last.json"
typeset PI_SESSION_ROOT="${PI_CODING_AGENT_SESSION_DIR:-${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/sessions}"
mkdir -p "$STATE_DIR" 2>/dev/null

typeset SCRIPT_DIR="${${(%):-%x}:A:h}"
typeset EXECUTOR="${AIPANE_RESTORE_EXECUTOR:-$SCRIPT_DIR/aipane-restore-executor}"
if [[ ! -x "$EXECUTOR" ]]; then
  print -u2 "ai-restore: recovery executor not found at $EXECUTOR"
  return 1 2>/dev/null || exit 1
fi
typeset PLAN_FILE
PLAN_FILE="$(mktemp "$STATE_DIR/ai-restore-plan.XXXXXX")" || {
  print -u2 "ai-restore: could not create recovery plan"
  return 1 2>/dev/null || exit 1
}
cleanup_plan() { command rm -f -- "$PLAN_FILE" 2>/dev/null; }
trap cleanup_plan EXIT

log() { print -r -- "$(date '+%F %T') $*" >>"$LOG" 2>/dev/null; }

# Coordinate -> current session id/tool map produced by aipane-snapshot at save
# time. The tool tag is part of the identity: a stale binding from another tool
# must never be interpreted as the detected pane's session id.
typeset -A COORDS_SID COORDS_TOOL
if [[ -r "$COORDS" ]] && command -v python3 &>/dev/null; then
  local _cl
  while IFS=$'\t' read -r _cl _sid _tool; do
    if [[ -n "$_cl" ]]; then
      COORDS_SID[$_cl]="$_sid"
      COORDS_TOOL[$_cl]="$_tool"
    fi
  done < <(python3 -c '
import json,sys
try:
    d=json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for coord,rec in d.items():
    sid=(rec or {}).get("sid","")
    tool=(rec or {}).get("tool","")
    if sid: print(f"{coord}\t{sid}\t{tool}")
' "$COORDS" 2>/dev/null)
fi

# ---- resolve the dump ----------------------------------------------------
if [[ -z "$DUMP" ]]; then
  local dir
  dir="$(run_tmux show-option -gqv @resurrect-dir 2>/dev/null)"
  [[ -n "$dir" ]] || dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
  DUMP="$dir/last"
fi
if [[ ! -e "$DUMP" ]]; then
  log "no resurrect dump at $DUMP"
  print -u2 "ai-restore: no resurrect dump at $DUMP"
  return 1 2>/dev/null || exit 1
fi

# lowercase-hex UUID matcher (matches both v4 and codex/grok's uuidv7)
typeset UUID_RE='[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'

# Only auto-run panes whose exact session id is recoverable ("resume"). Panes with
# no recoverable id ("fresh") are left as an idle shell by default — re-launching a
# brand-new AI there has no recovery value and costs tokens. Set AI_RESTORE_FRESH=1
# to also re-launch fresh panes.
typeset RESTORE_FRESH="${AI_RESTORE_FRESH:-0}"

# Base launch commands used to rebuild a resume line. Honor direct command overrides
# when they are present; otherwise use plain binaries from a bare hook environment.
typeset PI_BASE="${AIPANE_PI_LAUNCH_CMD:-pi}"
typeset GROK_BASE="${AIPANE_GROK_LAUNCH_CMD:-grok --always-approve}"
typeset CLAUDE_BASE="${AIPANE_CLAUDE_LAUNCH_CMD:-claude --dangerously-skip-permissions}"
typeset CURSOR_BASE="${AIPANE_CURSOR_LAUNCH_CMD:-cursor-agent --force}"
typeset CODEX_BASE="${AIPANE_CODEX_LAUNCH_CMD:-codex --yolo}"
typeset OPENCODE_BASE="${AIPANE_OPENCODE_LAUNCH_CMD:-opencode}"
typeset KIMI_BASE="${AIPANE_KIMI_LAUNCH_CMD:-kimi --yolo}"

# Migrate exact retired local overrides that can survive in an already-running
# Ghostty shell or a restored tmux global environment.
[[ "$CLAUDE_BASE" == "claude-guard --dangerously-skip-permissions" ]] &&
  CLAUDE_BASE="claude --dangerously-skip-permissions"
[[ "$CODEX_BASE" == "codexx" ]] &&
  CODEX_BASE="codex --yolo --disable plugins"

# detect_tool <full_cmd> <cur_cmd> -> REPLY in {pi,grok,claude,cursor,codex,opencode,kimi} or ""
detect_tool() {
  local full="$1" cur="$2" prog
  REPLY=""
  # cursor-agent runs under node with a versioned path; match by substring.
  if [[ "$full" == *cursor-agent* ]]; then REPLY=cursor; return; fi
  prog="${full%% *}"; prog="${prog:t}"      # basename of argv[0]
  case "$prog" in
    pi)                REPLY=pi ;;
    grok|grok-*)       REPLY=grok ;;
    # Compatibility: recognize commands captured in pre-removal resurrect dumps.
    claude|claude-guard) REPLY=claude ;;
    codex|codexx|codex-*) REPLY=codex ;;
    opencode|opencode-*) REPLY=opencode ;;   # Mach-O binary, argv0 = opencode
    kimi|kimi-*)         REPLY=kimi ;;        # Mach-O SEA, argv0 = kimi
    node|"")
      # node wrapper without cursor-agent: fall back to the (truncated) current command
      case "$cur" in
        grok-*)  REPLY=grok ;;
        codex-*) REPLY=codex ;;
        pi|pi-*) REPLY=pi ;;
      esac ;;
    *)
      case "$cur" in
        grok-*)     REPLY=grok ;;
        codex-*)    REPLY=codex ;;
        opencode)   REPLY=opencode ;;
        kimi)       REPLY=kimi ;;
      esac ;;
  esac
}

# extract_uuid <string> -> REPLY (first uuid-shaped token) or ""
extract_uuid() {
  REPLY=""
  if [[ "$1" =~ "$UUID_RE" ]]; then REPLY="${MATCH:l}"; fi
}

# coord_tool_matches <detected tool name> <snapshot tool tag>
coord_tool_matches() {
  local detected="$1" recorded="$2" tag
  case "$detected" in
    pi) tag=p ;;
    grok) tag=g ;;
    claude) tag=c ;;
    cursor) tag=r ;;
    codex) tag=x ;;
    opencode) tag=o ;;
    kimi) tag=k ;;
    *) return 1 ;;
  esac
  [[ "$recorded" == "$tag" || "$recorded" == "$detected" ]]
}

# codex_session_exists <uuid> — a resume id is safe only when Codex has a local
# rollout for it. This turns corrupt/stale registry data into a visible skip.
codex_session_exists() {
  local sid="$1" root="${CODEX_HOME:-$HOME/.codex}"
  local -a matches
  matches=(
    "$root"/sessions/**/*-"$sid".jsonl(N)
    "$root"/archived_sessions/**/*-"$sid".jsonl(N)
  )
  (( ${#matches[@]} > 0 ))
}

# Claude accepts an aipane-assigned --session-id before the first real model
# turn exists. Local slash commands such as /skills can therefore leave a live
# Claude process whose id is not resumable. A real local conversation owns a
# project transcript named <session-id>.jsonl; require that durable record.
claude_session_exists() {
  local sid="$1" root="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  local -a matches
  matches=("$root"/projects/*/"$sid".jsonl(N))
  (( ${#matches[@]} > 0 ))
}

# pi_session_exists <uuid> <cwd> — `pi --session-id` creates a new session when
# the id is absent. Treating any UUID as resumable therefore turns stale bindings
# into convincing empty sessions. Require a durable JSONL whose header identifies
# both the requested id and the pane's project cwd.
pi_session_exists() {
  local sid="$1" cwd="$2"
  local -a matches
  matches=("$PI_SESSION_ROOT"/**/*_"$sid".jsonl(N))
  (( ${#matches[@]} > 0 )) || return 1
  command -v python3 &>/dev/null || return 1
  python3 - "$sid" "$cwd" "${matches[@]}" <<'PY'
import json
import os
import sys

sid, cwd, *paths = sys.argv[1:]
expected_cwd = os.path.normcase(os.path.realpath(cwd))
for path in paths:
    try:
        with open(path, encoding="utf-8") as session:
            header = json.loads(session.readline())
    except (OSError, UnicodeError, json.JSONDecodeError):
        continue
    if (
        isinstance(header, dict)
        and header.get("type") == "session"
        and header.get("id") == sid
        and isinstance(header.get("cwd"), str)
        and os.path.normcase(os.path.realpath(header["cwd"])) == expected_cwd
    ):
        raise SystemExit(0)
raise SystemExit(1)
PY
}

# pi_session_id_exists <uuid> — distinguish a truly empty, never-persisted Pi
# session (safe to recreate as an empty TUI) from a durable/corrupt session that
# belongs to another cwd (unsafe to reinterpret as a new session here).
pi_session_id_exists() {
  local sid="$1"
  local -a matches
  matches=("$PI_SESSION_ROOT"/**/*_"$sid".jsonl(N))
  (( ${#matches[@]} > 0 ))
}

# build_resume <tool> <full_cmd> <title> <coord_sid> <cwd>
# -> REPLY = command to send, or ""
# Gold-case tools begin with their session id in argv. Codex and Pi are different:
# an in-process resume/fork changes the current session without changing the launch
# argv, so a durable current coordinate binding must supersede that stale id.
# opencode/kimi ids are not UUIDs and only come from the coordinate snapshot.
# Sets REPLY_KIND = resume|fresh|invalid for logging.
build_resume() {
  local tool="$1" full="$2" title="$3" coord_sid="$4" cwd="$5" id
  REPLY=""; REPLY_KIND=""; REPLY_SID=""
  extract_uuid "$full"; id="$REPLY"
  if [[ "$tool" == codex && -n "$coord_sid" ]] && codex_session_exists "$coord_sid"; then
    id="$coord_sid"
  elif [[ "$tool" == pi && -n "$coord_sid" ]]; then
    # Pi can replace its session in-process. The current coordinate binding is
    # authoritative even when that new session is still empty and has no JSONL.
    id="$coord_sid"
  elif [[ -z "$id" && -n "$coord_sid" ]]; then
    id="$coord_sid"
  fi
  case "$tool" in
    pi)
      if [[ -n "$id" ]]; then
        REPLY="$PI_BASE --session-id $id"
        if pi_session_exists "$id" "$cwd"; then REPLY_KIND=resume
        elif pi_session_id_exists "$id"; then REPLY_KIND=invalid
        else REPLY_KIND=recreated; fi
      else REPLY="$PI_BASE"; REPLY_KIND=fresh; fi ;;
    cursor)
      if [[ -n "$id" ]]; then REPLY="$CURSOR_BASE --resume $id"; REPLY_KIND=resume
      else REPLY="$CURSOR_BASE"; REPLY_KIND=fresh; fi ;;
    grok)
      if [[ -n "$id" ]]; then REPLY="$GROK_BASE --resume $id"; REPLY_KIND=resume
      else REPLY="$GROK_BASE"; REPLY_KIND=fresh; fi ;;
    claude)
      if [[ -n "$id" ]]; then
        REPLY="$CLAUDE_BASE --resume $id"
        if claude_session_exists "$id"; then REPLY_KIND=resume
        else REPLY_KIND=invalid; fi
      else REPLY="$CLAUDE_BASE"; REPLY_KIND=fresh; fi ;;
    codex)
      # codex id is not in argv on a bare launch, but its pane title is usually the
      # session uuid — use that as a fallback.
      if [[ -z "$id" ]]; then extract_uuid "$title"; id="$REPLY"; fi
      if [[ -n "$id" ]]; then
        REPLY="$CODEX_BASE resume $id"
        if codex_session_exists "$id"; then REPLY_KIND=resume
        else REPLY_KIND=invalid; fi
      else REPLY="$CODEX_BASE"; REPLY_KIND=fresh; fi ;;
    opencode)
      # id (ses_...) comes only from the coords-snapshot (recorded by the opencode
      # plugin on the first message). opencode --continue is global "last session",
      # too ambiguous across panes to trust, so with no id we fall back to fresh.
      if [[ -n "$id" ]]; then REPLY="$OPENCODE_BASE --session $id"; REPLY_KIND=resume
      else REPLY="$OPENCODE_BASE"; REPLY_KIND=fresh; fi ;;
    kimi)
      # id from the coords-snapshot (recorded by the kimi SessionStart hook). Without
      # it, kimi --continue reliably resumes the last session FOR THIS CWD (the pane's
      # cwd is already restored), so that is still a genuine resume rather than fresh.
      if [[ -n "$id" ]]; then REPLY="$KIMI_BASE --session $id"; REPLY_KIND=resume
      else REPLY="$KIMI_BASE --continue"; REPLY_KIND=resume; fi ;;
  esac
  [[ -n "$id" ]] && REPLY_SID="$id"
}

# emit_plan_json <target> <tool> <kind> <restorable 0|1> <cwd> <command> <sid>
# JSON Lines keeps the recovery plan machine-readable without exposing the
# implementation of dump parsing to callers such as ai-restart.
emit_plan_json() {
  AIPANE_PLAN_TARGET="$1" \
  AIPANE_PLAN_TOOL="$2" \
  AIPANE_PLAN_KIND="$3" \
  AIPANE_PLAN_RESTORABLE="$4" \
  AIPANE_PLAN_CWD="$5" \
  AIPANE_PLAN_COMMAND="$6" \
  AIPANE_PLAN_SID="$7" \
    command python3 -c '
import json, os
print(json.dumps({
    "target": os.environ["AIPANE_PLAN_TARGET"],
    "tool": os.environ["AIPANE_PLAN_TOOL"],
    "kind": os.environ["AIPANE_PLAN_KIND"],
    "restorable": os.environ["AIPANE_PLAN_RESTORABLE"] == "1",
    "cwd": os.environ["AIPANE_PLAN_CWD"],
    "command": os.environ["AIPANE_PLAN_COMMAND"],
    "sid": os.environ["AIPANE_PLAN_SID"],
}, ensure_ascii=False, separators=(",", ":")))
'
}

# ---- walk the dump -------------------------------------------------------
typeset -i n_ai=0 n_skip=0
log "=== ai-restore start (dump=$DUMP dryrun=$DRYRUN) ==="

local line
local -a f
local session win pane_idx title cwd cur full tool cmd target coord_sid coord_tool resume_sid
while IFS= read -r line; do
  [[ "$line" == pane$'\t'* ]] || continue
  f=("${(@ps:\t:)line}")
  (( ${#f[@]} >= 11 )) || continue
  session="${f[2]}"; win="${f[3]}"; pane_idx="${f[6]}"; title="${f[7]}"
  cwd="${f[8]#:}"; cur="${f[10]}"
  full="${(j:\t:)f[11,-1]}"; full="${full#:}"

  detect_tool "$full" "$cur"; tool="$REPLY"
  [[ -n "$tool" ]] || continue
  (( n_ai++ ))

  target="${session}:${win}.${pane_idx}"

  coord_sid="${COORDS_SID[$target]:-}"
  coord_tool="${COORDS_TOOL[$target]:-}"
  if [[ -n "$coord_sid" ]] && ! coord_tool_matches "$tool" "$coord_tool"; then
    log "ignore $target snapshot id: detected=$tool recorded=${coord_tool:-missing}"
    coord_sid=""
  fi

  build_resume "$tool" "$full" "$title" "$coord_sid" "$cwd"; cmd="$REPLY"; resume_sid="$REPLY_SID"
  [[ -n "$cmd" ]] || { (( n_skip++ )); continue; }

  # Invalid ids are always skipped. Fresh panes are skipped unless opted in.
  # `recreated` is intentionally runnable: it reopens an empty Pi TUI without
  # claiming that a durable conversation was resumed.
  local skip_fresh=0 skip_invalid=0 restorable=1
  if [[ "$REPLY_KIND" == fresh && "$RESTORE_FRESH" != 1 ]]; then
    skip_fresh=1; restorable=0
  elif [[ "$REPLY_KIND" == invalid ]]; then
    skip_invalid=1; restorable=0
  fi

  emit_plan_json \
    "$target" "$tool" "$REPLY_KIND" "$restorable" "$cwd" "$cmd" "$resume_sid" \
    >>"$PLAN_FILE"
  (( skip_fresh || skip_invalid )) && (( n_skip++ ))
done < "$DUMP"

typeset -a executor_args
executor_args=(--plan "$PLAN_FILE" --dump "$DUMP")
(( PLAN_JSON )) && executor_args+=(--plan-json)
(( DRYRUN && ! PLAN_JSON )) && executor_args+=(--dry-run)

AI_RESTORE_LAUNCH_DELAY="$DELAY" \
AIPANE_RESTORE_LOG="$LOG" \
  "$EXECUTOR" "${executor_args[@]}"
typeset executor_status=$?
log "=== ai-restore done: ai_panes=$n_ai skipped=$n_skip executor_status=$executor_status ==="
return "$executor_status" 2>/dev/null || exit "$executor_status"
