#!/usr/bin/env python3
"""Command-line entry point for the shared recovery engine."""
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from recovery import main, RestoreExecutionError
from recovery_plan import RecoveryPlanError

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RecoveryPlanError, RestoreExecutionError, OSError, subprocess.SubprocessError) as error:
        print(f"aipane-restore-executor: {error}", file=sys.stderr)
        raise SystemExit(2)
