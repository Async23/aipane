#!/usr/bin/env python3
"""Read-only installation audit for aipane's Agent Activity wiring."""

from __future__ import annotations

import argparse
import json
import os
import plistlib
import re
import shutil
import subprocess
from pathlib import Path


CORE_ENTRYPOINTS = (
    "aipane-doctor",
    "aipane-activity",
    "tmux-window-wrap",
)
LOCAL_BIN_ENTRYPOINT = re.compile(r"\.local/bin/(aipane-[a-z0-9-]+)")
CONFIG_PATHS = (
    ".codex/hooks.json",
    ".codex/config.toml",
    ".claude/settings.json",
    ".cursor/hooks.json",
    ".kimi-code/config.toml",
    ".qoder/settings.json",
    ".config/opencode/plugins/aipane-bind.js",
)
KNOWN_REGISTRATION_LINKS = (
    (
        ".grok/hooks/aipane-activity.json",
        "integrations/grok/hooks.json",
    ),
    (
        ".config/opencode/plugins/aipane-bind.js",
        "integrations/opencode/aipane-bind.js",
    ),
)
DSH_PROFILE_AUDITOR = Path(__file__).resolve().parents[1] / "lib/dsh_profile_audit.mjs"


class Audit:
    def __init__(self) -> None:
        self.errors = 0
        self.warnings = 0

    @staticmethod
    def ok(message: str) -> None:
        print(f"OK   {message}")

    def warn(self, message: str) -> None:
        self.warnings += 1
        print(f"WARN {message}")

    def fail(self, message: str) -> None:
        self.errors += 1
        print(f"FAIL {message}")


def display_path(path: Path, home: Path) -> str:
    try:
        return f"~/{path.relative_to(home)}"
    except ValueError:
        return str(path)


def is_present(path: Path) -> bool:
    return os.path.lexists(path)


def check_entrypoint(
    audit: Audit,
    root: Path,
    home: Path,
    name: str,
) -> None:
    source = root / "bin" / name
    destination = home / ".local" / "bin" / name
    shown = display_path(destination, home)
    if not source.is_file():
        audit.fail(f"{source}: source executable is missing")
        return
    if not os.access(source, os.X_OK):
        audit.fail(f"{source}: source is not executable")
        return
    if not is_present(destination):
        audit.fail(f"{shown}: missing (expected symlink -> {source})")
        return
    if not destination.is_symlink():
        audit.fail(f"{shown}: not a symlink to this checkout")
        return
    try:
        actual = destination.resolve(strict=True)
        expected = source.resolve(strict=True)
    except OSError as error:
        audit.fail(f"{shown}: broken symlink ({error})")
        return
    if actual != expected:
        audit.fail(
            f"{shown}: does not point to this checkout "
            f"(actual {actual}, expected {expected})"
        )
        return
    if not os.access(destination, os.X_OK):
        audit.fail(f"{shown}: target is not executable")
        return
    audit.ok(f"{shown} -> {expected}")


def active_config_paths(home: Path) -> list[Path]:
    paths = [home / relative for relative in CONFIG_PATHS]
    grok_hooks = home / ".grok" / "hooks"
    if grok_hooks.is_dir():
        paths.extend(sorted(grok_hooks.glob("*.json")))
    unique: dict[Path, None] = {}
    for path in paths:
        if is_present(path):
            unique[path] = None
    return list(unique)


def inspect_activity_registrations(
    audit: Audit,
    root: Path,
    home: Path,
) -> tuple[int, int, set[str]]:
    canonical_files: set[Path] = set()
    legacy_references: list[tuple[Path, int]] = []
    referenced_entrypoints: set[str] = set()

    for path in active_config_paths(home):
        try:
            text = path.read_text(encoding="utf-8")
        except OSError as error:
            audit.fail(f"{display_path(path, home)}: cannot read ({error})")
            continue
        if "aipane-activity" in text:
            canonical_files.add(path)
        normalized_text = re.sub(r"\\+/", "/", text)
        referenced_entrypoints.update(
            LOCAL_BIN_ENTRYPOINT.findall(normalized_text)
        )
        for number, line in enumerate(text.splitlines(), start=1):
            if "tmux-window-wrap activity" in line:
                legacy_references.append((path, number))

    if canonical_files:
        audit.ok(f"canonical activity registrations: {len(canonical_files)}")
    else:
        audit.warn("canonical activity registrations: none found")
    for path, number in legacy_references:
        audit.warn(
            "legacy activity command: "
            f"{display_path(path, home)}:{number} "
            "(supported compatibility consumer)"
        )

    for home_relative, root_relative in KNOWN_REGISTRATION_LINKS:
        destination = home / home_relative
        if not destination.is_symlink():
            continue
        source = root / root_relative
        shown = display_path(destination, home)
        try:
            actual = destination.resolve(strict=True)
            expected = source.resolve(strict=True)
        except OSError as error:
            audit.fail(f"{shown}: broken registration symlink ({error})")
            continue
        if actual != expected:
            audit.fail(
                f"{shown}: registration does not point to this checkout "
                f"(actual {actual}, expected {expected})"
            )
        else:
            audit.ok(f"{shown} -> {expected}")

    return (
        len(canonical_files),
        len(legacy_references),
        referenced_entrypoints,
    )


def check_dsh_notifier(audit: Audit, home: Path) -> None:
    app = Path(os.environ.get("AIPANE_DSH_NOTIFIER_APP") or
               home / "Applications/dsh Notifier.app").expanduser()
    executable = app / "Contents/MacOS/dsh-notifier"
    metadata = app / "Contents/Info.plist"
    try:
        with metadata.open("rb") as stream:
            info = plistlib.load(stream)
    except (OSError, plistlib.InvalidFileException, ValueError):
        audit.fail(f"{display_path(app, home)}: missing/invalid notifier App; run bin/build-dsh-notifier")
        return
    if (info.get("CFBundleIdentifier") != "com.alfheim.dsh-notifier"
            or info.get("CFBundleExecutable") != "dsh-notifier"
            or not executable.is_file() or not os.access(executable, os.X_OK)):
        audit.fail(f"{display_path(app, home)}: invalid dsh notifier identity or executable; rebuild with bin/build-dsh-notifier")
        return
    icon = str(info.get("CFBundleIconFile", ""))
    if not icon.endswith(".icns"):
        icon += ".icns"
    if not (app / "Contents/Resources" / icon).is_file():
        audit.fail(f"{display_path(app, home)}: notification icon is missing; rebuild with bin/build-dsh-notifier")
        return
    audit.ok(f"{display_path(app, home)}: dsh notification sender and icon")


def inspect_dsh_registrations(audit: Audit, root: Path, home: Path) -> set[str]:
    """Read native effective profiles without booting dsh or evaluating !!js."""
    dsh_home = Path(os.environ.get("DSH_HOME") or home / ".dsh").expanduser()
    profiles = [dsh_home / "profiles" / name for name in ("dsh-tui", "web")]
    profiles = [profile for profile in profiles if profile.is_dir()]
    if not profiles:
        return set()
    executable = os.environ.get("AIPANE_DSH_BIN")
    if not executable:
        local = home / ".local/bin/dsh"
        executable = str(local) if is_present(local) else shutil.which("dsh")
    node = shutil.which("node")
    if not node or not executable:
        audit.fail("dsh profiles exist but Node/dsh executable is missing; install dsh or set AIPANE_DSH_BIN")
        return set()
    helpers: set[str] = set()
    notifier = False
    for profile in profiles:
        shown = display_path(profile, home)
        try:
            completed = subprocess.run(
                [node, str(DSH_PROFILE_AUDITOR), executable, str(profile),
                 str(dsh_home), str(root / "integrations/dsh/cordis.patch.yml")],
                capture_output=True, text=True, check=False, timeout=8,
            )
            if completed.returncode:
                raise ValueError("native profile composition failed")
            projection = json.loads(completed.stdout)
        except (OSError, subprocess.SubprocessError, ValueError):
            audit.fail(f"{shown}: cannot read native dsh profile composition; check package.json, cordis.patch.yml, and installed @deepseek-ai/dsh-app-boot")
            continue
        for warning in projection["warnings"]:
            # Native warnings may embed arbitrary config values. Do not echo.
            audit.warn(f"{shown}: native loader skipped a patch; check patch target IDs")
        entries = projection["entries"]
        expected = {entry["id"]: root / "integrations/dsh" / Path(entry["name"]).name
                    for entry in projection["expected"]}
        if not expected:
            audit.fail(f"{root / 'integrations/dsh/cordis.patch.yml'}: no canonical dsh registrations")
        for identifier in expected:
            matches = [entry for entry in entries if entry.get("id") == identifier]
            if len(matches) != 1:
                audit.fail(f"{shown}: {identifier} {'missing' if not matches else 'registered more than once'}; merge integrations/dsh/cordis.patch.yml")
        for entry in entries:
            identifier = entry.get("id", "aipane plugin")
            if entry.get("disabled"):
                audit.fail(f"{shown}: {identifier} is disabled or has a dynamic disabled expression")
                continue
            name = entry.get("name")
            if not isinstance(name, str):
                audit.fail(f"{shown}: {identifier} has no statically verifiable plugin path")
                continue
            source = Path(name)
            if not source.is_absolute():
                source = profile / source
            try:
                actual = source.resolve(strict=True)
                canonical = expected.get(identifier)
                if canonical is not None and actual != canonical.resolve(strict=True):
                    audit.fail(f"{shown}: {identifier} does not point to this checkout (expected {canonical})")
                    continue
                text = actual.read_text(encoding="utf-8")
            except (OSError, ValueError):
                audit.fail(f"{shown}: {identifier} source is missing/unreadable or a broken symlink: {source}")
                continue
            helpers.update(LOCAL_BIN_ENTRYPOINT.findall(text))
            if identifier == "aipane-dsh-session" or actual.name in {
                "aipane-session.mjs", "aipane-dsh-session.mjs",
            }:
                # The plugin binds via aipane-bind; restore invokes this CLI
                # separately, so its dependency is not in the plugin source.
                helpers.add("aipane-dsh-session")
            if "aipane-dsh-notify" in text:
                notifier = True
                helpers.add("aipane-dsh-focus")
            audit.ok(f"{shown}: {identifier} -> {actual}")
    if notifier:
        check_dsh_notifier(audit, home)
    return helpers


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="aipane-doctor",
        description="read-only audit of Agent Activity installation wiring",
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=Path(__file__).resolve().parents[1],
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--home",
        type=Path,
        default=Path.home(),
        help=argparse.SUPPRESS,
    )
    arguments = parser.parse_args()
    root = arguments.root.expanduser().resolve()
    home = arguments.home.expanduser().resolve()
    audit = Audit()

    canonical_count, legacy_count, referenced = inspect_activity_registrations(
        audit,
        root,
        home,
    )
    checked = set(CORE_ENTRYPOINTS)
    checked.update(referenced)
    checked.update(inspect_dsh_registrations(audit, root, home))
    for name in sorted(checked):
        check_entrypoint(audit, root, home, name)

    summary = (
        f"{len(checked)} entrypoints, "
        f"canonical activity registrations: {canonical_count}, "
        f"compatibility references: {legacy_count}, "
        f"warnings: {audit.warnings}"
    )
    if audit.errors:
        print(f"FAIL aipane doctor: {audit.errors} error(s); {summary}")
        return 1
    print(f"PASS aipane doctor: {summary}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
