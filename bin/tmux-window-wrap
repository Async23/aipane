#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
import time
import unicodedata
import uuid


WINDOW_SEPARATOR = "\x1f"
MAX_STATUS_LINES = 3
CODEX_ACTIVITY_SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
CODEX_BUSY_PANES_FORMAT = (
    f"#{{P:#{{m/r:^[{CODEX_ACTIVITY_SPINNER}]( |$),#{{pane_title}}}}}}"
)
CODEX_ACTIVITY_GLYPH = "▓"
CODEX_ACTIVITY_LEVEL_COUNT = 13
CODEX_ACTIVITY_LEVEL_SEQUENCE = (
    *range(CODEX_ACTIVITY_LEVEL_COUNT),
    *range(CODEX_ACTIVITY_LEVEL_COUNT - 2, 0, -1),
)
DEFAULT_CODEX_ACTIVITY_FPS = 20
ANIMATION_TICK_OPTION = "@tmux-window-wrap-animation-tick"
COLOR_SCHEME_OPTION = "@tmux-window-wrap-color-scheme"
ANIMATOR_OWNER_ENVIRONMENT = "TMUX_WINDOW_WRAP_ANIMATOR_OWNER"
DEFAULT_ACTIVITY_PALETTES = {
    "light": {
        "inactive": (
            "D4D4D4",
            "CACACA",
            "C0C0C0",
            "B6B6B6",
            "ACACAC",
            "A2A2A2",
            "989898",
            "8E8E8E",
            "848484",
            "7A7A7A",
            "707070",
            "666666",
            "5C5C5C",
        ),
        "active": (
            "6F8790",
            "687F89",
            "617781",
            "5A707A",
            "536873",
            "4D616C",
            "465A65",
            "40535E",
            "394C57",
            "334550",
            "2D3E49",
            "283742",
            "22303A",
        ),
    },
    "dark": {
        "inactive": (
            "50545C",
            "5C6068",
            "686C74",
            "747880",
            "80848C",
            "8C9098",
            "989CA4",
            "A4A8B0",
            "B0B4BC",
            "BCC0C8",
            "C8CCD4",
            "D4D8E0",
            "E0E4EC",
        ),
        "active": (
            "4F86B1",
            "4B7EA7",
            "47769C",
            "436E92",
            "3F6687",
            "3B5F7D",
            "375772",
            "345068",
            "30485E",
            "2D4155",
            "293A4B",
            "263442",
            "222D39",
        ),
    },
}
WINDOW_FORMAT = WINDOW_SEPARATOR.join(
    (
        "#{window_id}",
        "#{window_index}",
        "#{window_name}",
        "#{window_active}",
        "#{pane_synchronized}",
        CODEX_BUSY_PANES_FORMAT,
        "#{w: #{window_index}:#{window_name}#{?pane_synchronized, ▶,} }",
    )
)
STATUS_WIDTH_FORMAT = WINDOW_SEPARATOR.join(
    (
        "#{w:#{T;=/#{status-left-length}:status-left}}",
        "#{w:#{T;=/#{status-right-length}:status-right}}",
    )
)


def display_width(text):
    width = 0
    for character in text:
        category = unicodedata.category(character)
        if category.startswith("M") or category in {"Cc", "Cf"}:
            continue
        width += 2 if unicodedata.east_asian_width(character) in {"W", "F"} else 1
    return width


def window_width(window):
    if "display_width" in window:
        base_width = window["display_width"]
    else:
        base_width = display_width(window["label"])
    return base_width + max(0, int(window.get("busy_codex_count", 0)))


def parse_palette(value):
    colours = tuple(
        colour.strip().removeprefix("#").upper()
        for colour in value.split(",")
    )
    hexadecimal = set("0123456789ABCDEF")
    if len(colours) != CODEX_ACTIVITY_LEVEL_COUNT or any(
        len(colour) != 6 or not set(colour) <= hexadecimal
        for colour in colours
    ):
        raise argparse.ArgumentTypeError(
            "palette must contain exactly "
            f"{CODEX_ACTIVITY_LEVEL_COUNT} comma-separated RRGGBB colours"
        )
    return colours


def distribute_codex_activity_phases(windows):
    counts = [
        max(0, int(window.get("busy_codex_count", 0)))
        for window in windows
    ]
    total = sum(counts)
    if total == 0:
        return {window["id"]: () for window in windows}

    cycle_length = len(CODEX_ACTIVITY_LEVEL_SEQUENCE)
    phase_by_ordinal = tuple(
        ordinal * cycle_length // total
        for ordinal in range(total)
    )
    phases_by_window = {}
    cursor = 0
    for window, count in zip(windows, counts):
        phases_by_window[window["id"]] = phase_by_ordinal[cursor : cursor + count]
        cursor += count
    return phases_by_window


def codex_activity_levels(phase_offsets, animation_tick):
    start = int(animation_tick) % len(CODEX_ACTIVITY_LEVEL_SEQUENCE)
    return tuple(
        CODEX_ACTIVITY_LEVEL_SEQUENCE[
            (start + phase_offset)
            % len(CODEX_ACTIVITY_LEVEL_SEQUENCE)
        ]
        for phase_offset in phase_offsets
    )


def codex_activity_indicator(phase_offsets, animation_tick, palette):
    return "".join(
        f"#[fg=#{palette[level]}]{CODEX_ACTIVITY_GLYPH}"
        for level in codex_activity_levels(phase_offsets, animation_tick)
    )


def animated_codex_activity_indicator(
    phase_offsets,
    animation_option,
    palette,
):
    indicators = [
        codex_activity_indicator(phase_offsets, tick, palette)
        for tick in range(len(CODEX_ACTIVITY_LEVEL_SEQUENCE))
    ]
    if not any(indicators):
        return ""

    option_reference = "#{" + animation_option + "}"
    expression = indicators[-1]
    for tick in range(len(indicators) - 2, -1, -1):
        condition = "#{==:" + option_reference + f",{tick}" + "}"
        expression = (
            "#{?"
            + condition
            + ","
            + indicators[tick]
            + ","
            + expression
            + "}"
        )
    return expression


def codex_activity_indicator_format(
    phase_offsets,
    animation_option,
    color_scheme_option,
    light_palette,
    dark_palette,
):
    light_indicator = animated_codex_activity_indicator(
        phase_offsets,
        animation_option,
        light_palette,
    )
    if not light_indicator:
        return ""
    if not color_scheme_option:
        return light_indicator

    dark_indicator = animated_codex_activity_indicator(
        phase_offsets,
        animation_option,
        dark_palette,
    )
    scheme_reference = "#{" + color_scheme_option + "}"
    return (
        "#{?#{==:"
        + scheme_reference
        + ",dark},"
        + dark_indicator
        + ","
        + light_indicator
        + "}"
    )


def wrap_windows(windows, capacity):
    lines = []
    current_line = []
    used = 0
    for window in windows:
        width = window_width(window)
        if current_line and used + width > capacity:
            lines.append(current_line)
            current_line = []
            used = 0
        if not current_line and width > capacity:
            lines.append([window])
            continue
        current_line.append(window)
        used += width
    if current_line:
        lines.append(current_line)
    return lines


def visible_continuation_lines(windows, capacity, active_id):
    maximum_lines = MAX_STATUS_LINES - 1
    all_lines = wrap_windows(windows, capacity)
    if len(all_lines) <= maximum_lines:
        return all_lines
    if active_id not in {window["id"] for window in windows}:
        return all_lines[:maximum_lines]

    active_index = next(
        index for index, window in enumerate(windows) if window["id"] == active_id
    )
    visible = [windows[active_index]]
    for index in range(active_index - 1, -1, -1):
        candidate = [windows[index], *visible]
        if len(wrap_windows(candidate, capacity)) > maximum_lines:
            break
        visible = candidate

    for window in windows[active_index + 1 :]:
        candidate = [*visible, window]
        if len(wrap_windows(candidate, capacity)) > maximum_lines:
            break
        visible = candidate
    return wrap_windows(visible, capacity)


def second_line_indent(payload, overflow):
    requested_indent = max(0, min(payload["left_width"], payload["width"]))
    if not overflow:
        return requested_indent

    target = next(
        (window for window in overflow if window["id"] == payload["active"]),
        overflow[0],
    )
    maximum_indent = max(0, payload["width"] - window_width(target))
    return min(requested_indent, maximum_indent)


def plan(payload):
    windows = payload["windows"]
    first_line_capacity = max(
        0,
        payload["width"] - payload["left_width"] - payload["right_width"],
    )
    used = 0
    split_at = 0
    for window in windows:
        label_width = window_width(window)
        if used + label_width > first_line_capacity:
            break
        used += label_width
        split_at += 1

    first_line = [window["id"] for window in windows[:split_at]]
    overflow = windows[split_at:]
    if not overflow:
        return {"line_count": 1, "lines": [first_line]}
    indent = second_line_indent(payload, overflow)
    continuation_capacity = max(0, payload["width"] - indent)
    continuation_lines = [
        [window["id"] for window in line]
        for line in visible_continuation_lines(
            overflow,
            continuation_capacity,
            payload["active"],
        )
    ]
    lines = [first_line, *continuation_lines]
    return {"line_count": len(lines), "lines": lines}


def render_window(
    window,
    active_id,
    animation_tick,
    activity_phase_offsets,
    activity_palettes,
    color_scheme,
    animation_option=None,
    color_scheme_option=None,
):
    window_range = f"#[range=window|{window['index']}]"
    synchronized = window.get("synchronized", False)
    active = window["id"] == active_id
    palette_role = "active" if active else "inactive"
    if animation_option:
        codex_activity = codex_activity_indicator_format(
            activity_phase_offsets,
            animation_option,
            color_scheme_option,
            activity_palettes["light"][palette_role],
            activity_palettes["dark"][palette_role],
        )
    else:
        codex_activity = codex_activity_indicator(
            activity_phase_offsets,
            animation_tick,
            activity_palettes[color_scheme][palette_role],
        )
    if codex_activity:
        name_colour = "colour15" if active else "colour7"
        codex_activity += f"#[fg={name_colour}]"
    escaped_name = window["name"].replace("#", "##")
    if active:
        rendered = (
            f"{window_range}#[fg=blue]#[bg=blue]#[fg=colour15]#[bold]"
            f" {codex_activity}{window['index']}:{escaped_name} "
        )
        if synchronized:
            rendered += "#[fg=red]▶ "
        return rendered + "#[bg=default]#[fg=blue]#[default]#[norange]"

    rendered = (
        f"{window_range} #[fg=colour7]{codex_activity}"
        f"{window['index']}:{escaped_name}"
    )
    if synchronized:
        rendered += " #[fg=red]▶#[default]"
    return rendered + " #[norange]"


def render(payload, line):
    layout = plan(payload)
    if line >= layout["line_count"]:
        return ""

    animation_tick = payload.get("animation_tick", 0)
    animation_option = payload.get("animation_option")
    color_scheme = payload.get("color_scheme", "light")
    color_scheme_option = payload.get("color_scheme_option")
    activity_palettes = payload.get(
        "activity_palettes",
        DEFAULT_ACTIVITY_PALETTES,
    )
    activity_phases_by_window = distribute_codex_activity_phases(
        payload["windows"]
    )
    windows_by_id = {window["id"]: window for window in payload["windows"]}
    if line > 0:
        overflow = payload["windows"][len(layout["lines"][0]) :]
        prefix = " " * second_line_indent(payload, overflow)
    else:
        prefix = ""
    return prefix + "".join(
        render_window(
            windows_by_id[window_id],
            payload["active"],
            animation_tick,
            activity_phases_by_window[window_id],
            activity_palettes,
            color_scheme,
            animation_option,
            color_scheme_option,
        )
        for window_id in layout["lines"][line]
    )


def run_tmux(socket_name, *arguments):
    command = ["tmux"]
    if socket_name:
        command.extend(("-L", socket_name))
    command.extend(arguments)
    return subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=True,
    )


def narrowest_client_width(session_id, socket_name, fallback):
    completed = run_tmux(
        socket_name,
        "list-clients",
        "-t",
        session_id,
        "-F",
        "#{client_width}",
    )
    widths = [
        int(value)
        for value in completed.stdout.splitlines()
        if value.isdecimal() and int(value) > 0
    ]
    return min(widths) if widths else fallback


def refresh_clients(socket_name):
    completed = run_tmux(
        socket_name,
        "list-clients",
        "-F",
        "#{client_name}",
    )
    for client_name in completed.stdout.splitlines():
        if client_name:
            run_tmux(
                socket_name,
                "refresh-client",
                "-S",
                "-t",
                client_name,
            )


def animation_probe(socket_name):
    completed = run_tmux(
        socket_name,
        "list-panes",
        "-a",
        "-F",
        WINDOW_SEPARATOR.join(
            (
                f"#{{{ANIMATOR_OWNER_ENVIRONMENT}}}",
                "#{session_attached}",
                "#{pane_title}",
            )
        ),
    )
    records = completed.stdout.splitlines()
    if not records:
        return None, False

    owner = None
    busy = False
    for record in records:
        record_owner, attached, title = record.split(WINDOW_SEPARATOR, 2)
        if owner is None:
            owner = record_owner
        if (
            attached != "0"
            and title
            and title[0] in CODEX_ACTIVITY_SPINNER
            and (len(title) == 1 or title[1] == " ")
        ):
            busy = True
    return owner, busy


def detect_color_scheme():
    if sys.platform == "darwin":
        try:
            completed = subprocess.run(
                ["defaults", "read", "-g", "AppleInterfaceStyle"],
                text=True,
                capture_output=True,
                check=False,
            )
        except OSError:
            return "light"
        return "dark" if completed.stdout.strip().lower() == "dark" else "light"

    colorfgbg = os.environ.get("COLORFGBG", "")
    try:
        background = int(colorfgbg.rsplit(";", 1)[-1])
    except ValueError:
        return "light"
    return "dark" if background <= 8 else "light"


def animate_status(socket_name, fps):
    owner = uuid.uuid4().hex
    try:
        run_tmux(
            socket_name,
            "set-environment",
            "-g",
            ANIMATOR_OWNER_ENVIRONMENT,
            owner,
        )
    except subprocess.CalledProcessError:
        return

    busy = False
    last_tick = None
    color_scheme = None
    next_probe = 0.0
    next_scheme_probe = 0.0
    while True:
        now = time.monotonic()
        try:
            if now >= next_probe:
                current_owner, busy = animation_probe(socket_name)
                if current_owner != owner:
                    return
                next_probe = now + (1.0 if busy else 0.25)
                if not busy:
                    last_tick = None

            if now >= next_scheme_probe:
                detected_scheme = detect_color_scheme()
                if detected_scheme != color_scheme:
                    run_tmux(
                        socket_name,
                        "set-option",
                        "-g",
                        COLOR_SCHEME_OPTION,
                        detected_scheme,
                    )
                    color_scheme = detected_scheme
                next_scheme_probe = now + 5.0

            if busy:
                absolute_tick = int(now * fps)
                tick = absolute_tick % len(CODEX_ACTIVITY_LEVEL_SEQUENCE)
                if tick != last_tick:
                    run_tmux(
                        socket_name,
                        "set-option",
                        "-g",
                        ANIMATION_TICK_OPTION,
                        str(tick),
                    )
                    last_tick = tick
                next_tick = (absolute_tick + 1) / fps
                wake_at = min(next_probe, next_tick, next_scheme_probe)
            else:
                wake_at = min(next_probe, next_scheme_probe)
        except subprocess.CalledProcessError:
            return

        time.sleep(max(0.01, wake_at - time.monotonic()))


def invalidate_cache(socket_name):
    run_tmux(
        socket_name,
        "set-environment",
        "-g",
        "TMUX_WINDOW_WRAP_GENERATION",
        uuid.uuid4().hex,
    )
    reconcile_status_heights(socket_name)
    refresh_clients(socket_name)


def reconcile_status_heights(socket_name):
    completed = run_tmux(
        socket_name,
        "list-sessions",
        "-F",
        WINDOW_SEPARATOR.join(("#{session_id}", "#{session_attached}")),
    )
    for record in completed.stdout.splitlines():
        session_id, attached = record.split(WINDOW_SEPARATOR, 1)
        if attached == "0":
            continue
        widths = run_tmux(
            socket_name,
            "display-message",
            "-p",
            "-t",
            session_id,
            STATUS_WIDTH_FORMAT,
        ).stdout.strip()
        left_width, right_width = (
            int(value) for value in widths.split(WINDOW_SEPARATOR)
        )
        payload = load_tmux_payload(
            argparse.Namespace(
                session_id=session_id,
                width=1,
                left_width=left_width,
                right_width=right_width,
                socket_name=socket_name,
            )
        )
        update_status_height(payload, session_id, socket_name)


def load_tmux_payload(arguments):
    completed = run_tmux(
        arguments.socket_name,
        "list-windows",
        "-t",
        arguments.session_id,
        "-F",
        WINDOW_FORMAT,
    )
    windows = []
    active_id = None
    for record in completed.stdout.removesuffix("\n").split("\n"):
        (
            window_id,
            index,
            name,
            active,
            synchronized,
            busy_codex_panes,
            label_width,
        ) = record.split(WINDOW_SEPARATOR, 6)
        is_synchronized = synchronized == "1"
        label = f" {index}:{name}"
        if is_synchronized:
            label += " ▶"
        label += " "
        windows.append(
            {
                "id": window_id,
                "index": index,
                "name": name,
                "label": label,
                "display_width": int(label_width),
                "synchronized": is_synchronized,
                "busy_codex_count": busy_codex_panes.count("1"),
            }
        )
        if active == "1":
            active_id = window_id

    return {
        "width": narrowest_client_width(
            arguments.session_id,
            arguments.socket_name,
            arguments.width,
        ),
        "left_width": arguments.left_width,
        "right_width": arguments.right_width,
        "animation_tick": (
            getattr(arguments, "animation_tick", None)
            if getattr(arguments, "animation_tick", None) is not None
            else int(
                time.monotonic()
                * getattr(
                    arguments,
                    "animation_fps",
                    DEFAULT_CODEX_ACTIVITY_FPS,
                )
            )
        ),
        "animation_option": getattr(arguments, "animation_option", None),
        "color_scheme": getattr(arguments, "color_scheme", "light"),
        "color_scheme_option": getattr(
            arguments,
            "color_scheme_option",
            None,
        ),
        "activity_palettes": {
            "light": {
                "inactive": getattr(
                    arguments,
                    "light_inactive_palette",
                    DEFAULT_ACTIVITY_PALETTES["light"]["inactive"],
                ),
                "active": getattr(
                    arguments,
                    "light_active_palette",
                    DEFAULT_ACTIVITY_PALETTES["light"]["active"],
                ),
            },
            "dark": {
                "inactive": getattr(
                    arguments,
                    "dark_inactive_palette",
                    DEFAULT_ACTIVITY_PALETTES["dark"]["inactive"],
                ),
                "active": getattr(
                    arguments,
                    "dark_active_palette",
                    DEFAULT_ACTIVITY_PALETTES["dark"]["active"],
                ),
            },
        },
        "active": active_id,
        "windows": windows,
    }


def update_status_height(payload, session_id, socket_name):
    line_count = plan(payload)["line_count"]
    desired = "on" if line_count == 1 else str(line_count)
    current = run_tmux(
        socket_name,
        "show-options",
        "-t",
        session_id,
        "-v",
        "status",
    ).stdout.strip()
    if current == "off":
        return
    if current != desired:
        run_tmux(socket_name, "set-option", "-t", session_id, "status", desired)


def main():
    parser = argparse.ArgumentParser(prog="tmux-window-wrap")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("plan")
    invalidate_parser = commands.add_parser("invalidate")
    invalidate_parser.add_argument("--socket-name")
    animate_parser = commands.add_parser("animate")
    animate_parser.add_argument(
        "--fps",
        type=float,
        default=DEFAULT_CODEX_ACTIVITY_FPS,
    )
    animate_parser.add_argument("--socket-name")
    render_parser = commands.add_parser("render")
    render_parser.add_argument(
        "--line",
        type=int,
        choices=range(MAX_STATUS_LINES),
        required=True,
    )
    render_parser.add_argument("--session-id")
    render_parser.add_argument("--width", type=int)
    render_parser.add_argument("--left-width", type=int)
    render_parser.add_argument("--right-width", type=int)
    render_parser.add_argument("--animation-tick", type=int)
    render_parser.add_argument(
        "--animation-fps",
        type=float,
        default=DEFAULT_CODEX_ACTIVITY_FPS,
    )
    render_parser.add_argument("--animation-option")
    render_parser.add_argument(
        "--color-scheme",
        choices=("light", "dark"),
        default="light",
    )
    render_parser.add_argument("--color-scheme-option")
    render_parser.add_argument(
        "--light-inactive-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["light"]["inactive"],
    )
    render_parser.add_argument(
        "--light-active-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["light"]["active"],
    )
    render_parser.add_argument(
        "--dark-inactive-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["dark"]["inactive"],
    )
    render_parser.add_argument(
        "--dark-active-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["dark"]["active"],
    )
    render_parser.add_argument("--store-option")
    render_parser.add_argument("--socket-name")
    arguments = parser.parse_args()
    if (
        arguments.command == "render"
        and arguments.animation_fps <= 0
    ):
        parser.error("--animation-fps must be greater than zero")
    if arguments.command == "animate" and arguments.fps <= 0:
        parser.error("--fps must be greater than zero")

    if arguments.command == "plan":
        json.dump(plan(json.load(sys.stdin)), sys.stdout, separators=(",", ":"))
        sys.stdout.write("\n")
        return

    if arguments.command == "invalidate":
        invalidate_cache(arguments.socket_name)
        return

    if arguments.command == "animate":
        animate_status(arguments.socket_name, arguments.fps)
        return

    if arguments.session_id:
        missing = [
            name
            for name in ("width", "left_width", "right_width")
            if getattr(arguments, name) is None
        ]
        if missing:
            parser.error(
                "runtime render requires --width, --left-width and --right-width"
            )
        payload = load_tmux_payload(arguments)
        if arguments.line == 0:
            update_status_height(
                payload,
                arguments.session_id,
                arguments.socket_name,
            )
    else:
        payload = json.load(sys.stdin)
    rendered = render(payload, arguments.line)
    if arguments.store_option:
        if not arguments.session_id:
            parser.error("--store-option requires --session-id")
        run_tmux(
            arguments.socket_name,
            "set-option",
            "-t",
            arguments.session_id,
            arguments.store_option,
            rendered,
        )
        sys.stdout.write("\n")
        return
    sys.stdout.write(rendered + "\n")


if __name__ == "__main__":
    main()
