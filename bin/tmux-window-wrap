WINDOW_SEPARATOR = "\x1f"
MAX_STATUS_LINES = 3
PANE_ACTIVITY_OPTION = "@tmux-window-wrap-activity"
PANE_ACTIVITY_REFERENCE = "#{" + PANE_ACTIVITY_OPTION + "}"
PANE_ACTIVITY_REPORTER_OPTION = "@tmux-window-wrap-activity-reporter"
PANE_ACTIVITY_UPDATED_AT_OPTION = "@tmux-window-wrap-activity-updated-at"
PANE_ACTIVITY_RECORD_OPTION = "@tmux-window-wrap-activity-record"
MARKED_BUSY_PANE_FORMAT = (
    "#{&&:#{m/r:^.+$,"
    + PANE_ACTIVITY_REFERENCE
    + "},#{==:"
    + PANE_ACTIVITY_REFERENCE
    + ",#{pane_current_command}}}"
)
BUSY_PANES_FORMAT = "#{P:" + MARKED_BUSY_PANE_FORMAT + "}"
ACTIVITY_GLYPH = "▓"
ACTIVITY_LEVEL_COUNT = 13
ACTIVITY_LEVEL_SEQUENCE = (
    *range(ACTIVITY_LEVEL_COUNT),
    *range(ACTIVITY_LEVEL_COUNT - 2, 0, -1),
)
DEFAULT_ACTIVITY_FPS = 20
ACTIVITY_REPAIR_CANDIDATES = {}
ANIMATION_TICK_OPTION = "@tmux-window-wrap-animation-tick"
COLOR_SCHEME_OPTION = "@tmux-window-wrap-color-scheme"
DEFAULT_PANE_COUNT_STYLE = "subscript"
PANE_COUNT_STYLES = ("subscript", "plain", "off")
SUBSCRIPT_DIGITS = str.maketrans("0123456789", "₀₁₂₃₄₅₆₇₈₉")
ANIMATOR_OWNER_ENVIRONMENT = "TMUX_WINDOW_WRAP_ANIMATOR_OWNER"
