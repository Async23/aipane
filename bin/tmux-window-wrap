WINDOW_FORMAT = WINDOW_SEPARATOR.join(
    (
        "#{window_id}",
        "#{window_index}",
        "#{window_name}",
        "#{window_active}",
        "#{pane_synchronized}",
        BUSY_PANES_FORMAT,
        "#{w: #{window_index}:#{window_name}#{?pane_synchronized, ▶,} }",
    )
)
STATUS_WIDTH_FORMAT = WINDOW_SEPARATOR.join(
    (
        "#{w:#{T;=/#{status-left-length}:status-left}}",
        "#{w:#{T;=/#{status-right-length}:status-right}}",
    )
)


def display_width(text):
    width = 0
    for character in text:
        category = unicodedata.category(character)
        if category.startswith("M") or category in {"Cc", "Cf"}:
            continue
        width += 2 if unicodedata.east_asian_width(character) in {"W", "F"} else 1
    return width


def pane_count_annotation(window, style=DEFAULT_PANE_COUNT_STYLE):
    pane_count = max(1, int(window.get("pane_count", 1)))
    if pane_count == 1 or style == "off":
        return ""
    if style == "subscript":
        return str(pane_count).translate(SUBSCRIPT_DIGITS)
    if style == "plain":
        return f"[{pane_count}]"
    raise ValueError(f"unsupported pane count style: {style}")


def window_width(window, pane_count_style=DEFAULT_PANE_COUNT_STYLE):
    if "display_width" in window:
        base_width = window["display_width"]
    else:
        base_width = display_width(window["label"])
    pane_count_width = display_width(
        pane_count_annotation(window, pane_count_style)
    )
    busy_activity_count = max(
        0,
        int(window.get("busy_activity_count", 0)),
    )
    activity_width = max(0, busy_activity_count - 1)
    return base_width + pane_count_width + activity_width


def parse_palette(value):
    colours = tuple(
        colour.strip().removeprefix("#").upper()
        for colour in value.split(",")
    )
    hexadecimal = set("0123456789ABCDEF")
    if len(colours) != ACTIVITY_LEVEL_COUNT or any(
        len(colour) != 6 or not set(colour) <= hexadecimal
        for colour in colours
    ):
        raise argparse.ArgumentTypeError(
            "palette must contain exactly "
            f"{ACTIVITY_LEVEL_COUNT} comma-separated RRGGBB colours"
        )
    return colours


def distribute_activity_phases(windows):
    counts = [
        max(0, int(window.get("busy_activity_count", 0)))
        for window in windows
    ]
    total = sum(counts)
    if total == 0:
        return {window["id"]: () for window in windows}

    cycle_length = len(ACTIVITY_LEVEL_SEQUENCE)
    phase_by_ordinal = tuple(
        ordinal * cycle_length // total
        for ordinal in range(total)
    )
    phases_by_window = {}
    cursor = 0
    for window, count in zip(windows, counts):
        phases_by_window[window["id"]] = phase_by_ordinal[cursor : cursor + count]
        cursor += count
    return phases_by_window


def activity_levels(phase_offsets, animation_tick):
    start = int(animation_tick) % len(ACTIVITY_LEVEL_SEQUENCE)
    return tuple(
        ACTIVITY_LEVEL_SEQUENCE[
            (start + phase_offset)
            % len(ACTIVITY_LEVEL_SEQUENCE)
        ]
        for phase_offset in phase_offsets
    )


def activity_indicator(phase_offsets, animation_tick, palette):
    return "".join(
        f"#[fg=#{palette[level]}]{ACTIVITY_GLYPH}"
        for level in activity_levels(phase_offsets, animation_tick)
    )


def animated_activity_indicator(
    phase_offsets,
    animation_option,
    palette,
):
    indicators = [
        activity_indicator(phase_offsets, tick, palette)
        for tick in range(len(ACTIVITY_LEVEL_SEQUENCE))
    ]
    if not any(indicators):
        return ""

    option_reference = "#{" + animation_option + "}"

    def balanced_lookup(start, end):
        if end - start == 1:
            return indicators[start]
        midpoint = (start + end) // 2
        condition = (
            "#{e|<:" + option_reference + f",{midpoint}" + "}"
        )
        return (
            "#{?"
            + condition
            + ","
            + balanced_lookup(start, midpoint)
            + ","
            + balanced_lookup(midpoint, end)
            + "}"
        )

    valid_tick = (
        "#{m/r:^([0-9]|1[0-9]|2[0-3])$," + option_reference + "}"
    )
    return (
        "#{?"
        + valid_tick
        + ","
        + balanced_lookup(0, len(indicators))
        + ","
        + indicators[-1]
        + "}"
    )


def activity_indicator_format(
    phase_offsets,
    animation_option,
    color_scheme_option,
    light_palette,
    dark_palette,
):
    light_indicator = animated_activity_indicator(
        phase_offsets,
        animation_option,
        light_palette,
    )
    if not light_indicator:
        return ""
    if not color_scheme_option:
        return light_indicator

    dark_indicator = animated_activity_indicator(
        phase_offsets,
        animation_option,
        dark_palette,
    )
    scheme_reference = "#{" + color_scheme_option + "}"
    return (
        "#{?#{==:"
        + scheme_reference
        + ",dark},"
        + dark_indicator
        + ","
        + light_indicator
        + "}"
    )


def wrap_windows(
    windows,
    capacity,
    pane_count_style=DEFAULT_PANE_COUNT_STYLE,
):
    lines = []
    current_line = []
    used = 0
    for window in windows:
        width = window_width(window, pane_count_style)
        if current_line and used + width > capacity:
            lines.append(current_line)
            current_line = []
            used = 0
        if not current_line and width > capacity:
            lines.append([window])
            continue
        current_line.append(window)
        used += width
    if current_line:
        lines.append(current_line)
    return lines


def visible_continuation_lines(
    windows,
    capacity,
    active_id,
    pane_count_style=DEFAULT_PANE_COUNT_STYLE,
):
    maximum_lines = MAX_STATUS_LINES - 1
    all_lines = wrap_windows(windows, capacity, pane_count_style)
    if len(all_lines) <= maximum_lines:
        return all_lines
    if active_id not in {window["id"] for window in windows}:
        return all_lines[:maximum_lines]

    active_index = next(
        index for index, window in enumerate(windows) if window["id"] == active_id
    )
    visible = [windows[active_index]]
    for index in range(active_index - 1, -1, -1):
        candidate = [windows[index], *visible]
        if (
            len(wrap_windows(candidate, capacity, pane_count_style))
            > maximum_lines
        ):
            break
        visible = candidate

    for window in windows[active_index + 1 :]:
        candidate = [*visible, window]
        if (
            len(wrap_windows(candidate, capacity, pane_count_style))
            > maximum_lines
        ):
            break
        visible = candidate
    return wrap_windows(visible, capacity, pane_count_style)


def second_line_indent(payload, overflow):
    requested_indent = max(0, min(payload["left_width"], payload["width"]))
    if not overflow:
        return requested_indent

    target = next(
        (window for window in overflow if window["id"] == payload["active"]),
        overflow[0],
    )
    maximum_indent = max(
        0,
        payload["width"]
        - window_width(
            target,
            payload.get("pane_count_style", DEFAULT_PANE_COUNT_STYLE),
        ),
    )
    return min(requested_indent, maximum_indent)


def plan(payload):
    windows = payload["windows"]
    pane_count_style = payload.get(
        "pane_count_style",
        DEFAULT_PANE_COUNT_STYLE,
    )
    first_line_capacity = max(
        0,
        payload["width"] - payload["left_width"] - payload["right_width"],
    )
    used = 0
    split_at = 0
    for window in windows:
        label_width = window_width(window, pane_count_style)
        if used + label_width > first_line_capacity:
            break
        used += label_width
        split_at += 1

    first_line = [window["id"] for window in windows[:split_at]]
    overflow = windows[split_at:]
    if not overflow:
        return {"line_count": 1, "lines": [first_line]}
    indent = second_line_indent(payload, overflow)
    continuation_capacity = max(0, payload["width"] - indent)
    continuation_lines = [
        [window["id"] for window in line]
        for line in visible_continuation_lines(
            overflow,
            continuation_capacity,
            payload["active"],
            pane_count_style,
        )
    ]
    lines = [first_line, *continuation_lines]
    return {"line_count": len(lines), "lines": lines}


def render_window(
    window,
    active_id,
    animation_tick,
    activity_phase_offsets,
    activity_palettes,
    color_scheme,
    animation_option=None,
    color_scheme_option=None,
    pane_count_style=DEFAULT_PANE_COUNT_STYLE,
):
    window_range = f"#[range=window|{window['index']}]"
    synchronized = window.get("synchronized", False)
    active = window["id"] == active_id
    palette_role = "active" if active else "inactive"
    if animation_option and color_scheme_option:
        pane_activity = activity_indicator_format(
            activity_phase_offsets,
            animation_option,
            color_scheme_option,
            activity_palettes["light"][palette_role],
            activity_palettes["dark"][palette_role],
        )
    elif animation_option:
        pane_activity = animated_activity_indicator(
            activity_phase_offsets,
            animation_option,
            activity_palettes[color_scheme][palette_role],
        )
    else:
        pane_activity = activity_indicator(
            activity_phase_offsets,
            animation_tick,
            activity_palettes[color_scheme][palette_role],
        )
    if pane_activity:
        name_colour = "colour15" if active else "colour7"
        pane_activity += f"#[fg={name_colour}]"
    escaped_name = window["name"].replace("#", "##")
    index_label = (
        f"{window['index']}"
        f"{pane_count_annotation(window, pane_count_style)}"
    )
    if active:
        inner_padding = "" if pane_activity else " "
        rendered = (
            f"{window_range}#[fg=blue]#[bg=blue]"
            f"#[fg=colour15]#[bold]"
            f"{inner_padding}{pane_activity}"
            f"{index_label}:{escaped_name} "
        )
        if synchronized:
            rendered += "#[fg=red]▶ "
        return rendered + "#[bg=default]#[fg=blue]#[default]#[norange]"

    leading_padding = "" if pane_activity else " "
    rendered = (
        f"{window_range}{leading_padding}#[fg=colour7]{pane_activity}"
        f"{index_label}:{escaped_name}"
    )
    if synchronized:
        rendered += " #[fg=red]▶#[default]"
    return rendered + " #[norange]"


def render(payload, line):
    layout = plan(payload)
    if line >= layout["line_count"]:
        return ""

    animation_tick = payload.get("animation_tick", 0)
    animation_option = payload.get("animation_option")
    color_scheme = payload.get("color_scheme", "light")
    color_scheme_option = payload.get("color_scheme_option")
    pane_count_style = payload.get(
        "pane_count_style",
        DEFAULT_PANE_COUNT_STYLE,
    )
    activity_palettes = payload.get(
        "activity_palettes",
        DEFAULT_ACTIVITY_PALETTES,
    )
    activity_phases_by_window = distribute_activity_phases(
        payload["windows"]
    )
    windows_by_id = {window["id"]: window for window in payload["windows"]}
    if line > 0:
        overflow = payload["windows"][len(layout["lines"][0]) :]
        prefix = " " * second_line_indent(payload, overflow)
    else:
        prefix = ""
    return prefix + "".join(
        render_window(
            windows_by_id[window_id],
            payload["active"],
            animation_tick,
            activity_phases_by_window[window_id],
            activity_palettes,
            color_scheme,
            animation_option,
            color_scheme_option,
            pane_count_style,
        )
        for window_id in layout["lines"][line]
    )


def run_tmux(socket_name, *arguments):
    command = ["tmux"]
    if socket_name:
        command.extend(("-L", socket_name))
    command.extend(arguments)
    return subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=True,
    )


def narrowest_client_width(session_id, socket_name, fallback):
    completed = run_tmux(
        socket_name,
        "list-clients",
        "-t",
        session_id,
        "-F",
        "#{client_width}",
    )
    widths = [
        int(value)
        for value in completed.stdout.splitlines()
        if value.isdecimal() and int(value) > 0
    ]
    return min(widths) if widths else fallback


def refresh_clients(socket_name):
    completed = run_tmux(
        socket_name,
        "list-clients",
        "-F",
        "#{client_name}",
    )
    for client_name in completed.stdout.splitlines():
        if client_name:
            run_tmux(
                socket_name,
                "refresh-client",
                "-S",
                "-t",
                client_name,
            )


def global_environment_value(socket_name, name):
    completed = run_tmux(
        socket_name,
        "show-environment",
        "-g",
        name,
    )
    assignment = completed.stdout.rstrip("\n")
    prefix = f"{name}="
    if not assignment.startswith(prefix):
        return None
    return assignment[len(prefix) :]


def tmux_has_sessions(socket_name):
    completed = run_tmux(
        socket_name,
        "list-sessions",
        "-F",
        "#{session_id}",
    )
    return bool(completed.stdout.splitlines())


def is_codex_command(current_command):
    return current_command == "codex" or current_command.startswith("codex-")


process_is_running = activity_domain.process_is_running
process_tty = activity_domain.process_tty


def load_claude_session_states(
    targets=None,
    environment=None,
    process_exists=None,
    process_tty_lookup=None,
):
    return activity_domain.load_claude_session_states(
        targets,
        environment,
        process_exists or process_is_running,
