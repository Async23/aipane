)
STATUS_WIDTH_FORMAT = WINDOW_SEPARATOR.join(
    (
        "#{w:#{T;=/#{status-left-length}:status-left}}",
        "#{w:#{T;=/#{status-right-length}:status-right}}",
    )
)


def vs16_width_adjustment(text):
    """Count cells tmux adds for VS16 while drawing, after #{w:...}."""
    adjustment = 0
    previous_width = 0
    for character in text:
        if character == "\ufe0f":
            if previous_width == 1:
                adjustment += 1
                previous_width = 2
            continue
        category = unicodedata.category(character)
        if category.startswith("M") or category in {"Cc", "Cf"}:
            continue
        previous_width = (
            2
            if unicodedata.east_asian_width(character) in {"W", "F"}
            else 1
        )
    return adjustment


def display_width(text):
    width = 0
    for character in text:
        category = unicodedata.category(character)
        if category.startswith("M") or category in {"Cc", "Cf"}:
            continue
        width += 2 if unicodedata.east_asian_width(character) in {"W", "F"} else 1
    return width + vs16_width_adjustment(text)


def pane_count_annotation(window, style=DEFAULT_PANE_COUNT_STYLE):
    pane_count = max(1, int(window.get("pane_count", 1)))
    if pane_count == 1 or style == "off":
        return ""
    if style == "subscript":
        return str(pane_count).translate(SUBSCRIPT_DIGITS)
    if style == "plain":
        return f"[{pane_count}]"
    raise ValueError(f"unsupported pane count style: {style}")


def window_width(window, pane_count_style=DEFAULT_PANE_COUNT_STYLE):
    if "display_width" in window:
        base_width = window["display_width"]
    else:
        base_width = display_width(window["label"])
    pane_count_width = display_width(
        pane_count_annotation(window, pane_count_style)
    )
    busy_activity_count = max(
        0,
        int(window.get("busy_activity_count", 0)),
    )
    activity_width = max(0, busy_activity_count - 1)
    return base_width + pane_count_width + activity_width


def parse_palette(value):
    colours = tuple(
        colour.strip().removeprefix("#").upper()
        for colour in value.split(",")
    )
    hexadecimal = set("0123456789ABCDEF")
    if len(colours) != ACTIVITY_LEVEL_COUNT or any(
        len(colour) != 6 or not set(colour) <= hexadecimal
        for colour in colours
    ):
        raise argparse.ArgumentTypeError(
            "palette must contain exactly "
            f"{ACTIVITY_LEVEL_COUNT} comma-separated RRGGBB colours"
        )
    return colours


def distribute_activity_phases(windows):
    counts = [
        max(0, int(window.get("busy_activity_count", 0)))
        for window in windows
    ]
    total = sum(counts)
    if total == 0:
        return {window["id"]: () for window in windows}

    cycle_length = len(ACTIVITY_LEVEL_SEQUENCE)
    phase_by_ordinal = tuple(
        ordinal * cycle_length // total
        for ordinal in range(total)
    )
    phases_by_window = {}
    cursor = 0
    for window, count in zip(windows, counts):
        phases_by_window[window["id"]] = phase_by_ordinal[cursor : cursor + count]
        cursor += count
    return phases_by_window


def activity_levels(phase_offsets, animation_tick):
    start = int(animation_tick) % len(ACTIVITY_LEVEL_SEQUENCE)
    return tuple(
        ACTIVITY_LEVEL_SEQUENCE[
            (start + phase_offset)
            % len(ACTIVITY_LEVEL_SEQUENCE)
        ]
        for phase_offset in phase_offsets
    )


def activity_indicator(phase_offsets, animation_tick, palette):
    return "".join(
        f"#[fg=#{palette[level]}]{ACTIVITY_GLYPH}"
        for level in activity_levels(phase_offsets, animation_tick)
    )


def animated_activity_indicator(
    phase_offsets,
    animation_option,
    palette,
):
    indicators = [
        activity_indicator(phase_offsets, tick, palette)
        for tick in range(len(ACTIVITY_LEVEL_SEQUENCE))
    ]
    if not any(indicators):
        return ""

    option_reference = "#{" + animation_option + "}"

    def balanced_lookup(start, end):
        if end - start == 1:
            return indicators[start]
        midpoint = (start + end) // 2
        condition = (
            "#{e|<:" + option_reference + f",{midpoint}" + "}"
        )
        return (
            "#{?"
            + condition
            + ","
            + balanced_lookup(start, midpoint)
            + ","
            + balanced_lookup(midpoint, end)
            + "}"
        )

    valid_tick = (
        "#{m/r:^([0-9]|1[0-9]|2[0-3])$," + option_reference + "}"
    )
    return (
        "#{?"
        + valid_tick
        + ","
        + balanced_lookup(0, len(indicators))
        + ","
        + indicators[-1]
        + "}"
    )


def activity_indicator_format(
    phase_offsets,
    animation_option,
    color_scheme_option,
    light_palette,
    dark_palette,
):
    light_indicator = animated_activity_indicator(
        phase_offsets,
        animation_option,
        light_palette,
    )
    if not light_indicator:
        return ""
    if not color_scheme_option:
        return light_indicator

    dark_indicator = animated_activity_indicator(
        phase_offsets,
        animation_option,
        dark_palette,
    )
    scheme_reference = "#{" + color_scheme_option + "}"
    return (
        "#{?#{==:"
        + scheme_reference
        + ",dark},"
        + dark_indicator
        + ","
        + light_indicator
        + "}"
    )


def wrap_windows(
    windows,
    capacity,
    pane_count_style=DEFAULT_PANE_COUNT_STYLE,
):
    lines = []
    current_line = []
    used = 0
    for window in windows:
        width = window_width(window, pane_count_style)
        if current_line and used + width > capacity:
            lines.append(current_line)
            current_line = []
            used = 0
        if not current_line and width > capacity:
            lines.append([window])
            continue
        current_line.append(window)
        used += width
    if current_line:
        lines.append(current_line)
    return lines


def visible_continuation_lines(
    windows,
    capacity,
    active_id,
    pane_count_style=DEFAULT_PANE_COUNT_STYLE,
):
    maximum_lines = MAX_STATUS_LINES - 1
    all_lines = wrap_windows(windows, capacity, pane_count_style)
    if len(all_lines) <= maximum_lines:
        return all_lines
    if active_id not in {window["id"] for window in windows}:
        return all_lines[:maximum_lines]

    active_index = next(
        index for index, window in enumerate(windows) if window["id"] == active_id
    )
    visible = [windows[active_index]]
    for index in range(active_index - 1, -1, -1):
        candidate = [windows[index], *visible]
        if (
            len(wrap_windows(candidate, capacity, pane_count_style))
            > maximum_lines
        ):
            break
        visible = candidate

    for window in windows[active_index + 1 :]:
        candidate = [*visible, window]
        if (
            len(wrap_windows(candidate, capacity, pane_count_style))
            > maximum_lines
        ):
            break
        visible = candidate
    return wrap_windows(visible, capacity, pane_count_style)


def second_line_indent(payload, overflow):
    requested_indent = max(0, min(payload["left_width"], payload["width"]))
    if not overflow:
        return requested_indent

    target = next(
        (window for window in overflow if window["id"] == payload["active"]),
        overflow[0],
    )
    maximum_indent = max(
        0,
        payload["width"]
        - window_width(
            target,
            payload.get("pane_count_style", DEFAULT_PANE_COUNT_STYLE),
        ),
    )
    return min(requested_indent, maximum_indent)


def plan(payload):
    windows = payload["windows"]
    pane_count_style = payload.get(
        "pane_count_style",
        DEFAULT_PANE_COUNT_STYLE,
    )
    first_line_capacity = max(
        0,
        payload["width"] - payload["left_width"] - payload["right_width"],
    )
    used = 0
    split_at = 0
    for window in windows:
        label_width = window_width(window, pane_count_style)
        if used + label_width > first_line_capacity:
            break
        used += label_width
        split_at += 1

    first_line = [window["id"] for window in windows[:split_at]]
    overflow = windows[split_at:]
    if not overflow:
        return {"line_count": 1, "lines": [first_line]}
    indent = second_line_indent(payload, overflow)
    continuation_capacity = max(0, payload["width"] - indent)
    continuation_lines = [
        [window["id"] for window in line]
        for line in visible_continuation_lines(
            overflow,
            continuation_capacity,
            payload["active"],
            pane_count_style,
        )
    ]
    lines = [first_line, *continuation_lines]
    return {"line_count": len(lines), "lines": lines}


def render_window(
    window,
    active_id,
    animation_tick,
    activity_phase_offsets,
    activity_palettes,
    color_scheme,
    animation_option=None,
    color_scheme_option=None,
    pane_count_style=DEFAULT_PANE_COUNT_STYLE,
    pane_count_text_style="",
    pane_count_active_text_style="",
):
    window_range = f"#[range=window|{window['index']}]"
    synchronized = window.get("synchronized", False)
    active = window["id"] == active_id
    palette_role = "active" if active else "inactive"
    if animation_option and color_scheme_option:
        pane_activity = activity_indicator_format(
            activity_phase_offsets,
            animation_option,
            color_scheme_option,
            activity_palettes["light"][palette_role],
            activity_palettes["dark"][palette_role],
        )
    elif animation_option:
        pane_activity = animated_activity_indicator(
            activity_phase_offsets,
            animation_option,
            activity_palettes[color_scheme][palette_role],
        )
    else:
        pane_activity = activity_indicator(
            activity_phase_offsets,
            animation_tick,
            activity_palettes[color_scheme][palette_role],
        )
    if pane_activity:
        name_colour = "colour15" if active else "colour7"
        pane_activity += f"#[fg={name_colour}]"
    escaped_name = window["name"].replace("#", "##")
    count_label = pane_count_annotation(window, pane_count_style)
    count_text_style = (
        pane_count_active_text_style
        if active and pane_count_active_text_style
        else pane_count_text_style
    )
    if count_label and count_text_style:
        count_label = (
            f"#[push-default]#[{count_text_style}]{count_label}"
            "#[default]#[pop-default]"
        )
    index_label = f"{window['index']}{count_label}"
    if active:
        inner_padding = "" if pane_activity else " "
        rendered = (
            f"{window_range}#[fg=blue]#[bg=blue]"
            f"#[fg=colour15]#[bold]"
            f"{inner_padding}{pane_activity}"
            f"{index_label}:{escaped_name} "
        )
        if synchronized:
            rendered += "#[fg=red]▶ "
        return rendered + "#[bg=default]#[fg=blue]#[default]#[norange]"

    leading_padding = "" if pane_activity else " "
    rendered = (
        f"{window_range}{leading_padding}#[fg=colour7]{pane_activity}"
        f"{index_label}:{escaped_name}"
    )
    if synchronized:
        rendered += " #[fg=red]▶#[default]"
    return rendered + " #[norange]"


def render(payload, line):
    layout = plan(payload)
    if line >= layout["line_count"]:
        return ""

    animation_tick = payload.get("animation_tick", 0)
    animation_option = payload.get("animation_option")
    color_scheme = payload.get("color_scheme", "light")
    color_scheme_option = payload.get("color_scheme_option")
    pane_count_style = payload.get(
        "pane_count_style",
        DEFAULT_PANE_COUNT_STYLE,
    )
    activity_palettes = payload.get(
        "activity_palettes",
        DEFAULT_ACTIVITY_PALETTES,
    )
    activity_phases_by_window = distribute_activity_phases(
        payload["windows"]
    )
    windows_by_id = {window["id"]: window for window in payload["windows"]}
    if line > 0:
        overflow = payload["windows"][len(layout["lines"][0]) :]
        prefix = " " * second_line_indent(payload, overflow)
    else:
        prefix = ""
    return prefix + "".join(
        render_window(
            windows_by_id[window_id],
            payload["active"],
            animation_tick,
            activity_phases_by_window[window_id],
            activity_palettes,
            color_scheme,
            animation_option,
            color_scheme_option,
            pane_count_style,
            payload.get("pane_count_text_style", ""),
            payload.get("pane_count_active_text_style", ""),
        )
        for window_id in layout["lines"][line]
    )


def run_tmux(socket_name, *arguments):
    command = ["tmux"]
    if socket_name:
        command.extend(("-L", socket_name))
    command.extend(arguments)
    return subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=True,
    )


def _command_arguments(command):
    try:
        return shlex.split(command)
    except ValueError:
        return command.split()


def _executable_name(token):
    return Path(token).name.lower()


def _is_ai_tool_executable(token):
    name = _executable_name(token)
    return name in AI_TOOL_EXECUTABLES or name.startswith(
        AI_TOOL_EXECUTABLE_PREFIXES
    )


def _is_ai_tool_script(token):
    normalized = token.lower().replace("\\", "/")
    return _is_ai_tool_executable(token) or any(
        marker in normalized for marker in AI_TOOL_PATH_MARKERS
    )


def command_runs_ai_tool(command):
    arguments = _command_arguments(command)
    if not arguments:
        return False
    executable = _executable_name(arguments[0])
    if _is_ai_tool_executable(arguments[0]):
        return True
    if executable == "agent-browser":
        return "daemon" in arguments[1:]
    if executable in PACKAGE_RUNNERS:
        candidates = arguments[1:]
        subcommands = PACKAGE_RUNNER_SUBCOMMANDS.get(executable)
        if subcommands is not None:
            if not candidates or candidates[0] not in subcommands:
                return False
            candidates = candidates[1:]
        return any(_is_ai_tool_script(token) for token in candidates[:4])
    if executable in RUNTIME_EXECUTABLES or executable.startswith("python"):
        script = next(
            (token for token in arguments[1:] if not token.startswith("-")),
            "",
        )
        return bool(script) and _is_ai_tool_script(script)
    return False


def _process_table():
    completed = subprocess.run(
        ["ps", "-axo", "pid=,ppid=,stat=,command="],
        text=True,
        capture_output=True,
        check=False,
        timeout=2,
    )
    if completed.returncode != 0:
        return None
    processes = {}
    for line in completed.stdout.splitlines():
        fields = line.strip().split(maxsplit=3)
        if len(fields) != 4 or fields[2].startswith("Z"):
            continue
        try:
            pid = int(fields[0])
            parent_pid = int(fields[1])
        except ValueError:
            continue
        processes[pid] = (parent_pid, fields[3])
    return processes


def _pane_process_commands(pane_pid):
    try:
        processes = _process_table()
    except (OSError, subprocess.SubprocessError):
        return None
    if processes is None or pane_pid not in processes:
        return None
    children = {}
    for pid, (parent_pid, _command) in processes.items():
        children.setdefault(parent_pid, []).append(pid)
    commands = []
    pending = [pane_pid]
    seen = set()
    while pending:
        pid = pending.pop()
        if pid in seen or pid not in processes:
            continue
        seen.add(pid)
        commands.append(processes[pid][1])
        pending.extend(children.get(pid, ()))
    return commands


def pane_agent_status(socket_name, pane_id):
    """Return agent, none, or unknown for the process tree owned by pane_id."""
    if not pane_id:
        return "unknown"
    try:
        completed = run_tmux(
            socket_name,
            "display-message",
            "-p",
            "-t",
            pane_id,
            "#{pane_pid}",
        )
        pane_pid = int(completed.stdout.strip())
    except (OSError, subprocess.CalledProcessError, TypeError, ValueError):
        return "unknown"
    if pane_pid <= 0:
        return "unknown"
    commands = _pane_process_commands(pane_pid)
    if commands is None:
        return "unknown"
    return "agent" if any(map(command_runs_ai_tool, commands)) else "none"


def narrowest_client_width(session_id, socket_name, fallback):
    completed = run_tmux(
        socket_name,
        "list-clients",
        "-t",
        session_id,
        "-F",
        "#{client_width}",
    )
    widths = [
        int(value)
        for value in completed.stdout.splitlines()
        if value.isdecimal() and int(value) > 0
    ]
    return min(widths) if widths else fallback


def refresh_clients(socket_name):
    completed = run_tmux(
        socket_name,
        "list-clients",
        "-F",
        "#{client_name}",
    )
    for client_name in completed.stdout.splitlines():
        if client_name:
            run_tmux(
                socket_name,
                "refresh-client",
                "-S",
                "-t",
                client_name,
            )


def global_environment_value(socket_name, name):
    completed = run_tmux(
        socket_name,
        "show-environment",
        "-g",
        name,
    )
    assignment = completed.stdout.rstrip("\n")
    prefix = f"{name}="
    if not assignment.startswith(prefix):
        return None
    return assignment[len(prefix) :]


def tmux_has_sessions(socket_name):
    completed = run_tmux(
        socket_name,
        "list-sessions",
        "-F",
        "#{session_id}",
    )
    return bool(completed.stdout.splitlines())


def activity_controller(socket_name, environment=None):
    """Return the long-lived protocol owner for one animator process."""

    if environment is not None:
        adapter = TmuxActivityAdapter(
            socket_name=socket_name,
            environment=environment,
            runner=run_tmux,
            wake=invalidate_cache,
        )
        return AgentActivity(adapter=adapter, environment=environment)
    key = (socket_name, id(run_tmux))
    controller = _ACTIVITY_CONTROLLERS.get(key)
    if controller is None:
        adapter = TmuxActivityAdapter(
            socket_name=socket_name,
            runner=run_tmux,
            wake=invalidate_cache,
        )
        controller = AgentActivity(adapter=adapter)
        _ACTIVITY_CONTROLLERS[key] = controller
    return controller


def animation_probe(socket_name, controller=None):
    controller = controller or activity_controller(socket_name)
    result = controller.reconcile()
    if result.owner is None:
        if result.errors:
            try:
                if tmux_has_sessions(socket_name):
                    raise ActivityError(result.errors[0])
            except subprocess.CalledProcessError:
                pass
        return (
            global_environment_value(
                socket_name,
                ANIMATOR_OWNER_ENVIRONMENT,
            ),
            False,
        )
    return result.owner, result.busy


def detect_color_scheme():
    if sys.platform == "darwin":
        try:
            completed = subprocess.run(
                ["defaults", "read", "-g", "AppleInterfaceStyle"],
                text=True,
                capture_output=True,
                check=False,
            )
        except OSError:
            return "light"
        return "dark" if completed.stdout.strip().lower() == "dark" else "light"

    colorfgbg = os.environ.get("COLORFGBG", "")
    try:
        background = int(colorfgbg.rsplit(";", 1)[-1])
    except ValueError:
        return "light"
    return "dark" if background <= 8 else "light"


def next_animation_tick(last_tick):
    if last_tick is None:
        return 0
    return (last_tick + 1) % len(ACTIVITY_LEVEL_SEQUENCE)


def animate_status(socket_name, fps):
    owner = uuid.uuid4().hex
    try:
        run_tmux(
            socket_name,
            "set-environment",
            "-g",
            ANIMATOR_OWNER_ENVIRONMENT,
            owner,
        )
    except subprocess.CalledProcessError:
        return

    busy = False
    last_tick = None
    color_scheme = None
    next_probe = 0.0
    next_scheme_probe = 0.0
    next_tick_at = 0.0
    while True:
        now = time.monotonic()
        try:
            if now >= next_probe:
                current_owner, busy = animation_probe(socket_name)
                if current_owner != owner:
                    return
                next_probe = now + (1.0 if busy else 0.25)
                if not busy:
                    last_tick = None
                    next_tick_at = 0.0

            if now >= next_scheme_probe:
                detected_scheme = detect_color_scheme()
                if detected_scheme != color_scheme:
                    run_tmux(
                        socket_name,
                        "set-option",
                        "-g",
                        COLOR_SCHEME_OPTION,
                        detected_scheme,
                    )
                    color_scheme = detected_scheme
                    invalidate_cache(socket_name)
                next_scheme_probe = now + 5.0

            if busy:
                frame_now = time.monotonic()
                if last_tick is None or frame_now >= next_tick_at:
                    tick = next_animation_tick(last_tick)
                    run_tmux(
                        socket_name,
                        "set-option",
                        "-g",
                        ANIMATION_TICK_OPTION,
                        str(tick),
                    )
                    last_tick = tick
                    # Schedule from the frame actually rendered. If another
                    # probe stalls briefly, stretch that frame instead of
                    # jumping over intermediate breathing levels to catch up.
                    next_tick_at = time.monotonic() + (1 / fps)
                wake_at = min(next_probe, next_tick_at, next_scheme_probe)
            else:
                wake_at = min(next_probe, next_scheme_probe)
        except (subprocess.CalledProcessError, ActivityError):
            return

        time.sleep(max(0.01, wake_at - time.monotonic()))


def run_animation_with_error_log(
    socket_name,
    fps,
    error_log,
    animator=None,
):
    if animator is None:
        animator = animate_status
    try:
        animator(socket_name, fps)
    except Exception:
        crash_text = traceback.format_exc()
        expanded_log = os.path.abspath(os.path.expanduser(error_log))
        timestamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        try:
            os.makedirs(os.path.dirname(expanded_log), exist_ok=True)
            with open(expanded_log, "a", encoding="utf-8") as handle:
                handle.write(
                    f"[{timestamp}] tmux-window-wrap animator crashed\n"
                )
                handle.write(crash_text)
                if not crash_text.endswith("\n"):
                    handle.write("\n")
        except OSError as log_error:
            sys.stderr.write(
                "tmux-window-wrap could not write animator crash log "
                f"{expanded_log}: {log_error}\n"
            )
            sys.stderr.write(crash_text)


def invalidate_cache(socket_name):
    run_tmux(
        socket_name,
        "set-environment",
        "-g",
        "TMUX_WINDOW_WRAP_GENERATION",
        uuid.uuid4().hex,
    )
    if not tmux_has_sessions(socket_name):
        return
    reconcile_status_heights(socket_name)
    refresh_clients(socket_name)


def update_pane_activity(
    socket_name,
    pane_id,
    state,
    hook_event_name="",
    hook_source="",
    hook_payload=None,
    environment=None,
):
    if environment is None:
        environment = os.environ
    controller = activity_controller(socket_name, environment)
    return controller.report(
        pane_id,
        state,
        hook_payload,
        hook_event_name=hook_event_name,
        hook_source=hook_source,
    )


def read_hook_payload(input_stream):
    if input_stream.isatty():
        return {}
    try:
        payload = json.load(input_stream)
    except (OSError, ValueError):
        return {}
    return payload if isinstance(payload, dict) else {}


def reconcile_status_heights(socket_name):
    completed = run_tmux(
        socket_name,
        "list-sessions",
        "-F",
        WINDOW_SEPARATOR.join(("#{session_id}", "#{session_attached}")),
    )
    for record in completed.stdout.splitlines():
        session_id, attached = record.split(WINDOW_SEPARATOR, 1)
        if attached == "0":
            continue
        widths = run_tmux(
            socket_name,
            "display-message",
            "-p",
            "-t",
            session_id,
            STATUS_WIDTH_FORMAT,
        ).stdout.strip()
        left_width, right_width = (
            int(value) for value in widths.split(WINDOW_SEPARATOR)
        )
        payload = load_tmux_payload(
            argparse.Namespace(
                session_id=session_id,
                width=1,
                left_width=left_width,
                right_width=right_width,
                socket_name=socket_name,
            )
        )
        update_status_height(payload, session_id, socket_name)


def load_tmux_payload(arguments):
    completed = run_tmux(
        arguments.socket_name,
        "list-windows",
        "-t",
        arguments.session_id,
        "-F",
        WINDOW_FORMAT,
    )
    windows = []
    active_id = None
    for record in completed.stdout.removesuffix("\n").split("\n"):
        (
            window_id,
            index,
            name,
            active,
            synchronized,
            pane_activity_flags,
            variation_selector_always_wide,
            label_width,
        ) = record.split(WINDOW_SEPARATOR, 7)
        is_synchronized = synchronized == "1"
        label = f" {index}:{name}"
        if is_synchronized:
            label += " ▶"
        label += " "
        measured_width = int(label_width)
        if variation_selector_always_wide != "0":
            measured_width += vs16_width_adjustment(label)
        windows.append(
            {
                "id": window_id,
                "index": index,
                "name": name,
                "label": label,
                "display_width": measured_width,
                "synchronized": is_synchronized,
                # The pane iterator emits one 0/1 activity flag per pane.
                "pane_count": len(pane_activity_flags),
                "busy_activity_count": pane_activity_flags.count("1"),
            }
        )
        if active == "1":
            active_id = window_id

    return {
        "width": narrowest_client_width(
            arguments.session_id,
            arguments.socket_name,
            arguments.width,
        ),
        "left_width": arguments.left_width,
        "right_width": arguments.right_width,
        "animation_tick": (
            getattr(arguments, "animation_tick", None)
            if getattr(arguments, "animation_tick", None) is not None
            else int(
                time.monotonic()
                * getattr(
                    arguments,
                    "animation_fps",
                    DEFAULT_ACTIVITY_FPS,
                )
            )
        ),
        "animation_option": getattr(arguments, "animation_option", None),
        "color_scheme": getattr(arguments, "color_scheme", "light"),
        "color_scheme_option": getattr(
            arguments,
            "color_scheme_option",
            None,
        ),
        "pane_count_style": (
            getattr(arguments, "pane_count_style", None)
            or DEFAULT_PANE_COUNT_STYLE
        ),
        "pane_count_text_style": (
            getattr(arguments, "pane_count_text_style", None) or ""
        ),
        "pane_count_active_text_style": (
            getattr(arguments, "pane_count_active_text_style", None) or ""
        ),
        "activity_palettes": {
            "light": {
                "inactive": getattr(
                    arguments,
                    "light_inactive_palette",
                    DEFAULT_ACTIVITY_PALETTES["light"]["inactive"],
                ),
                "active": getattr(
                    arguments,
                    "light_active_palette",
                    DEFAULT_ACTIVITY_PALETTES["light"]["active"],
                ),
            },
            "dark": {
                "inactive": getattr(
                    arguments,
                    "dark_inactive_palette",
                    DEFAULT_ACTIVITY_PALETTES["dark"]["inactive"],
                ),
                "active": getattr(
                    arguments,
                    "dark_active_palette",
                    DEFAULT_ACTIVITY_PALETTES["dark"]["active"],
                ),
            },
        },
        "active": active_id,
        "windows": windows,
    }


def update_status_height(payload, session_id, socket_name):
    line_count = plan(payload)["line_count"]
    desired = "on" if line_count == 1 else str(line_count)
    current = run_tmux(
        socket_name,
        "show-options",
        "-t",
        session_id,
        "-v",
        "status",
    ).stdout.strip()
    if current == "off":
        return
    if current != desired:
        run_tmux(socket_name, "set-option", "-t", session_id, "status", desired)


def main():
    parser = argparse.ArgumentParser(prog="tmux-window-wrap")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("plan")
    invalidate_parser = commands.add_parser("invalidate")
    invalidate_parser.add_argument("--socket-name")
    pane_agent_parser = commands.add_parser("pane-agent-status")
    pane_agent_parser.add_argument("--pane", default=os.environ.get("TMUX_PANE"))
    pane_agent_parser.add_argument("--socket-name")
    activity_parser = commands.add_parser("activity")
    activity_parser.add_argument("state", choices=("busy", "idle"))
    activity_parser.add_argument("--pane", default=os.environ.get("TMUX_PANE"))
    activity_parser.add_argument("--socket-name")
    animate_parser = commands.add_parser("animate")
    animate_parser.add_argument(
        "--fps",
        type=float,
        default=DEFAULT_ACTIVITY_FPS,
    )
    animate_parser.add_argument("--error-log")
    animate_parser.add_argument("--socket-name")
    render_parser = commands.add_parser("render")
    render_parser.add_argument(
        "--line",
        type=int,
        choices=range(MAX_STATUS_LINES),
        required=True,
    )
    render_parser.add_argument("--session-id")
    render_parser.add_argument("--width", type=int)
    render_parser.add_argument("--left-width", type=int)
    render_parser.add_argument("--right-width", type=int)
    render_parser.add_argument("--animation-tick", type=int)
    render_parser.add_argument(
        "--animation-fps",
        type=float,
        default=DEFAULT_ACTIVITY_FPS,
    )
    render_parser.add_argument("--animation-option")
    render_parser.add_argument(
        "--color-scheme",
        choices=("light", "dark"),
        default="light",
    )
    render_parser.add_argument("--color-scheme-option")
    render_parser.add_argument(
        "--pane-count-style",
        choices=PANE_COUNT_STYLES,
    )
    render_parser.add_argument("--pane-count-text-style")
    render_parser.add_argument("--pane-count-active-text-style")
    render_parser.add_argument(
        "--light-inactive-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["light"]["inactive"],
    )
    render_parser.add_argument(
        "--light-active-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["light"]["active"],
    )
    render_parser.add_argument(
        "--dark-inactive-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["dark"]["inactive"],
    )
    render_parser.add_argument(
        "--dark-active-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["dark"]["active"],
    )
    render_parser.add_argument("--store-option")
    render_parser.add_argument("--socket-name")
    arguments = parser.parse_args()
    if (
        arguments.command == "render"
        and arguments.animation_fps <= 0
    ):
        parser.error("--animation-fps must be greater than zero")
    if arguments.command == "animate" and arguments.fps <= 0:
        parser.error("--fps must be greater than zero")
    if arguments.command == "activity" and not arguments.pane:
        return
    if arguments.command == "plan":
        json.dump(plan(json.load(sys.stdin)), sys.stdout, separators=(",", ":"))
        sys.stdout.write("\n")
        return

    if arguments.command == "invalidate":
        invalidate_cache(arguments.socket_name)
        return

    if arguments.command == "pane-agent-status":
        print(pane_agent_status(arguments.socket_name, arguments.pane))
        return

    if arguments.command == "activity":
        hook_payload = read_hook_payload(sys.stdin)
        hook_event_name = hook_payload.get("hook_event_name", "")
        hook_source = hook_payload.get("source", "")
        try:
            update_pane_activity(
                arguments.socket_name,
                arguments.pane,
                arguments.state,
                hook_event_name=hook_event_name,
                hook_source=hook_source,
                hook_payload=hook_payload,
            )
        except ValueError as error:
            parser.error(str(error))
        return

    if arguments.command == "animate":
        if arguments.error_log:
            run_animation_with_error_log(
                arguments.socket_name,
                arguments.fps,
                arguments.error_log,
            )
        else:
            animate_status(arguments.socket_name, arguments.fps)
        return

    if arguments.session_id:
        missing = [
            name
            for name in ("width", "left_width", "right_width")
            if getattr(arguments, name) is None
        ]
        if missing:
            parser.error(
                "runtime render requires --width, --left-width and --right-width"
            )
        payload = load_tmux_payload(arguments)
        if arguments.line == 0:
            update_status_height(
                payload,
                arguments.session_id,
                arguments.socket_name,
            )
    else:
        payload = json.load(sys.stdin)
        for key in (
            "pane_count_style",
            "pane_count_text_style",
            "pane_count_active_text_style",
        ):
            value = getattr(arguments, key)
            if value is not None:
                payload[key] = value
    rendered = render(payload, arguments.line)
    if arguments.store_option:
        if not arguments.session_id:
            parser.error("--store-option requires --session-id")
        run_tmux(
            arguments.socket_name,
            "set-option",
            "-t",
            arguments.session_id,
            arguments.store_option,
            rendered,
        )
        sys.stdout.write("\n")
        return
    sys.stdout.write(rendered + "\n")


if __name__ == "__main__":
    main()
