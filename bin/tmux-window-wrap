WINDOW_FORMAT = WINDOW_SEPARATOR.join(
    (
        "#{window_id}",
        "#{window_index}",
        "#{window_name}",
        "#{window_active}",
        "#{pane_synchronized}",
        BUSY_PANES_FORMAT,
        "#{variation-selector-always-wide}",
