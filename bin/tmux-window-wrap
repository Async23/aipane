    return activity_domain.load_grok_session_states(
        ttys,
        environment,
        process_exists or process_is_running,
        process_tty_lookup or process_tty,
    )


def _repair_pane_activity_unlocked(socket_name, pane, view):
    (
        _attached,
        _target,
        pane_id,
        _pane_tty,
        marker,
        owner,
        marker_updated_at,
        _reporter,
        record,
        _socket_path,
        _server_pid,
    ) = pane
    current_record = run_tmux(
        socket_name,
        "show-options",
        "-p",
        "-q",
        "-v",
        "-t",
        pane_id,
        PANE_ACTIVITY_RECORD_OPTION,
    ).stdout.strip()
    current_marker = run_tmux(
        socket_name,
        "show-options",
        "-p",
        "-q",
        "-v",
        "-t",
        pane_id,
        PANE_ACTIVITY_OPTION,
    ).stdout.strip()
    current_updated_at = run_tmux(
        socket_name,
        "show-options",
        "-p",
        "-q",
        "-v",
        "-t",
        pane_id,
        PANE_ACTIVITY_UPDATED_AT_OPTION,
    ).stdout.strip()
    current_identity = run_tmux(
        socket_name,
        "display-message",
        "-p",
        "-t",
        pane_id,
        WINDOW_SEPARATOR.join(
            (
                "#{pane_current_command}",
                "#{pane_tty}",
                "#{socket_path}",
                "#{pid}",
            )
        ),
    ).stdout.strip()
    expected_identity = WINDOW_SEPARATOR.join(
        (owner, _pane_tty, _socket_path, _server_pid)
    )
    if (
        current_record != record
        or current_marker != marker
        or current_updated_at != marker_updated_at
        or current_identity != expected_identity
    ):
        return False

    fresh = AgentActivity().resolve(
        PaneActivity(
            pane_id=pane_id,
            current_command=owner,
            target=_target,
            pane_tty=_pane_tty,
            socket_path=_socket_path,
            server_pid=_server_pid,
            marker=current_marker,
            reporter=_reporter,
            marker_updated_at=current_updated_at,
            record=current_record,
        )
    )
    if (
        fresh.state != view.state
        or fresh.evidence_turn_id != getattr(view, "evidence_turn_id", "")
        or not fresh.repairable
    ):
        return False

    run_tmux(
        socket_name,
        "set-option",
        "-p",
        "-t",
        pane_id,
        PANE_ACTIVITY_RECORD_OPTION,
        fresh.repair_record,
    )
    if view.state == "idle":
        if current_marker:
            run_tmux(
                socket_name,
                "set-option",
                "-p",
                "-u",
                "-t",
                pane_id,
                PANE_ACTIVITY_OPTION,
            )
        if current_updated_at:
            run_tmux(
                socket_name,
                "set-option",
                "-p",
                "-u",
                "-t",
                pane_id,
                PANE_ACTIVITY_UPDATED_AT_OPTION,
            )
    elif view.state == "busy" and current_marker != owner:
        run_tmux(
            socket_name,
            "set-option",
            "-p",
            "-t",
            pane_id,
            PANE_ACTIVITY_UPDATED_AT_OPTION,
            str(time.time_ns() // 1_000_000),
        )
        run_tmux(
            socket_name,
            "set-option",
            "-p",
            "-t",
            pane_id,
            PANE_ACTIVITY_OPTION,
            owner,
        )
    return True


def repair_pane_activity(socket_name, pane, view, environment=None):
    if environment is None:
        environment = os.environ
    with pane_activity_lock(socket_name, pane[2], environment):
        return _repair_pane_activity_unlocked(socket_name, pane, view)


def animation_probe(socket_name):
    try:
        completed = run_tmux(
            socket_name,
            "list-panes",
            "-a",
            "-F",
            WINDOW_SEPARATOR.join(
                (
                    f"#{{{ANIMATOR_OWNER_ENVIRONMENT}}}",
                    "#{session_attached}",
                    "#{session_name}:#{window_id}.#{pane_id}",
                    "#{pane_id}",
                    "#{pane_tty}",
                    PANE_ACTIVITY_REFERENCE,
                    "#{pane_current_command}",
                    "#{" + PANE_ACTIVITY_UPDATED_AT_OPTION + "}",
                    "#{" + PANE_ACTIVITY_REPORTER_OPTION + "}",
                    "#{" + PANE_ACTIVITY_RECORD_OPTION + "}",
                    "#{socket_path}",
                    "#{pid}",
                )
            ),
        )
    except subprocess.CalledProcessError as pane_error:
        if tmux_has_sessions(socket_name):
            raise pane_error
        return (
            global_environment_value(
                socket_name,
                ANIMATOR_OWNER_ENVIRONMENT,
            ),
            False,
        )
    records = completed.stdout.splitlines()
    if not records:
        return (
            global_environment_value(
                socket_name,
                ANIMATOR_OWNER_ENVIRONMENT,
            ),
            False,
        )

    owner = None
    panes = []
    for record in records:
        fields = record.split(WINDOW_SEPARATOR)
        if len(fields) == 8:
            fields.extend(("", "", "", ""))
        if len(fields) != 12:
            continue
        (
            record_owner,
            attached,
            target,
            pane_id,
            pane_tty,
            activity_source,
            current_command,
            marker_updated_at,
            activity_reporter,
            activity_record,
            socket_path,
            server_pid,
        ) = fields
        panes.append(
            (
                attached,
                target,
                pane_id,
                pane_tty,
                activity_source,
                current_command,
                marker_updated_at,
                activity_reporter,
                activity_record,
                socket_path,
                server_pid,
            )
        )
        if owner is None:
            owner = record_owner

    busy = False
    cleared = False
    marked_panes = [
        pane
        for pane in panes
        if pane[0] != "0" and pane[4] and pane[4] == pane[5]
    ]
    claude_states = (
        load_claude_session_states({pane[1] for pane in marked_panes})
        if marked_panes
        else {}
    )
    marked_grok_ttys = {
        pane[3].removeprefix("/dev/")
        for pane in marked_panes
        if is_grok_command(pane[5])
    }
    grok_states = (
        load_grok_session_states(marked_grok_ttys)
        if marked_grok_ttys
        else {}
    )
    activity_resolver = AgentActivity()
    for pane in panes:
        (
            attached,
            target,
            pane_id,
            pane_tty,
            activity_source,
            current_command,
            marker_updated_at,
            activity_reporter,
            activity_record,
            socket_path,
            server_pid,
        ) = pane
        marked_busy = (
            bool(activity_source)
            and activity_source == current_command
        )
        repair_candidate = attached != "0" and (
            (
                is_codex_command(current_command)
                and (
                    marked_busy
                    or bool(activity_record)
                    or activity_reporter == current_command
                )
            )
            or (
                is_kimi_command(current_command)
                and marked_busy
                and bool(activity_record)
            )
        )
        if repair_candidate:
            view = activity_resolver.resolve(
                PaneActivity(
                    pane_id=pane_id,
                    current_command=current_command,
                    target=target,
                    pane_tty=pane_tty,
                    socket_path=socket_path,
                    server_pid=server_pid,
                    marker=activity_source,
                    reporter=activity_reporter,
                    marker_updated_at=marker_updated_at,
                    record=activity_record,
                )
            )
            if view.repairable:
                candidate = (
                    view.state,
                    activity_record,
                    marker_updated_at,
                    view.evidence_turn_id,
                    view.reason,
                )
                if ACTIVITY_REPAIR_CANDIDATES.get(pane_id) == candidate:
                    try:
                        repaired = repair_pane_activity(
                            socket_name,
                            pane,
                            view,
                        )
                    except subprocess.CalledProcessError:
                        repaired = False
                    if repaired:
                        ACTIVITY_REPAIR_CANDIDATES.pop(pane_id, None)
                        cleared = True
                        if view.state == "busy":
                            busy = True
                        continue
                else:
                    ACTIVITY_REPAIR_CANDIDATES[pane_id] = candidate
                if view.state == "busy" or marked_busy:
                    busy = True
                continue
            ACTIVITY_REPAIR_CANDIDATES.pop(pane_id, None)
            if view.state == "busy" or (
                view.state == "unknown" and marked_busy
            ):
                busy = True
            continue
        ACTIVITY_REPAIR_CANDIDATES.pop(pane_id, None)
        if attached != "0" and marked_busy:
            if claude_idle_supersedes_marker(
                claude_states.get(target),
                current_command,
                pane_tty,
                marker_updated_at,
            ) or grok_idle_supersedes_marker(
                grok_states.get(pane_tty.removeprefix("/dev/")),
                current_command,
                pane_tty,
                marker_updated_at,
            ):
                try:
                    run_tmux(
                        socket_name,
                        "set-option",
                        "-p",
                        "-u",
                        "-t",
                        pane_id,
                        PANE_ACTIVITY_OPTION,
                    )
                except subprocess.CalledProcessError:
                    # The pane may disappear between list-panes and cleanup.
                    # Keep the animator alive; the next probe sees fresh state.
                    continue
                cleared = True
                if marker_updated_at:
                    try:
                        run_tmux(
                            socket_name,
                            "set-option",
                            "-p",
                            "-u",
                            "-t",
                            pane_id,
                            PANE_ACTIVITY_UPDATED_AT_OPTION,
                        )
                    except subprocess.CalledProcessError:
                        pass
            else:
                busy = True
    if cleared:
        invalidate_cache(socket_name)
    return owner, busy


def detect_color_scheme():
    if sys.platform == "darwin":
        try:
            completed = subprocess.run(
                ["defaults", "read", "-g", "AppleInterfaceStyle"],
                text=True,
                capture_output=True,
                check=False,
            )
        except OSError:
            return "light"
        return "dark" if completed.stdout.strip().lower() == "dark" else "light"

    colorfgbg = os.environ.get("COLORFGBG", "")
    try:
        background = int(colorfgbg.rsplit(";", 1)[-1])
    except ValueError:
        return "light"
    return "dark" if background <= 8 else "light"


def next_animation_tick(last_tick):
    if last_tick is None:
        return 0
    return (last_tick + 1) % len(ACTIVITY_LEVEL_SEQUENCE)


def animate_status(socket_name, fps):
    owner = uuid.uuid4().hex
    try:
        run_tmux(
            socket_name,
            "set-environment",
            "-g",
            ANIMATOR_OWNER_ENVIRONMENT,
            owner,
        )
    except subprocess.CalledProcessError:
        return

    busy = False
    last_tick = None
    color_scheme = None
    next_probe = 0.0
    next_scheme_probe = 0.0
    next_tick_at = 0.0
    while True:
        now = time.monotonic()
        try:
            if now >= next_probe:
                current_owner, busy = animation_probe(socket_name)
                if current_owner != owner:
                    return
                next_probe = now + (1.0 if busy else 0.25)
                if not busy:
                    last_tick = None
                    next_tick_at = 0.0

            if now >= next_scheme_probe:
                detected_scheme = detect_color_scheme()
                if detected_scheme != color_scheme:
                    run_tmux(
                        socket_name,
                        "set-option",
                        "-g",
                        COLOR_SCHEME_OPTION,
                        detected_scheme,
                    )
                    color_scheme = detected_scheme
                    invalidate_cache(socket_name)
                next_scheme_probe = now + 5.0

            if busy:
                frame_now = time.monotonic()
                if last_tick is None or frame_now >= next_tick_at:
                    tick = next_animation_tick(last_tick)
                    run_tmux(
                        socket_name,
                        "set-option",
                        "-g",
                        ANIMATION_TICK_OPTION,
                        str(tick),
                    )
                    last_tick = tick
                    # Schedule from the frame actually rendered. If another
                    # probe stalls briefly, stretch that frame instead of
                    # jumping over intermediate breathing levels to catch up.
                    next_tick_at = time.monotonic() + (1 / fps)
                wake_at = min(next_probe, next_tick_at, next_scheme_probe)
            else:
                wake_at = min(next_probe, next_scheme_probe)
        except subprocess.CalledProcessError:
            return

        time.sleep(max(0.01, wake_at - time.monotonic()))


def run_animation_with_error_log(
    socket_name,
    fps,
    error_log,
    animator=None,
):
    if animator is None:
        animator = animate_status
    try:
        animator(socket_name, fps)
    except Exception:
        crash_text = traceback.format_exc()
        expanded_log = os.path.abspath(os.path.expanduser(error_log))
        timestamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        try:
            os.makedirs(os.path.dirname(expanded_log), exist_ok=True)
            with open(expanded_log, "a", encoding="utf-8") as handle:
                handle.write(
                    f"[{timestamp}] tmux-window-wrap animator crashed\n"
                )
                handle.write(crash_text)
                if not crash_text.endswith("\n"):
                    handle.write("\n")
        except OSError as log_error:
            sys.stderr.write(
                "tmux-window-wrap could not write animator crash log "
                f"{expanded_log}: {log_error}\n"
            )
            sys.stderr.write(crash_text)


def invalidate_cache(socket_name):
    run_tmux(
        socket_name,
        "set-environment",
        "-g",
        "TMUX_WINDOW_WRAP_GENERATION",
        uuid.uuid4().hex,
    )
    if not tmux_has_sessions(socket_name):
        return
    reconcile_status_heights(socket_name)
    refresh_clients(socket_name)


def _update_pane_activity_unlocked(
    socket_name,
    pane_id,
    state,
    hook_event_name="",
    hook_source="",
    hook_payload=None,
    environment=None,
):
    if environment is None:
        environment = os.environ
    current_activity = run_tmux(
        socket_name,
        "show-options",
        "-p",
        "-q",
        "-v",
        "-t",
        pane_id,
        PANE_ACTIVITY_OPTION,
    ).stdout.strip()
    current_reporter = run_tmux(
        socket_name,
        "show-options",
        "-p",
        "-q",
        "-v",
        "-t",
        pane_id,
        PANE_ACTIVITY_REPORTER_OPTION,
    ).stdout.strip()
    current_updated_at = run_tmux(
        socket_name,
        "show-options",
        "-p",
        "-q",
        "-v",
        "-t",
        pane_id,
        PANE_ACTIVITY_UPDATED_AT_OPTION,
    ).stdout.strip()
    current_record = run_tmux(
        socket_name,
        "show-options",
        "-p",
        "-q",
        "-v",
        "-t",
        pane_id,
        PANE_ACTIVITY_RECORD_OPTION,
    ).stdout.strip()
    pane_identity = run_tmux(
        socket_name,
        "display-message",
        "-p",
        "-t",
        pane_id,
        WINDOW_SEPARATOR.join(
            (
                "#{pane_current_command}",
                "#{pane_tty}",
                "#{socket_path}",
                "#{pid}",
            )
        ),
    ).stdout.strip()
    identity_fields = pane_identity.split(WINDOW_SEPARATOR, 3)
    owner = identity_fields[0] if identity_fields else ""
    pane_tty = identity_fields[1] if len(identity_fields) > 1 else ""
    socket_path = identity_fields[2] if len(identity_fields) > 2 else ""
    server_pid = identity_fields[3] if len(identity_fields) > 3 else ""
    if not owner:
        raise ValueError(f"pane {pane_id} has no current command")
    if not isinstance(hook_payload, dict):
        hook_payload = {}
    if not hook_event_name:
        value = hook_payload.get("hook_event_name", "")
        hook_event_name = value if isinstance(value, str) else ""
    if not hook_source:
        value = hook_payload.get("source", "")
        hook_source = value if isinstance(value, str) else ""
    if ignore_early_codex_idle(
        state,
        hook_event_name,
        hook_source,
        owner,
        environment,
    ):
        return
    pane = PaneActivity(
        pane_id=pane_id,
        current_command=owner,
        pane_tty=pane_tty,
        socket_path=socket_path,
        server_pid=server_pid,
        marker=current_activity,
        reporter=current_reporter,
        marker_updated_at=current_updated_at,
        record=current_record,
    )
    report = AgentActivity(environment=environment).report(
        pane,
        state,
        hook_payload,
    )
    if not report.accepted:
        return
    state = report.state
    desired_activity = owner if state == "busy" else ""

    if report.record != current_record:
        # The versioned record is the safety truth. Compatibility/display
        # options are projected only after this write succeeds.
        run_tmux(
            socket_name,
            "set-option",
            "-p",
            "-t",
            pane_id,
            PANE_ACTIVITY_RECORD_OPTION,
            report.record,
        )

    if state == "busy":
        run_tmux(
            socket_name,
            "set-option",
            "-p",
            "-t",
            pane_id,
            PANE_ACTIVITY_UPDATED_AT_OPTION,
            str(time.time_ns() // 1_000_000),
        )
    elif current_updated_at:
        run_tmux(
            socket_name,
            "set-option",
            "-p",
            "-u",
            "-t",
            pane_id,
            PANE_ACTIVITY_UPDATED_AT_OPTION,
        )

    if current_activity == desired_activity and current_reporter == owner:
        # A repeated busy report starts a new turn. Refresh even when the marker
        # value is unchanged so a cached/stale status job is woken immediately.
        # PreToolUse is only a fallback for internal Codex work and can fire many
        # times in one turn, so it must not repeatedly rerender the statusline.
        if state == "busy" and hook_event_name != "PreToolUse":
            invalidate_cache(socket_name)
        return
    if current_reporter != owner:
        run_tmux(
            socket_name,
            "set-option",
            "-p",
            "-t",
            pane_id,
            PANE_ACTIVITY_REPORTER_OPTION,
            owner,
        )
    if current_activity == desired_activity:
        return
    if desired_activity:
        run_tmux(
            socket_name,
            "set-option",
            "-p",
            "-t",
            pane_id,
            PANE_ACTIVITY_OPTION,
            desired_activity,
        )
    else:
        run_tmux(
            socket_name,
            "set-option",
            "-p",
            "-u",
            "-t",
            pane_id,
            PANE_ACTIVITY_OPTION,
        )
    invalidate_cache(socket_name)


def update_pane_activity(
    socket_name,
    pane_id,
    state,
    hook_event_name="",
    hook_source="",
    hook_payload=None,
    environment=None,
):
    if environment is None:
        environment = os.environ
    with pane_activity_lock(socket_name, pane_id, environment):
        return _update_pane_activity_unlocked(
            socket_name,
            pane_id,
            state,
            hook_event_name=hook_event_name,
            hook_source=hook_source,
            hook_payload=hook_payload,
            environment=environment,
        )


def ignore_early_codex_idle(
    state,
    hook_event_name,
    hook_source,
    owner,
    environment,
):
    is_early_event = hook_event_name == "Stop" or (
        hook_event_name == "SessionStart" and hook_source == "compact"
    )
    return (
        state == "idle"
        and environment.get("TMUX_WINDOW_WRAP_ALLOW_CODEX_STOP_IDLE") != "1"
        and is_early_event
        and (owner == "codex" or owner.startswith("codex-"))
    )


def read_hook_payload(input_stream):
    if input_stream.isatty():
        return {}
    try:
        payload = json.load(input_stream)
    except (OSError, ValueError):
        return {}
    return payload if isinstance(payload, dict) else {}


def read_hook_context(input_stream):
    payload = read_hook_payload(input_stream)
    hook_event_name = payload.get("hook_event_name", "")
    hook_source = payload.get("source", "")
    return (
        hook_event_name if isinstance(hook_event_name, str) else "",
        hook_source if isinstance(hook_source, str) else "",
    )


def reconcile_status_heights(socket_name):
    completed = run_tmux(
        socket_name,
        "list-sessions",
        "-F",
        WINDOW_SEPARATOR.join(("#{session_id}", "#{session_attached}")),
    )
    for record in completed.stdout.splitlines():
        session_id, attached = record.split(WINDOW_SEPARATOR, 1)
        if attached == "0":
            continue
        widths = run_tmux(
            socket_name,
            "display-message",
            "-p",
            "-t",
            session_id,
            STATUS_WIDTH_FORMAT,
        ).stdout.strip()
        left_width, right_width = (
            int(value) for value in widths.split(WINDOW_SEPARATOR)
        )
        payload = load_tmux_payload(
            argparse.Namespace(
                session_id=session_id,
                width=1,
                left_width=left_width,
                right_width=right_width,
                socket_name=socket_name,
            )
        )
        update_status_height(payload, session_id, socket_name)


def load_tmux_payload(arguments):
    completed = run_tmux(
        arguments.socket_name,
        "list-windows",
        "-t",
        arguments.session_id,
        "-F",
        WINDOW_FORMAT,
    )
    windows = []
    active_id = None
    for record in completed.stdout.removesuffix("\n").split("\n"):
        (
            window_id,
            index,
            name,
            active,
            synchronized,
            pane_activity_flags,
            label_width,
        ) = record.split(WINDOW_SEPARATOR, 6)
        is_synchronized = synchronized == "1"
        label = f" {index}:{name}"
        if is_synchronized:
            label += " ▶"
        label += " "
        windows.append(
            {
                "id": window_id,
                "index": index,
                "name": name,
                "label": label,
                "display_width": int(label_width),
                "synchronized": is_synchronized,
                # The pane iterator emits one 0/1 activity flag per pane.
                "pane_count": len(pane_activity_flags),
                "busy_activity_count": pane_activity_flags.count("1"),
            }
        )
        if active == "1":
            active_id = window_id

    return {
        "width": narrowest_client_width(
            arguments.session_id,
            arguments.socket_name,
            arguments.width,
        ),
        "left_width": arguments.left_width,
        "right_width": arguments.right_width,
        "animation_tick": (
            getattr(arguments, "animation_tick", None)
            if getattr(arguments, "animation_tick", None) is not None
            else int(
                time.monotonic()
                * getattr(
                    arguments,
                    "animation_fps",
                    DEFAULT_ACTIVITY_FPS,
                )
            )
        ),
        "animation_option": getattr(arguments, "animation_option", None),
        "color_scheme": getattr(arguments, "color_scheme", "light"),
        "color_scheme_option": getattr(
            arguments,
            "color_scheme_option",
            None,
        ),
        "pane_count_style": (
            getattr(arguments, "pane_count_style", None)
            or DEFAULT_PANE_COUNT_STYLE
        ),
        "activity_palettes": {
            "light": {
                "inactive": getattr(
                    arguments,
                    "light_inactive_palette",
                    DEFAULT_ACTIVITY_PALETTES["light"]["inactive"],
                ),
                "active": getattr(
                    arguments,
                    "light_active_palette",
                    DEFAULT_ACTIVITY_PALETTES["light"]["active"],
                ),
            },
            "dark": {
                "inactive": getattr(
                    arguments,
                    "dark_inactive_palette",
                    DEFAULT_ACTIVITY_PALETTES["dark"]["inactive"],
                ),
                "active": getattr(
                    arguments,
                    "dark_active_palette",
                    DEFAULT_ACTIVITY_PALETTES["dark"]["active"],
                ),
            },
        },
        "active": active_id,
        "windows": windows,
    }


def update_status_height(payload, session_id, socket_name):
    line_count = plan(payload)["line_count"]
    desired = "on" if line_count == 1 else str(line_count)
    current = run_tmux(
        socket_name,
        "show-options",
        "-t",
        session_id,
        "-v",
        "status",
    ).stdout.strip()
    if current == "off":
        return
    if current != desired:
        run_tmux(socket_name, "set-option", "-t", session_id, "status", desired)


def main():
    parser = argparse.ArgumentParser(prog="tmux-window-wrap")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("plan")
    invalidate_parser = commands.add_parser("invalidate")
    invalidate_parser.add_argument("--socket-name")
    activity_parser = commands.add_parser("activity")
    activity_parser.add_argument("state", choices=("busy", "idle"))
    activity_parser.add_argument("--pane", default=os.environ.get("TMUX_PANE"))
    activity_parser.add_argument("--socket-name")
    animate_parser = commands.add_parser("animate")
    animate_parser.add_argument(
        "--fps",
        type=float,
        default=DEFAULT_ACTIVITY_FPS,
    )
    animate_parser.add_argument("--error-log")
    animate_parser.add_argument("--socket-name")
    render_parser = commands.add_parser("render")
    render_parser.add_argument(
        "--line",
        type=int,
        choices=range(MAX_STATUS_LINES),
        required=True,
    )
    render_parser.add_argument("--session-id")
    render_parser.add_argument("--width", type=int)
    render_parser.add_argument("--left-width", type=int)
    render_parser.add_argument("--right-width", type=int)
    render_parser.add_argument("--animation-tick", type=int)
    render_parser.add_argument(
        "--animation-fps",
        type=float,
        default=DEFAULT_ACTIVITY_FPS,
    )
    render_parser.add_argument("--animation-option")
    render_parser.add_argument(
        "--color-scheme",
        choices=("light", "dark"),
        default="light",
    )
    render_parser.add_argument("--color-scheme-option")
    render_parser.add_argument(
        "--pane-count-style",
        choices=PANE_COUNT_STYLES,
    )
    render_parser.add_argument(
        "--light-inactive-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["light"]["inactive"],
    )
    render_parser.add_argument(
        "--light-active-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["light"]["active"],
    )
    render_parser.add_argument(
        "--dark-inactive-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["dark"]["inactive"],
    )
    render_parser.add_argument(
        "--dark-active-palette",
        type=parse_palette,
        default=DEFAULT_ACTIVITY_PALETTES["dark"]["active"],
    )
    render_parser.add_argument("--store-option")
    render_parser.add_argument("--socket-name")
    arguments = parser.parse_args()
    if (
        arguments.command == "render"
        and arguments.animation_fps <= 0
    ):
        parser.error("--animation-fps must be greater than zero")
    if arguments.command == "animate" and arguments.fps <= 0:
        parser.error("--fps must be greater than zero")
    if arguments.command == "activity" and not arguments.pane:
        return
    if arguments.command == "plan":
        json.dump(plan(json.load(sys.stdin)), sys.stdout, separators=(",", ":"))
        sys.stdout.write("\n")
        return

    if arguments.command == "invalidate":
        invalidate_cache(arguments.socket_name)
        return

    if arguments.command == "activity":
        hook_payload = read_hook_payload(sys.stdin)
        hook_event_name = hook_payload.get("hook_event_name", "")
        hook_source = hook_payload.get("source", "")
        try:
            update_pane_activity(
                arguments.socket_name,
                arguments.pane,
                arguments.state,
                hook_event_name=hook_event_name,
                hook_source=hook_source,
                hook_payload=hook_payload,
            )
        except ValueError as error:
            parser.error(str(error))
        return

    if arguments.command == "animate":
        if arguments.error_log:
            run_animation_with_error_log(
                arguments.socket_name,
                arguments.fps,
                arguments.error_log,
            )
        else:
            animate_status(arguments.socket_name, arguments.fps)
        return

    if arguments.session_id:
        missing = [
            name
            for name in ("width", "left_width", "right_width")
            if getattr(arguments, name) is None
        ]
        if missing:
            parser.error(
                "runtime render requires --width, --left-width and --right-width"
            )
        payload = load_tmux_payload(arguments)
        if arguments.line == 0:
            update_status_height(
                payload,
                arguments.session_id,
                arguments.socket_name,
            )
    else:
        payload = json.load(sys.stdin)
        if arguments.pane_count_style is not None:
            payload["pane_count_style"] = arguments.pane_count_style
    rendered = render(payload, arguments.line)
    if arguments.store_option:
        if not arguments.session_id:
            parser.error("--store-option requires --session-id")
        run_tmux(
            arguments.socket_name,
            "set-option",
            "-t",
            arguments.session_id,
            arguments.store_option,
            rendered,
        )
        sys.stdout.write("\n")
        return
    sys.stdout.write(rendered + "\n")


if __name__ == "__main__":
    main()
