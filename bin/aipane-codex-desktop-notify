#!/opt/homebrew/bin/python3

import json
import os
import re
import secrets
import shlex
import sqlite3
import subprocess
import sys
import unicodedata
from contextlib import closing
from pathlib import Path


HOME = Path.home()
CODEX_HOME = Path(os.environ.get("CODEX_HOME") or HOME / ".codex").expanduser().resolve()
LOG_PATH = CODEX_HOME / "log" / "codex-notify.log"
CODEX_NOTIFIER_APP = str(HOME / "Applications" / "Codex Notifier.app")
CODEX_NOTIFIER = f"{CODEX_NOTIFIER_APP}/Contents/MacOS/terminal-notifier"
FOCUS_TMUX_SCRIPT = str(CODEX_HOME / "bin" / "codex-focus-tmux.sh")
CODEX_ICON_URL = f"file://{CODEX_NOTIFIER_APP}/Contents/Resources/CodexGhostty.icns"
NOTIFICATION_GROUP = "codex-agent-turn-complete-ghostty-clean"
TERMINAL_NOTIFIER = "/opt/homebrew/bin/terminal-notifier"
GHOSTTY_BUNDLE_ID = "com.mitchellh.ghostty"
GHOSTTY_ICON_URL = "file:///Applications/Ghostty.app/Contents/Resources/Ghostty.icns"
NOTIFICATION_SOUNDS = ("Glass", "Ping", "Pop", "Purr", "Submarine", "Tink")
NOTIFIER_TIMEOUT_SECONDS = 5
SUBTITLE_MAX_DISPLAY_WIDTH = 48
THREAD_TITLE_MAX_DISPLAY_WIDTH = 48
IMAGE_MARKER_RE = re.compile(r"\[\s*Image\s+#\d+\s*\]", re.IGNORECASE)
CODEX_TITLE_SPINNER_FRAMES = frozenset(
    ("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")
)
CODEX_TITLE_ACTION_PREFIXES = (
    "[ ! ] Action Required",
    "[ . ] Action Required",
)
MARKDOWN_LINK_RE = re.compile(r"\[([^\]]+)\]\([^)]+\)")
FILE_TOKEN_RE = re.compile(
    r"(?<![\w.-])(?:[\w@+.-]+/)*[\w@+.-]+\.[A-Za-z][A-Za-z0-9-]*"
)
GOAL_CONTEXT_RE = re.compile(
    r"<codex_internal_context\s+source=[\"']goal[\"']"
)


def notification_sound() -> str:
    override = os.environ.get("CODEX_NOTIFY_SOUND", "").strip()
    return override or secrets.choice(NOTIFICATION_SOUNDS)


GOAL_NOTIFICATION_TITLES = {
    "complete": "Goal 完成",
    "blocked": "Goal 需要你处理",
    "paused": "Goal 已暂停",
    "usage_limited": "Goal 用量受限",
    "budget_limited": "Goal 预算已用完",
}


def read_payload() -> dict:
    raw = ""
    if len(sys.argv) > 1 and sys.argv[1]:
        raw = sys.argv[1]
    elif not sys.stdin.isatty():
        raw = sys.stdin.read().strip()

    if not raw:
        return {}

    try:
        data = json.loads(raw)
        if isinstance(data, dict):
            return data
    except json.JSONDecodeError:
        return {"raw": raw}

    return {}


def compact_text(value: str) -> str:
    return " ".join(str(value).split())


def first_non_empty_line(value: str) -> str:
    for line in str(value).splitlines():
        text = compact_text(line)
        if text:
            return text
    return ""


def short_text(value: str, limit: int) -> str:
    text = compact_text(value)
    if not text:
        return ""
    if len(text) <= limit:
        return text
    return text[: limit - 1] + "..."


def display_width(value: str) -> int:
    width = 0
    for char in str(value):
        if unicodedata.combining(char) or unicodedata.category(char) in {
            "Mn",
            "Me",
            "Cf",
        }:
            continue
        width += 2 if unicodedata.east_asian_width(char) in {"W", "F"} else 1
    return width


def short_display_text(value: str, limit: int) -> str:
    text = compact_text(value)
    if not text or limit <= 0:
        return ""
    if display_width(text) <= limit:
        return text

    suffix = "..."
    budget = max(0, limit - display_width(suffix))
    result = []
    width = 0
    for char in text:
        char_width = display_width(char)
        if width + char_width > budget:
            break
        result.append(char)
        width += char_width
    return "".join(result) + suffix


def notification_subtitle(value: str) -> str:
    text = compact_text(value)
    had_image_marker = bool(IMAGE_MARKER_RE.search(text))
    text = compact_text(IMAGE_MARKER_RE.sub("", text))
    if not text and had_image_marker:
        text = "图片请求"
    return short_display_text(text, SUBTITLE_MAX_DISPLAY_WIDTH)


def plain_notification_text(value: str) -> str:
    text = MARKDOWN_LINK_RE.sub(r"\1", str(value))
    text = re.sub(r"^\s{0,3}#{1,6}\s*", "", text)
    text = re.sub(r"^\s*[-*+]\s+", "", text)
    text = text.replace("`", "")
    text = text.replace("**", "").replace("__", "")
    return compact_text(text)


def result_summary(value: str) -> str:
    lines = [line for line in str(value).splitlines() if line.strip()]
    if not lines:
        return ""

    line_pairs = [
        (line, plain_notification_text(line))
        for line in lines
        if plain_notification_text(line)
    ]
    if not line_pairs:
        return ""

    while len(line_pairs) > 1 and line_pairs[0][1] in {
        "结论",
        "完成内容",
        "验证结果",
        "结果",
    }:
        line_pairs.pop(0)

    first = line_pairs[0][1]
    modified = re.match(r"^已完成[，,]\s*仅修改\s*(.*?)[。.]?$", first)
    if modified:
        target = modified.group(1).strip().rstrip("：:")
        if not target:
            targets = []
            for raw_line, cleaned_line in line_pairs[1:]:
                if not re.match(r"^\s*[-*+]\s+", raw_line):
                    break
                for file_name in FILE_TOKEN_RE.findall(cleaned_line):
                    if file_name not in targets:
                        targets.append(file_name)
            if targets:
                suffix = "等" if len(targets) > 3 else ""
                target = "、".join(targets[:3]) + suffix
        if target:
            return f"已完成 {target} 改造"

    return first


def parse_source_metadata(value) -> dict:
    if isinstance(value, dict):
        return value
    if not isinstance(value, str) or not value:
        return {}
    try:
        parsed = json.loads(value)
    except json.JSONDecodeError:
        return {}
    return parsed if isinstance(parsed, dict) else {}


def infer_agent_depth(agent_path: str):
    parts = [part for part in str(agent_path).split("/") if part]
    if not parts:
        return None
    if parts[0] == "root":
        return max(0, len(parts) - 1)
    return None


def normalize_thread_metadata(row: dict) -> dict:
    source = parse_source_metadata(row.get("source"))
    subagent = source.get("subagent") or source.get("sub_agent") or {}
    thread_spawn = (
        subagent.get("thread_spawn")
        or subagent.get("threadSpawn")
        or {}
    )

    agent_path = row.get("agent_path") or thread_spawn.get("agent_path") or ""
    nickname = row.get("agent_nickname") or thread_spawn.get("agent_nickname") or ""
    role = row.get("agent_role") or thread_spawn.get("agent_role") or ""
    parent_thread_id = (
        row.get("parent_thread_id")
        or thread_spawn.get("parent_thread_id")
        or ""
    )
    depth = thread_spawn.get("depth")
    if not isinstance(depth, int):
        depth = infer_agent_depth(agent_path)

    thread_source = row.get("thread_source") or ""
    is_subagent = bool(
        thread_source == "subagent"
        or parent_thread_id
        or agent_path
        or thread_spawn
    )
    task_name = agent_path.rstrip("/").rsplit("/", 1)[-1] if agent_path else ""

    return {
        "is_subagent": is_subagent,
        "thread_source": thread_source,
        "parent_thread_id": parent_thread_id,
        "depth": depth,
        "agent_path": agent_path,
        "task_name": task_name,
        "nickname": nickname,
        "role": role,
        "model": row.get("model") or "",
        "reasoning_effort": row.get("reasoning_effort") or "",
        "rollout_path": row.get("rollout_path") or "",
    }


def query_thread_metadata(thread_id: str) -> dict:
    if not thread_id:
        return {}

    db_paths = [CODEX_HOME / "state_5.sqlite", CODEX_HOME / "sqlite" / "state_5.sqlite"]
    for db_path in db_paths:
        if not db_path.is_file():
            continue
        try:
            uri = db_path.resolve().as_uri() + "?mode=ro"
            with closing(sqlite3.connect(uri, uri=True, timeout=0.25)) as connection:
                connection.row_factory = sqlite3.Row
                try:
                    row = connection.execute(
                        """
                        SELECT
                            t.thread_source,
                            t.source,
                            t.agent_path,
                            t.agent_nickname,
                            t.agent_role,
                            t.model,
                            t.reasoning_effort,
                            t.rollout_path,
                            e.parent_thread_id
                        FROM threads AS t
                        LEFT JOIN thread_spawn_edges AS e
                          ON e.child_thread_id = t.id
                        WHERE t.id = ?
                        """,
                        (thread_id,),
                    ).fetchone()
                except sqlite3.OperationalError:
                    row = connection.execute(
                        """
                        SELECT
                            t.thread_source,
                            t.source,
                            t.agent_path,
                            t.agent_nickname,
                            t.agent_role,
                            t.model,
                            t.reasoning_effort,
                            t.rollout_path,
                            NULL AS parent_thread_id
                        FROM threads AS t
                        WHERE t.id = ?
                        """,
                        (thread_id,),
                    ).fetchone()
                if row is not None:
                    return normalize_thread_metadata(dict(row))
        except (OSError, sqlite3.Error):
            continue
    return {}


def query_root_thread_title(thread_id: str) -> str:
    if not thread_id:
        return ""

    db_paths = [CODEX_HOME / "state_5.sqlite", CODEX_HOME / "sqlite" / "state_5.sqlite"]
    for db_path in db_paths:
        if not db_path.is_file():
            continue
        try:
            uri = db_path.resolve().as_uri() + "?mode=ro"
            with closing(sqlite3.connect(uri, uri=True, timeout=0.25)) as connection:
                connection.row_factory = sqlite3.Row
                try:
                    row = connection.execute(
                        """
                        WITH RECURSIVE ancestry(id, title, depth) AS (
                            SELECT id, title, 0
                            FROM threads
                            WHERE id = ?

                            UNION ALL

                            SELECT parent.id, parent.title, ancestry.depth + 1
                            FROM ancestry
                            JOIN thread_spawn_edges AS edge
                              ON edge.child_thread_id = ancestry.id
                            JOIN threads AS parent
                              ON parent.id = edge.parent_thread_id
                            WHERE ancestry.depth < 32
                        )
                        SELECT title
                        FROM ancestry
                        ORDER BY depth DESC
                        LIMIT 1
                        """,
                        (thread_id,),
                    ).fetchone()
                except sqlite3.OperationalError:
                    row = connection.execute(
                        "SELECT title FROM threads WHERE id = ?",
                        (thread_id,),
                    ).fetchone()
                if row is not None:
                    return compact_text(row["title"] or "")
        except (OSError, sqlite3.Error):
            continue
    return ""


def query_thread_goal(thread_id: str) -> dict:
    if not thread_id:
        return {}

    db_paths = [CODEX_HOME / "goals_1.sqlite", CODEX_HOME / "sqlite" / "goals_1.sqlite"]
    for db_path in db_paths:
        if not db_path.is_file():
            continue
        try:
            uri = db_path.resolve().as_uri() + "?mode=ro"
            with closing(sqlite3.connect(uri, uri=True, timeout=0.25)) as connection:
                connection.row_factory = sqlite3.Row
                row = connection.execute(
                    """
                    SELECT goal_id, objective, status
                    FROM thread_goals
                    WHERE thread_id = ?
                    """,
                    (thread_id,),
                ).fetchone()
                if row is not None:
                    return dict(row)
        except (OSError, sqlite3.Error):
            continue
    return {}


def rollout_candidates(thread_id: str, rollout_path: str = "") -> list[Path]:
    candidates = []
    if rollout_path:
        candidates.append(Path(rollout_path))
    if thread_id:
        for root_name in ("sessions", "archived_sessions"):
            root = CODEX_HOME / root_name
            if root.is_dir():
                candidates.extend(root.rglob(f"*-{thread_id}.jsonl"))
    return candidates


def iter_jsonl_reverse(path: Path, chunk_size: int = 64 * 1024):
    try:
        with path.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            position = handle.tell()
            pending = b""

            while position > 0:
                read_size = min(chunk_size, position)
                position -= read_size
                handle.seek(position)
                lines = (handle.read(read_size) + pending).split(b"\n")
                pending = lines[0]

                for raw_line in reversed(lines[1:]):
                    if not raw_line.strip():
                        continue
                    try:
                        yield json.loads(raw_line.decode("utf-8"))
                    except (UnicodeDecodeError, json.JSONDecodeError):
                        continue

            if pending.strip():
                try:
                    yield json.loads(pending.decode("utf-8"))
                except (UnicodeDecodeError, json.JSONDecodeError):
                    pass
    except OSError:
        return


def response_item_text(payload: dict) -> str:
    content = payload.get("content") or []
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""

    texts = []
    for item in content:
        if isinstance(item, str):
            texts.append(item)
        elif isinstance(item, dict):
            text = item.get("text")
            if isinstance(text, str):
                texts.append(text)
    return "\n".join(texts)


def rollout_turn_has_goal_context(
    thread_id: str,
    turn_id: str,
    rollout_path: str = "",
) -> bool:
    if not thread_id or not turn_id:
        return False

    seen = set()
    for candidate in rollout_candidates(thread_id, rollout_path):
        try:
            resolved = candidate.resolve()
        except OSError:
            continue
        if resolved in seen or not resolved.is_file():
            continue
        seen.add(resolved)

        for record in iter_jsonl_reverse(resolved):
            if not isinstance(record, dict):
                continue
            payload = record.get("payload") or {}
            if not isinstance(payload, dict):
                continue

            if record.get("type") == "response_item" and payload.get("role") == "user":
                metadata = payload.get("internal_chat_message_metadata_passthrough") or {}
                if not isinstance(metadata, dict) or metadata.get("turn_id") != turn_id:
                    continue
                text = response_item_text(payload)
                if GOAL_CONTEXT_RE.search(text) or "<goal_context>" in text:
                    return True

            if (
                record.get("type") == "event_msg"
                and payload.get("type") == "task_started"
                and payload.get("turn_id") == turn_id
            ):
                break

    return False


def rollout_thread_metadata(thread_id: str, rollout_path: str = "") -> dict:
    seen = set()
    for candidate in rollout_candidates(thread_id, rollout_path):
        try:
            resolved = candidate.resolve()
        except OSError:
            continue
        if resolved in seen or not resolved.is_file():
            continue
        seen.add(resolved)
        try:
            with resolved.open("r", encoding="utf-8") as handle:
                for _ in range(12):
                    line = handle.readline()
                    if not line:
                        break
                    record = json.loads(line)
                    if record.get("type") != "session_meta":
                        continue
                    payload = record.get("payload") or {}
                    if not isinstance(payload, dict):
                        break
                    payload = dict(payload)
                    payload["rollout_path"] = str(resolved)
                    return normalize_thread_metadata(payload)
        except (OSError, json.JSONDecodeError):
            continue
    return {}


def load_thread_metadata(payload: dict) -> dict:
    thread_id = payload.get("thread-id") or payload.get("thread_id") or ""
    metadata = query_thread_metadata(thread_id)
    if metadata.get("is_subagent"):
        return metadata
    rollout_metadata = rollout_thread_metadata(
        thread_id,
        metadata.get("rollout_path", ""),
    )
    return rollout_metadata if rollout_metadata.get("is_subagent") else metadata


def project_title(cwd: str) -> str:
    if not cwd:
        return "Codex"

    try:
        result = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
        )
        repo_root = result.stdout.strip()
        if repo_root:
            return Path(repo_root).name
    except Exception:
        pass

    return Path(cwd).name or "Codex"


def tmux_notification_title() -> str:
    pane_id = os.environ.get("TMUX_PANE", "")
    if not pane_id:
        return ""

    try:
        result = subprocess.run(
            [
                "tmux",
                "display-message",
                "-p",
                "-t",
                pane_id,
                "#{session_id}\t#{window_index}\t#{pane_index}",
            ],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
        )
    except Exception:
        return ""

    parts = result.stdout.strip().split("\t")
    if len(parts) != 3:
        return ""

    session_index = parts[0].removeprefix("$")
    window_index, pane_index = parts[1:]
    if not all(part.isdecimal() for part in (session_index, window_index, pane_index)):
        return ""
    return f"{session_index}:{window_index}:{pane_index}"


def clean_tmux_thread_title(value: str) -> str:
    text = compact_text(value)
    for prefix in CODEX_TITLE_ACTION_PREFIXES:
        if text == prefix:
            return ""
        marker = f"{prefix} | "
        if text.startswith(marker):
            return compact_text(text[len(marker) :])

    if text in CODEX_TITLE_SPINNER_FRAMES:
        return ""
    for spinner in CODEX_TITLE_SPINNER_FRAMES:
        marker = f"{spinner} "
        if text.startswith(marker):
            return compact_text(text[len(marker) :])
    return text


def tmux_thread_title() -> str:
    pane_id = os.environ.get("TMUX_PANE", "")
    if not pane_id:
        return ""

    try:
        result = subprocess.run(
            [
                "tmux",
                "display-message",
                "-p",
                "-t",
                pane_id,
                "#{pane_title}",
            ],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
        )
    except Exception:
        return ""
    return clean_tmux_thread_title(result.stdout)


def latest_user_prompt(payload: dict) -> str:
    messages = payload.get("input-messages") or payload.get("input_messages") or []
    if not isinstance(messages, list):
        return ""

    for message in reversed(messages):
        if isinstance(message, str):
            return message
        if isinstance(message, dict):
            content = message.get("content") or message.get("message") or message.get("text")
            if isinstance(content, str):
                return content
    return ""


def prepare_notification(payload: dict) -> dict:
    cwd = payload.get("cwd") or payload.get("workspace") or ""

    last_message = (
        payload.get("last_agent_message")
        or payload.get("last-assistant-message")
        or payload.get("message")
        or payload.get("summary")
        or payload.get("raw")
        or ""
    )

    pane_thread_title = short_display_text(
        tmux_thread_title(),
        THREAD_TITLE_MAX_DISPLAY_WIDTH,
    )
    thread_id = payload.get("thread-id") or payload.get("thread_id") or ""
    database_thread_title = ""
    if not pane_thread_title:
        database_thread_title = short_display_text(
            query_root_thread_title(thread_id),
            THREAD_TITLE_MAX_DISPLAY_WIDTH,
        )
    original_title = (
        pane_thread_title
        or database_thread_title
        or project_title(cwd)
    )
    tmux_title = tmux_notification_title()
    base_title = (
        f"{tmux_title} · {original_title}" if tmux_title else original_title
    )
    metadata = load_thread_metadata(payload)
    if metadata.get("is_subagent"):
        depth = metadata.get("depth")
        level = f" · L{depth}" if isinstance(depth, int) else ""
        title = f"{base_title} · Subagent{level}"

        model = metadata.get("model") or ""
        reasoning_effort = metadata.get("reasoning_effort") or ""
        model_label = "/".join(part for part in (model, reasoning_effort) if part)
        agent_label = " · ".join(
            part for part in (metadata.get("task_name"), metadata.get("nickname")) if part
        )
        subtitle = notification_subtitle(
            " · ".join(part for part in (model_label, agent_label) if part)
        )
        body = short_text(result_summary(last_message), 140) or "当前子任务已执行完成。"
        return {
            "title": title,
            "subtitle": subtitle,
            "body": body,
            "suppressed": False,
            "reason": "",
            "category": "subagent",
            "goal_status": "",
        }

    turn_id = payload.get("turn-id") or payload.get("turn_id") or ""
    goal = query_thread_goal(thread_id)
    if goal and rollout_turn_has_goal_context(
        thread_id,
        turn_id,
        metadata.get("rollout_path", ""),
    ):
        status = goal.get("status") or ""
        objective = notification_subtitle(goal.get("objective") or "")
        body = short_text(result_summary(last_message), 140) or "当前 Goal 回合已结束。"
        if status == "active":
            status_title = "Goal 执行中"
            return {
                "title": f"{base_title} · {status_title}",
                "subtitle": objective,
                "body": body,
                "suppressed": True,
                "reason": "goal_active",
                "category": "goal",
                "goal_status": status,
            }

        status_title = GOAL_NOTIFICATION_TITLES.get(status, "Goal 状态未知")
        return {
            "title": f"{base_title} · {status_title}",
            "subtitle": objective,
            "body": body,
            "suppressed": False,
            "reason": "",
            "category": "goal",
            "goal_status": status,
        }

    title = base_title
    subtitle = notification_subtitle(first_non_empty_line(latest_user_prompt(payload)))
    body = short_text(first_non_empty_line(last_message), 140) or "当前任务已执行完成。"
    return {
        "title": title,
        "subtitle": subtitle,
        "body": body,
        "suppressed": False,
        "reason": "",
        "category": "main",
        "goal_status": "",
    }


def build_notification(payload: dict) -> tuple[str, str, str] | None:
    notification = prepare_notification(payload)
    if notification["suppressed"]:
        return None
    return (
        notification["title"],
        notification["subtitle"],
        notification["body"],
    )


def write_log(
    payload: dict,
    title: str,
    subtitle: str,
    body: str,
    *,
    suppressed: bool = False,
    reason: str = "",
    category: str = "",
    goal_status: str = "",
) -> None:
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a", encoding="utf-8") as handle:
            handle.write(
                json.dumps(
                    {
                        "payload": payload,
                        "title": title,
                        "subtitle": subtitle,
                        "body": body,
                        "suppressed": suppressed,
                        "reason": reason,
                        "category": category,
                        "goal_status": goal_status,
                    },
                    ensure_ascii=False,
                )
                + "\n"
            )
    except Exception:
        pass


def tmux_focus_target() -> tuple[str, str, str, str]:
    pane_id = os.environ.get("TMUX_PANE", "")
    if not pane_id:
        return "", "", "", ""

    try:
        result = subprocess.run(
            [
                "tmux",
                "display-message",
                "-p",
                "-t",
                pane_id,
                "#{session_name}\t#{window_id}\t#{pane_id}\t#{window_index}",
            ],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
        )
    except Exception:
        return "", "", pane_id, ""

    parts = result.stdout.strip().split("\t")
    if len(parts) != 4:
        return "", "", pane_id, ""
    return parts[0], parts[1], parts[2], parts[3]


def build_focus_command() -> str:
    if not os.path.exists(FOCUS_TMUX_SCRIPT):
        return ""

    session, window_id, pane_id, window_index = tmux_focus_target()
    if not any([session, window_id, pane_id, window_index]):
        return ""

    return " ".join(
        shlex.quote(part)
        for part in [FOCUS_TMUX_SCRIPT, session, window_id, pane_id, window_index]
    )


def run_codex_notifier(title: str, subtitle: str, body: str, sound: str) -> bool:
    if not os.path.exists(CODEX_NOTIFIER_APP):
        return False

    notifier_args = [
        "-title",
        title,
        "-subtitle",
        subtitle,
        "-message",
        body,
        "-sound",
        sound,
        "-group",
        NOTIFICATION_GROUP,
    ]

    if CODEX_ICON_URL:
        notifier_args.extend(["-appIcon", CODEX_ICON_URL])

    focus_command = build_focus_command()
    if focus_command:
        notifier_args.extend(["-execute", focus_command])

    cmd = [
        "/usr/bin/open",
        "-gj",
        CODEX_NOTIFIER_APP,
        "--args",
        *notifier_args,
    ]

    try:
        subprocess.run(
            cmd,
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=NOTIFIER_TIMEOUT_SECONDS,
        )
        return True
    except Exception:
        return False


def run_terminal_notifier(title: str, subtitle: str, body: str, sound: str) -> bool:
    if not os.path.exists(TERMINAL_NOTIFIER):
        return False

    cmd = [
        TERMINAL_NOTIFIER,
        "-title",
        title,
        "-subtitle",
        subtitle,
        "-message",
        body,
        "-appIcon",
        GHOSTTY_ICON_URL,
        "-sound",
        sound,
        "-group",
        NOTIFICATION_GROUP,
    ]
    try:
        subprocess.run(
            cmd,
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=NOTIFIER_TIMEOUT_SECONDS,
        )
        return True
    except Exception:
        return False


def apple_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def run_ghostty_osascript(title: str, subtitle: str, body: str, sound: str) -> bool:
    script = (
        'tell application id "{}" to display notification "{}" with title "{}" subtitle "{}" sound name "{}"'.format(
            GHOSTTY_BUNDLE_ID,
            apple_escape(body),
            apple_escape(title),
            apple_escape(subtitle),
            apple_escape(sound),
        )
    )
    try:
        subprocess.run(
            ["/usr/bin/osascript", "-e", script],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=NOTIFIER_TIMEOUT_SECONDS,
        )
        return True
    except Exception:
        return False


def run_osascript(title: str, subtitle: str, body: str, sound: str) -> None:
    script = (
        'display notification "{}" with title "{}" subtitle "{}" sound name "{}"'.format(
            apple_escape(body),
            apple_escape(title),
            apple_escape(subtitle),
            apple_escape(sound),
        )
    )
    try:
        subprocess.run(
            ["/usr/bin/osascript", "-e", script],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def main() -> int:
    payload = read_payload()
    notification = prepare_notification(payload)
    title = notification["title"]
    subtitle = notification["subtitle"]
    body = notification["body"]
    sound = notification_sound()
    notification["sound"] = sound

    if os.environ.get("CODEX_NOTIFY_DRY_RUN", "").lower() in {"1", "true", "yes"}:
        print(json.dumps(notification, ensure_ascii=False))
        return 0

    write_log(
        payload,
        title,
        subtitle,
        body,
        suppressed=notification["suppressed"],
        reason=notification["reason"],
        category=notification["category"],
        goal_status=notification["goal_status"],
    )

    if notification["suppressed"]:
        return 0

    if run_codex_notifier(title, subtitle, body, sound):
        return 0

    if not run_terminal_notifier(title, subtitle, body, sound):
        if not run_ghostty_osascript(title, subtitle, body, sound):
            run_osascript(title, subtitle, body, sound)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
