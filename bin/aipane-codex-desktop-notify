#!/opt/homebrew/bin/python3
"""Codex desktop notification Adapter."""

from __future__ import annotations

import json
import os
import sys
import uuid
from pathlib import Path


LIB_DIR = Path(__file__).resolve().parents[1] / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from agent_notifications import (  # noqa: E402
    AgentNotifications,
    MacOSNotificationAdapter,
)


def read_payload() -> dict[str, object] | None:
    if sys.argv[1:] == ["--test-question"]:
        trace = "aipane-question-" + uuid.uuid4().hex[:12]
        print(f"question notification tracer: {trace}", file=sys.stderr)
        return {
            "hook_event_name": "PreToolUse",
            "tool_name": "request_user_input_async",
            "session_id": "aipane-question-tracer",
            "tool_use_id": trace,
            "tool_input": {"questions": [{"title": f"待答问题通知测试：{trace}"}]},
        }
    raw = ""
    if len(sys.argv) > 1 and sys.argv[1]:
        raw = sys.argv[1]
    elif not sys.stdin.isatty():
        raw = sys.stdin.read().strip()
    if not raw:
        return {}
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, dict) else None


def main() -> int:
    environment = os.environ.copy()
    payload = read_payload()
    if payload is None:
        return 0
    preview = environment.get("CODEX_NOTIFY_DRY_RUN", "").lower() in {
        "1",
        "true",
        "yes",
    }
    notifications = AgentNotifications(
        adapter=MacOSNotificationAdapter(environment=environment),
        environment=environment,
    )
    try:
        result = notifications.handle("codex", payload, preview=preview)
    except Exception as error:
        # Notification failures must never reject a tool or stop Codex.
        print(json.dumps({"event": "notify_error", "error": type(error).__name__}), file=sys.stderr)
        return 0
    if preview:
        notification = result.notification
        output = notification.as_dict() if notification else {}
        output.update(
            suppressed=result.outcome == "suppressed",
            reason=result.reason,
            outcome=result.outcome,
            goal_status=notification.goal_status if notification else "",
        )
        print(
            json.dumps(
                output,
                ensure_ascii=False,
            )
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
