#!/usr/bin/env bash
set -euo pipefail

self_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(cd "$self_dir/.." && pwd)"
source_file="$repo_root/native/agent-notifier.m"
icon_file="$repo_root/native/icons/kimi-code.svg"
bundle_id="com.alfheim.kimi-code-notifier.v2"
output="$HOME/Applications/Kimi Code Notifier.app"
version="1.0.2"
build="4"

while (( $# > 0 )); do
  case "$1" in
    --bundle-id) shift; bundle_id="${1:-}" ;;
    --output) shift; output="${1:-}" ;;
    --version) shift; version="${1:-}" ;;
    --build) shift; build="${1:-}" ;;
    -h|--help)
      printf 'usage: build-kimi-notifier [--bundle-id ID] [--output APP] [--version V] [--build N]\n'
      exit 0
      ;;
    *) printf 'build-kimi-notifier: unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

if [[ -z "$bundle_id" || -z "$output" || -e "$output" ]]; then
  printf 'build-kimi-notifier: bundle id/output required and output must not exist: %s\n' "$output" >&2
  exit 2
fi
for input_file in "$source_file" "$icon_file"; do
  if [[ ! -r "$input_file" ]]; then
    printf 'build-kimi-notifier: missing input: %s\n' "$input_file" >&2
    exit 2
  fi
done

build_root="$(mktemp -d "${TMPDIR:-/tmp}/kimi-notifier-build.XXXXXX")"
trap 'rm -rf "$build_root"' EXIT
app_name="$(basename "$output")"
display_name="${app_name%.app}"
stage_app="$build_root/$app_name"
contents="$stage_app/Contents"
macos_dir="$contents/MacOS"
resources="$contents/Resources"
iconset="$build_root/KimiCodeMistBlue.iconset"
plist="$contents/Info.plist"

mkdir -p "$macos_dir" "$resources" "$iconset" "$(dirname "$output")"

/usr/bin/clang \
  -fobjc-arc \
  -fblocks \
  -Wall \
  -Wextra \
  -Werror \
  -mmacosx-version-min=13.0 \
  -framework Cocoa \
  -framework UserNotifications \
  "$source_file" \
  -o "$macos_dir/kimi-notifier"

/opt/homebrew/bin/rsvg-convert -w 1024 -h 1024 \
  "$icon_file" >"$build_root/kimi-icon-1024.png"

for icon_spec in \
  '16 icon_16x16.png' \
  '32 icon_16x16@2x.png' \
  '32 icon_32x32.png' \
  '64 icon_32x32@2x.png' \
  '128 icon_128x128.png' \
  '256 icon_128x128@2x.png' \
  '256 icon_256x256.png' \
  '512 icon_256x256@2x.png' \
  '512 icon_512x512.png' \
  '1024 icon_512x512@2x.png'; do
  read -r pixels filename <<<"$icon_spec"
  /usr/bin/sips -z "$pixels" "$pixels" "$build_root/kimi-icon-1024.png" \
    --out "$iconset/$filename" >/dev/null
done
/usr/bin/iconutil --convert icns --output "$resources/KimiCodeMistBlue.icns" "$iconset"

/usr/bin/plutil -create xml1 "$plist"
/usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string $bundle_id" "$plist"
/usr/libexec/PlistBuddy -c "Add :CFBundleName string $display_name" "$plist"
/usr/libexec/PlistBuddy -c "Add :CFBundleDisplayName string $display_name" "$plist"
/usr/libexec/PlistBuddy -c "Add :CFBundleExecutable string kimi-notifier" "$plist"
/usr/libexec/PlistBuddy -c "Add :CFBundlePackageType string APPL" "$plist"
/usr/libexec/PlistBuddy -c "Add :CFBundleShortVersionString string $version" "$plist"
/usr/libexec/PlistBuddy -c "Add :CFBundleVersion string $build" "$plist"
/usr/libexec/PlistBuddy -c "Add :CFBundleIconFile string KimiCodeMistBlue" "$plist"
/usr/libexec/PlistBuddy -c "Add :LSUIElement bool true" "$plist"
/usr/libexec/PlistBuddy -c "Add :NSHighResolutionCapable bool true" "$plist"
/usr/libexec/PlistBuddy -c "Add :LSMinimumSystemVersion string 13.0" "$plist"

printf 'APPL????' >"$contents/PkgInfo"
/usr/bin/codesign --force --deep --sign - "$stage_app"
/usr/bin/ditto "$stage_app" "$output"
printf '%s\n' "$output"
