#!/usr/bin/env python3
"""Run the version-checked native Claude Stop-payload patcher."""
import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
tweakcc = Path(os.environ.get("TWEAKCC_ROOT", Path.home() / "code/oss/tweakcc"))
runner = tweakcc / "node_modules/.bin/tsx"
if not runner.is_file():
    sys.exit(f"Install tweakcc dependencies first: cd {tweakcc} && pnpm install --frozen-lockfile")
os.execv(str(runner), [str(runner), "--tsconfig", str(tweakcc / "tsconfig.json"), str(root / "integrations/claude/apply-stop-response-patch.mjs"), *sys.argv[1:]])
