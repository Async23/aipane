#!/usr/bin/env python3
"""Antigravity CLI launcher entrypoint managed by aipane-release."""

from __future__ import annotations

from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from agy_launch import launch  # noqa: E402


def main() -> int:
    return launch(sys.argv[1:], launcher_script=Path(__file__).resolve())


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as error:
        print(f"aipane-agy-launch: {error}", file=sys.stderr)
        raise SystemExit(1)
    except KeyboardInterrupt:
        print("\n已取消启动。", file=sys.stderr)
        raise SystemExit(130)
