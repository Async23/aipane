#!/usr/bin/env bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

session="${1:-}"
window_id="${2:-}"
pane_id="${3:-}"
window_index="${4:-}"
tmux_bin="${AIPANE_TMUX_BIN:-/opt/homebrew/bin/tmux}"
tmux_socket="${AIPANE_TMUX_SOCKET:-}"
log_path="${AIPANE_KIMI_FOCUS_LOG:-$HOME/.kimi-code/logs/kimi-focus.log}"

log() {
  mkdir -p "$(dirname "$log_path")" 2>/dev/null || true
  printf '[%s] session=%s window=%s pane=%s status=%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
    "${session:-none}" "${window_id:-none}" "${pane_id:-none}" "$1" \
    >>"$log_path" 2>/dev/null || true
}

if [[ "${AIPANE_KIMI_SKIP_ACTIVATE:-0}" != "1" ]]; then
  /usr/bin/open -b com.mitchellh.ghostty >/dev/null 2>&1 || true
fi

if [[ ! -x "$tmux_bin" ]]; then
  tmux_bin="$(command -v tmux || true)"
fi
if [[ -z "$tmux_bin" || ! -x "$tmux_bin" ]]; then
  log "tmux-missing"
  exit 0
fi

tmux_call() {
  if [[ -n "$tmux_socket" ]]; then
    "$tmux_bin" -L "$tmux_socket" "$@"
  else
    "$tmux_bin" "$@"
  fi
}

target_exists() {
  [[ -n "${1:-}" ]] && tmux_call display-message -p -t "$1" '#{session_name}' >/dev/null 2>&1
}

if target_exists "$pane_id"; then
  pane_window="$(tmux_call display-message -p -t "$pane_id" '#{session_name}:#{window_index}' 2>/dev/null || true)"
  if [[ -n "$pane_window" ]]; then
    tmux_call switch-client -t "$pane_window" >/dev/null 2>&1 || true
  fi
  if tmux_call select-pane -t "$pane_id" >/dev/null 2>&1; then
    log "pane-selected"
    exit 0
  fi
fi

if target_exists "$window_id"; then
  window_target="$(tmux_call display-message -p -t "$window_id" '#{session_name}:#{window_index}' 2>/dev/null || true)"
  if [[ -n "$window_target" ]]; then
    tmux_call switch-client -t "$window_target" >/dev/null 2>&1 || true
    log "window-selected"
    exit 0
  fi
fi

if [[ -n "$session" && -n "$window_index" ]] && target_exists "${session}:${window_index}"; then
  tmux_call switch-client -t "${session}:${window_index}" >/dev/null 2>&1 || true
  log "session-window-selected"
  exit 0
fi

if [[ -n "$session" ]] && tmux_call has-session -t "$session" >/dev/null 2>&1; then
  tmux_call switch-client -t "$session" >/dev/null 2>&1 || true
  log "session-selected"
  exit 0
fi

log "ghostty-only"
exit 0
