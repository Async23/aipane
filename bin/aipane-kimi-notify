#!/opt/homebrew/bin/python3
"""Kimi Code notification Adapter."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path


LIB_DIR = Path(__file__).resolve().parents[1] / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from agent_notifications import (  # noqa: E402
    AgentNotifications,
    MacOSNotificationAdapter,
)


WORKER_FLAG = "--deliver"


class WorkerFailureAdapter:
    def deliver(self, _agent: str, _notification: object) -> str:
        return "worker-error"


def read_payload() -> dict[str, object]:
    raw = sys.stdin.read().strip()
    if not raw:
        return {}
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return payload if isinstance(payload, dict) else {}


def spawn_worker(payload: dict[str, object]) -> bool:
    try:
        process = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), WORKER_FLAG],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            text=True,
        )
        assert process.stdin is not None
        process.stdin.write(json.dumps(payload, separators=(",", ":")))
        process.stdin.close()
        return True
    except (OSError, BrokenPipeError):
        return False


def main() -> int:
    environment = os.environ.copy()
    payload = read_payload()
    notifications = AgentNotifications(
        adapter=MacOSNotificationAdapter(environment=environment),
        environment=environment,
    )
    worker = len(sys.argv) > 1 and sys.argv[1] == WORKER_FLAG
    preview = environment.get("KIMI_NOTIFY_DRY_RUN") == "1"
    if worker:
        notifications.handle("kimi", payload)
        return 0

    result = notifications.handle("kimi", payload, preview=True)
    if result.notification is None:
        return 0
    if preview:
        notification = result.notification
        print(
            json.dumps(
                {
                    "event": notification.event,
                    "title": notification.title,
                    "subtitle": notification.subtitle,
                    "body": notification.body,
                    "sound": notification.sound,
                    "group": notification.group,
                    "action": notification.action,
                    "pane_id": notification.pane_id,
                },
                ensure_ascii=False,
                sort_keys=True,
            )
        )
        return 0
    if not spawn_worker(payload):
        AgentNotifications(
            adapter=WorkerFailureAdapter(),
            environment=environment,
        ).handle("kimi", payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
